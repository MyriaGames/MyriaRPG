<Window x:Class="Myria.Wpf.View.Windows.Window_InitError"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Initialization Error"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Foreground}"
        FontFamily="{StaticResource Font.Ui}">

    <Window.Resources>

        <!-- Close button — fully self-contained, matches the dark fantasy style -->
        <Style x:Key="InitErrorButton" TargetType="Button">
            <Setter Property="Height"                   Value="36"/>
            <Setter Property="MinWidth"                 Value="110"/>
            <Setter Property="Foreground"               Value="{DynamicResource Brush.GoldSoft}"/>
            <Setter Property="Background"               Value="{DynamicResource Brush.PanelDark}"/>
            <Setter Property="BorderBrush"              Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="FontFamily"               Value="{StaticResource Font.Body}"/>
            <Setter Property="FontSize"                 Value="14"/>
            <Setter Property="Cursor"                   Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
            <Setter Property="Padding"                  Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="BarLeft"  Fill="{DynamicResource Brush.Gold}" Opacity="0"/>
                                <ContentPresenter Grid.Column="1"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True"/>
                                <Rectangle x:Name="BarRight" Grid.Column="2" Fill="{DynamicResource Brush.Gold}" Opacity="0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd"       Property="Background" Value="{DynamicResource Brush.NavHover}"/>
                                <Setter TargetName="BarLeft"  Property="Opacity"    Value="1"/>
                                <Setter TargetName="BarRight" Property="Opacity"    Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BlueActive}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Outer gold border — same 1px trim used across the app's panels, with the new AR4 corner
         flourish ornament added at each corner (first proof surface, see Layout.xaml's
         Ornament.CornerFlourish/OrnateGoldFrame doc comment). -->
    <Grid>
        <Border BorderBrush="{DynamicResource Brush.Gold}" BorderThickness="1" Margin="1">
        <StackPanel Margin="28,24">

            <!-- Title row: warning icon + heading -->
            <DockPanel Margin="0,0,0,8">
                <TextBlock Text="&#x26A0;"
                           Foreground="{DynamicResource Brush.Error}"
                           FontSize="26"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"
                           Margin="0,0,12,0"/>
                <TextBlock Text="Initialization Failed"
                           Foreground="{DynamicResource Brush.GoldSoft}"
                           FontFamily="{StaticResource Font.Body}"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Subtitle -->
            <TextBlock Text="An error occurred during initialization. Please check for an update, run the repair tool, and try again. Should the error still occur, please contact support."
                       Foreground="{DynamicResource Brush.Muted}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"/>

            <!-- Gold divider -->
            <Grid Margin="0,0,0,16">
                <Rectangle Height="1" Fill="{DynamicResource Brush.Gold}" Opacity="0.55" VerticalAlignment="Center"/>
                <TextBlock Text="&#x25C7;"
                           Foreground="{DynamicResource Brush.GoldSoft}"
                           FontFamily="Segoe UI Symbol"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,-10,0,0"/>
            </Grid>

            <!-- Step panel -->
            <Border Background="{DynamicResource Brush.PanelDark}"
                    BorderBrush="{DynamicResource Brush.Gold}"
                    BorderThickness="1"
                    CornerRadius="2"
                    Padding="14,10"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Step"
                               Foreground="{DynamicResource Brush.Muted}"
                               FontSize="10"
                               Margin="0,0,0,3"/>
                    <TextBox Text="{Binding FailedStep, Mode=OneWay}"
                             Foreground="{DynamicResource Brush.GoldSoft}"
                             Background="Transparent"
                             BorderThickness="0"
                             FontSize="14"
                             FontWeight="SemiBold"
                             IsReadOnly="True"
                             TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Error details panel -->
            <Border Background="{DynamicResource Brush.PanelDark}"
                    BorderBrush="{DynamicResource Brush.Gold}"
                    BorderThickness="1"
                    CornerRadius="2"
                    Padding="14,10"
                    Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Error"
                               Foreground="{DynamicResource Brush.Muted}"
                               FontSize="10"
                               Margin="0,0,0,3"/>
                    <ScrollViewer MaxHeight="160"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding ErrorMessage, Mode=OneWay}"
                                 Foreground="{DynamicResource Brush.Foreground}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Copy"
                        Click="Copy_Click"
                        Style="{StaticResource InitErrorButton}"
                        Margin="0,0,8,0"/>
                <Button Content="Close"
                        IsCancel="True"
                        Click="Close_Click"
                        Style="{StaticResource InitErrorButton}"/>
            </StackPanel>

        </StackPanel>
        </Border>
        <ContentControl ContentTemplate="{StaticResource Ornament.CornerFlourish}"
                         HorizontalAlignment="Left" VerticalAlignment="Top"
                         Margin="-1,-1,0,0" IsHitTestVisible="False"/>
        <ContentControl ContentTemplate="{StaticResource Ornament.CornerFlourish}"
                         HorizontalAlignment="Right" VerticalAlignment="Top"
                         Margin="0,-1,-1,0" IsHitTestVisible="False"
                         RenderTransformOrigin="0.5,0.5">
            <ContentControl.RenderTransform>
                <RotateTransform Angle="90"/>
            </ContentControl.RenderTransform>
        </ContentControl>
        <ContentControl ContentTemplate="{StaticResource Ornament.CornerFlourish}"
                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,-1,-1" IsHitTestVisible="False"
                         RenderTransformOrigin="0.5,0.5">
            <ContentControl.RenderTransform>
                <RotateTransform Angle="180"/>
            </ContentControl.RenderTransform>
        </ContentControl>
        <ContentControl ContentTemplate="{StaticResource Ornament.CornerFlourish}"
                         HorizontalAlignment="Left" VerticalAlignment="Bottom"
                         Margin="-1,0,0,-1" IsHitTestVisible="False"
                         RenderTransformOrigin="0.5,0.5">
            <ContentControl.RenderTransform>
                <RotateTransform Angle="270"/>
            </ContentControl.RenderTransform>
        </ContentControl>
    </Grid>
</Window>
