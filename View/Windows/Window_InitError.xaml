<Window x:Class="Myria.Wpf.View.Windows.Window_InitError"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Initialization Error"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#070B0F"
        Foreground="#E8D8B3"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- Close button — fully self-contained, matches the dark fantasy style -->
        <Style x:Key="InitErrorButton" TargetType="Button">
            <Setter Property="Height"                   Value="36"/>
            <Setter Property="MinWidth"                 Value="110"/>
            <Setter Property="Foreground"               Value="#E1C481"/>
            <Setter Property="Background"               Value="#0B1117"/>
            <Setter Property="BorderBrush"              Value="#C99A4A"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="FontFamily"               Value="Georgia"/>
            <Setter Property="FontSize"                 Value="14"/>
            <Setter Property="Cursor"                   Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
            <Setter Property="Padding"                  Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="BarLeft"  Fill="#C99A4A" Opacity="0"/>
                                <ContentPresenter Grid.Column="1"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True"/>
                                <Rectangle x:Name="BarRight" Grid.Column="2" Fill="#C99A4A" Opacity="0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd"       Property="Background" Value="#11202D"/>
                                <Setter TargetName="BarLeft"  Property="Opacity"    Value="1"/>
                                <Setter TargetName="BarRight" Property="Opacity"    Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0F314D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Outer gold border — same 1px trim used across the app's panels -->
    <Border BorderBrush="#C99A4A" BorderThickness="1" Margin="1">
        <StackPanel Margin="28,24">

            <!-- Title row: warning icon + heading -->
            <DockPanel Margin="0,0,0,8">
                <TextBlock Text="&#x26A0;"
                           Foreground="#CF6679"
                           FontSize="26"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"
                           Margin="0,0,12,0"/>
                <TextBlock Text="Initialization Failed"
                           Foreground="#E1C481"
                           FontFamily="Georgia"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Subtitle -->
            <TextBlock Text="An error occurred during initialization. Please check for an update, run the repair tool, and try again. Should the error still occur, please contact support."
                       Foreground="#9A8A68"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"/>

            <!-- Gold divider -->
            <Grid Margin="0,0,0,16">
                <Rectangle Height="1" Fill="#C99A4A" Opacity="0.55" VerticalAlignment="Center"/>
                <TextBlock Text="&#x25C7;"
                           Foreground="#E1C481"
                           FontFamily="Segoe UI Symbol"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,-10,0,0"/>
            </Grid>

            <!-- Step panel -->
            <Border Background="#0B1117"
                    BorderBrush="#C99A4A"
                    BorderThickness="1"
                    CornerRadius="2"
                    Padding="14,10"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Step"
                               Foreground="#9A8A68"
                               FontSize="10"
                               Margin="0,0,0,3"/>
                    <TextBox Text="{Binding FailedStep, Mode=OneWay}"
                             Foreground="#E1C481"
                             Background="Transparent"
                             BorderThickness="0"
                             FontSize="14"
                             FontWeight="SemiBold"
                             IsReadOnly="True"
                             TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Error details panel -->
            <Border Background="#0B1117"
                    BorderBrush="#C99A4A"
                    BorderThickness="1"
                    CornerRadius="2"
                    Padding="14,10"
                    Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Error"
                               Foreground="#9A8A68"
                               FontSize="10"
                               Margin="0,0,0,3"/>
                    <ScrollViewer MaxHeight="160"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding ErrorMessage, Mode=OneWay}"
                                 Foreground="#E8D8B3"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Copy"
                        Click="Copy_Click"
                        Style="{StaticResource InitErrorButton}"
                        Margin="0,0,8,0"/>
                <Button Content="Close"
                        IsCancel="True"
                        Click="Close_Click"
                        Style="{StaticResource InitErrorButton}"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
