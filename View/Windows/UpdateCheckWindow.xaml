<Window x:Class="Myria.Wpf.View.Windows.UpdateCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Myria RPG" Width="380" SizeToContent="Height"
        Icon="/Assets/App.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="{DynamicResource Brush.Background}">
    <Window.Resources>
        <Style x:Key="UpdateChoiceButton" TargetType="Button" BasedOn="{StaticResource GoldButtonBase}">
            <Setter Property="Height"      Value="34"/>
            <Setter Property="MinWidth"    Value="110"/>
            <Setter Property="Foreground"  Value="{DynamicResource Brush.GoldSoft}"/>
            <Setter Property="Background"  Value="{DynamicResource Brush.PanelDark}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="FontSize"    Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.NavHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Myria RPG" FontSize="18" FontWeight="Bold"
                   FontFamily="{StaticResource Font.Heading}"
                   Foreground="{DynamicResource Brush.GoldSoft}"
                   HorizontalAlignment="Center" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="1" x:Name="StatusText" Text="Checking for updates..."
                   Foreground="{DynamicResource Brush.GoldSoft}"
                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,10"/>

        <ProgressBar Grid.Row="2" x:Name="Progress" Height="14" IsIndeterminate="True"
                     Minimum="0" Maximum="100"/>

        <!-- Release notes - only shown while awaiting a compat-break confirmation, and only if
             the release actually has notes. -->
        <StackPanel Grid.Row="3" x:Name="NotesPanel" Visibility="Collapsed" Margin="0,4,0,10">
            <TextBlock x:Name="NotesLabel" Text="What's new:"
                       Foreground="{DynamicResource Brush.Muted}" FontSize="11" Margin="0,0,0,4"/>
            <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="NotesText" Text=""
                           Foreground="{DynamicResource Brush.Foreground}"
                           TextWrapping="Wrap" FontSize="12"/>
            </ScrollViewer>
        </StackPanel>

        <!-- Confirm/decline - only shown for a compat-break update; a Patch-only update never
             reaches this state, it installs silently like before this scheme existed. -->
        <StackPanel Grid.Row="4" x:Name="ConfirmPanel" Visibility="Collapsed"
                    Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="ConfirmButton" Content="Update Now" Style="{StaticResource UpdateChoiceButton}"
                    Click="ConfirmButton_Click" Margin="0,0,10,0"/>
            <Button x:Name="DeclineButton" Content="Not Now" Style="{StaticResource UpdateChoiceButton}"
                    Click="DeclineButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
