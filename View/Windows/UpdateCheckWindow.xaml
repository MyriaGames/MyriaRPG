<Window x:Class="Myria.Wpf.View.Windows.UpdateCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Myria RPG" Height="140" Width="360"
        Icon="/Assets/App.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="{DynamicResource Brush.Background}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Myria RPG" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource Brush.GoldSoft}"
                   HorizontalAlignment="Center" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="1" x:Name="StatusText" Text="Checking for updates..."
                   Foreground="{DynamicResource Brush.GoldSoft}"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <ProgressBar Grid.Row="2" x:Name="Progress" Height="14" IsIndeterminate="True"
                     Minimum="0" Maximum="100"/>
    </Grid>
</Window>
