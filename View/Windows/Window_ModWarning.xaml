<Window x:Class="Myria.Wpf.View.Windows.Window_ModWarning"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="{Binding TitleText}"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#070B0F"
        Foreground="#E8D8B3"
        FontFamily="Segoe UI"
        Style="{x:Null}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="ModWarnButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Foreground" Value="#E1C481"/>
            <Setter Property="Background" Value="#0B1117"/>
            <Setter Property="BorderBrush" Value="#C99A4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="BarLeft" Fill="#C99A4A" Opacity="0"/>
                                <ContentPresenter Grid.Column="1"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True"/>
                                <Rectangle x:Name="BarRight" Grid.Column="2" Fill="#C99A4A" Opacity="0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#11202D"/>
                                <Setter TargetName="BarLeft" Property="Opacity" Value="1"/>
                                <Setter TargetName="BarRight" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0F314D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#C99A4A" BorderThickness="1" Margin="1">
        <StackPanel Margin="28,24">

            <!-- Title row: amber warning icon + heading -->
            <DockPanel Margin="0,0,0,8">
                <TextBlock Text="&#x26A0;"
                           Foreground="#FFCC00"
                           FontFamily="Segoe UI Symbol"
                           FontSize="26"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"
                           Margin="0,0,12,0"/>
                <TextBlock Text="{Binding TitleText}"
                           Foreground="#E1C481"
                           FontFamily="Georgia"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Subtitle -->
            <TextBlock Text="{Binding SubtitleText}"
                       Foreground="#9A8A68"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"/>

            <!-- Gold divider -->
            <Grid Margin="0,0,0,16">
                <Rectangle Height="1" Fill="#C99A4A" Opacity="0.55" VerticalAlignment="Center"/>
                <TextBlock Text="&#x25C7;"
                           Foreground="#E1C481"
                           FontFamily="Segoe UI Symbol"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,-10,0,0"/>
            </Grid>

            <!-- Details panel — only shown when there is change detail text -->
            <Border Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}"
                    Background="#0B1117"
                    BorderBrush="#C99A4A"
                    BorderThickness="1"
                    CornerRadius="2"
                    Padding="14,10"
                    Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="{Binding DetailsLabel}"
                               Foreground="#9A8A68"
                               FontSize="10"
                               Margin="0,0,0,3"/>
                    <ScrollViewer MaxHeight="160" HorizontalScrollBarVisibility="Disabled">
                        <TextBox Text="{Binding DetailsText, Mode=OneWay}"
                                 Foreground="#E8D8B3"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 Style="{x:Null}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Action buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="{Binding CancelLabel}"
                        IsCancel="True"
                        Click="Cancel_Click"
                        Style="{StaticResource ModWarnButton}"
                        Margin="0,0,8,0"/>
                <Button Content="{Binding ContinueLabel}"
                        IsDefault="True"
                        Click="Continue_Click"
                        Style="{StaticResource ModWarnButton}"
                        Background="#0F314D"
                        BorderBrush="#4A90C9"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
