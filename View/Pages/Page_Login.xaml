<Page x:Class="Myria.Wpf.View.Pages.Page_Login"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Myria.Wpf.View.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450"
      Background="Transparent"
      Title="Page_Login"
      Width="400">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <DropShadowEffect x:Key="LoginGlow" BlurRadius="18" ShadowDepth="0" Opacity="0.45" Color="{DynamicResource Color.Gold}"/>

        <Style x:Key="LoginPanel" TargetType="Border">
            <Setter Property="Width" Value="320"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Background" Value="{DynamicResource Brush.MainPanelGradient}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Effect" Value="{StaticResource Effect.PanelShadow}"/>
        </Style>

        <Style x:Key="LoginTitleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.GoldSoft}"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LoginLabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="LoginMessageText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Error}"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MinHeight" Value="18"/>
        </Style>

        <Style x:Key="LoginTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="{DynamicResource Brush.PanelDark}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.Foreground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="{DynamicResource Brush.PanelDark}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginButton" TargetType="Button">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.GoldSoft}"/>
            <Setter Property="Background" Value="{DynamicResource Brush.PanelDark}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.NavHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.BlueActive}"/>
                                <Setter Property="Effect" Value="{StaticResource LoginGlow}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource LoginPanel}">
            <Grid ClipToBounds="True">
                <Ellipse Width="190"
                         Height="190"
                         Stroke="{DynamicResource Brush.Gold}"
                         StrokeThickness="1"
                         Opacity="0.16"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,-92,-78,0"/>
                <Ellipse Width="126"
                         Height="126"
                         Stroke="{DynamicResource Brush.Gold}"
                         StrokeThickness="1"
                         Opacity="0.12"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,-44,-26,0"/>

                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock Text="&#x25CF;"
                                   Foreground="{DynamicResource Brush.GoldSoft}"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="30"
                                   DockPanel.Dock="Left"
                                   Margin="0,0,12,0"/>
                        <TextBlock x:Name="tbl_Title"
                                   Text="{Binding Title}"
                                   Style="{StaticResource LoginTitleText}"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <Grid Margin="0,0,0,18">
                        <Rectangle Height="1" Fill="{DynamicResource Brush.Gold}" Opacity="0.65" VerticalAlignment="Center"/>
                        <TextBlock Text="&#x25C7;"
                                   Foreground="{DynamicResource Brush.GoldSoft}"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,-13,0,0"/>
                    </Grid>

                    <TextBlock x:Name="tbl_Username"
                               Text="{Binding tblUsername}"
                               Style="{StaticResource LoginLabelText}"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="tbx_Username"
                             Text="{Binding Username}"
                             Style="{StaticResource LoginTextBox}"
                             Margin="0,0,0,3"/>
                    <TextBlock x:Name="tbl_UsernameMsg"
                               Text="{Binding tblUserNameMsg}"
                               Style="{StaticResource LoginMessageText}"
                               Margin="0,0,0,8"/>

                    <TextBlock x:Name="tbl_Password"
                               Text="{Binding tblPassword}"
                               Style="{StaticResource LoginLabelText}"
                               Margin="0,0,0,6"/>
                    <PasswordBox x:Name="pbx_UserPassword"
                                 Style="{StaticResource LoginPasswordBox}"
                                 Margin="0,0,0,3"/>
                    <TextBlock x:Name="tbl_PasswordMsg"
                               Text="{Binding tblPasswordMsg}"
                               Style="{StaticResource LoginMessageText}"
                               Margin="0,0,0,8"/>

                    <StackPanel Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock x:Name="tbl_PasswordConfirm"
                                   Text="{Binding tblPasswordConfirm}"
                                   Style="{StaticResource LoginLabelText}"
                                   Margin="0,0,0,6"/>
                        <PasswordBox x:Name="pbx_ConfirmPassword"
                                     Style="{StaticResource LoginPasswordBox}"
                                     Margin="0,0,0,3"/>
                        <TextBlock x:Name="tbl_PasswordConfirmMsg"
                                   Text="{Binding tblPasswordConfirmMsg}"
                                   Style="{StaticResource LoginMessageText}"
                                   Margin="0,0,0,10"/>
                    </StackPanel>

                    <TextBlock Margin="0,0,0,18">
                        <Hyperlink Command="{Binding ToggleMode}" TextDecorations="{x:Null}">
                            <Run Text="{Binding tblSwitchMode}" Foreground="{DynamicResource Brush.GoldSoft}"/>
                        </Hyperlink>
                    </TextBlock>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="btn_Login"
                                Command="{Binding Login}"
                                Content="{Binding btnLogin}"
                                Style="{StaticResource LoginButton}"
                                Background="{DynamicResource Brush.BlueActive}"
                                IsDefault="True"/>
                        <Button x:Name="btn_Cancel"
                                Command="{Binding Cancel}"
                                Content="{Binding btnCancel}"
                                Grid.Column="2"
                                Style="{StaticResource LoginButton}"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
