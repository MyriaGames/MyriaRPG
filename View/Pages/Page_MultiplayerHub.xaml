<Page x:Class="Myria.Wpf.View.Pages.Page_MultiplayerHub"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page_MultiplayerHub">

    <Page.Background>
        <ImageBrush ImageSource="/Data/images/fantasy-group-adventurers.jpg"/>
    </Page.Background>

    <Page.Resources>
        <!-- Button style matching StartupMenuButton / LobbyButton -->
        <Style x:Key="HubButton" TargetType="Button">
            <Setter Property="MinHeight"                   Value="46"/>
            <Setter Property="Foreground"                  Value="{DynamicResource Brush.GoldSoft}"/>
            <Setter Property="Background"                  Value="{DynamicResource Brush.PanelDark}"/>
            <Setter Property="BorderBrush"                 Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="BorderThickness"             Value="1"/>
            <Setter Property="FontFamily"                  Value="Georgia"/>
            <Setter Property="FontSize"                    Value="16"/>
            <Setter Property="Cursor"                      Value="Hand"/>
            <Setter Property="HorizontalContentAlignment"  Value="Center"/>
            <Setter Property="VerticalContentAlignment"    Value="Center"/>
            <Setter Property="Padding"                     Value="14,0"/>
            <Setter Property="Margin"                      Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.NavHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.BlueActive}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- Decorative rings -->
        <Grid Grid.ColumnSpan="2" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="520" Height="520"
                     Stroke="{DynamicResource Brush.Gold}" StrokeThickness="1" Opacity="0.22"
                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-150,-90,0"/>
            <Ellipse Width="340" Height="340"
                     Stroke="{DynamicResource Brush.Gold}" StrokeThickness="1" Opacity="0.17"
                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-72,-8,0"/>
        </Grid>

        <!-- Right panel -->
        <Border Grid.Column="1"
                Background="{DynamicResource Brush.MainPanelGradient}"
                BorderBrush="{DynamicResource Brush.Gold}"
                BorderThickness="1"
                CornerRadius="2"
                Padding="24"
                VerticalAlignment="Center"
                Margin="0,34,34,34"
                Effect="{StaticResource Effect.PanelShadow}">
            <StackPanel>

                <!-- Header -->
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="&#x25CF;"
                               Foreground="{DynamicResource Brush.GoldSoft}"
                               FontFamily="Segoe UI Symbol"
                               FontSize="28"
                               DockPanel.Dock="Left"
                               Margin="0,0,14,0"/>
                    <TextBlock Text="{Binding TblTitle}"
                               Foreground="{DynamicResource Brush.GoldSoft}"
                               FontFamily="Georgia"
                               FontSize="22"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <TextBlock Text="{Binding TblWelcome}"
                           Foreground="{DynamicResource Brush.Muted}"
                           FontFamily="Georgia"
                           FontSize="13"
                           Margin="0,0,0,16"/>

                <!-- Gold divider -->
                <Grid Margin="0,0,0,16">
                    <Rectangle Height="1" Fill="{DynamicResource Brush.Gold}" Opacity="0.65" VerticalAlignment="Center"/>
                    <TextBlock Text="&#x25C7;"
                               Foreground="{DynamicResource Brush.GoldSoft}"
                               FontFamily="Segoe UI Symbol"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,-11,0,0"/>
                </Grid>

                <Button Content="{Binding TblPlay}"
                        Command="{Binding Play}"
                        Background="{DynamicResource Brush.BlueActive}"
                        Style="{StaticResource HubButton}"/>

                <Button Content="{Binding TblSettings}"
                        Command="{Binding Settings}"
                        Style="{StaticResource HubButton}"/>

                <Button Content="{Binding TblAccount}"
                        Command="{Binding Account}"
                        Style="{StaticResource HubButton}"/>

                <Button Content="{Binding TblLogout}"
                        Command="{Binding Logout}"
                        Style="{StaticResource HubButton}"/>

                <Grid Margin="0,6,0,14">
                    <Rectangle Height="1" Fill="{DynamicResource Brush.Gold}" Opacity="0.35"/>
                </Grid>

                <Button Content="{Binding TblBack}"
                        Command="{Binding Back}"
                        Margin="0"
                        Style="{StaticResource HubButton}"/>
            </StackPanel>
        </Border>

        <!-- Sub-view frame (Account page) -->
        <Frame Grid.Column="0"
               Name="Frame"
               Margin="34"
               NavigationUIVisibility="Hidden"/>
    </Grid>
</Page>
