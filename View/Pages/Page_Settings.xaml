<Page x:Class="Myria.Wpf.View.Pages.Page_Settings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Myria.Wpf.View.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page_Settings">

    <Page.Resources>
        <Style x:Key="SettingsNavItem" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="0,11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle x:Name="Bar"
                                           Fill="{DynamicResource Brush.Accent}"
                                           RadiusX="2" RadiusY="2"
                                           Opacity="0"/>
                                <ContentPresenter Grid.Column="1"
                                                  Margin="14,0,0,0"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.TileBackground}"/>
                                <Setter TargetName="Bar" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="520" Height="300"
                CornerRadius="16"
                Background="{DynamicResource Brush.Background}">
            <Border.OpacityMask>
                <SolidColorBrush Color="#E5000000"/>
            </Border.OpacityMask>
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.4" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left nav panel with divider -->
                <Border BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,0,1,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Title}"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Foreground}"
                                   Margin="17,20,0,14"/>
                        <Button Content="{Binding btnVisuals}" Command="{Binding Visuals}"
                                Style="{StaticResource SettingsNavItem}"/>
                        <Button Content="{Binding BtnKeybindings}" Command="{Binding KeybindingsCommand}"
                                Style="{StaticResource SettingsNavItem}"/>
                        <Button Content="{Binding BtnMods}" Command="{Binding ModsCommand}"
                                Style="{StaticResource SettingsNavItem}"/>
                        <Separator Margin="8,6" Opacity="0.35"
                                   Visibility="{Binding BackButtonVisibility}"/>
                        <Button Content="{Binding TblBack, StringFormat='← {0}'}" Command="{Binding BackCommand}"
                                Style="{StaticResource SettingsNavItem}"
                                Visibility="{Binding BackButtonVisibility}"/>
                    </StackPanel>
                </Border>

                <!-- Sub-page content -->
                <Frame Grid.Column="1"
                       Name="frm_NavigationFrame"
                       NavigationUIVisibility="Hidden"
                       Margin="16"/>
            </Grid>
        </Border>
    </Grid>
</Page>
