<Page x:Class="Myria.Wpf.View.Pages.Game.Page_Room"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page_Room">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Action buttons (Fight / Gather) -->
        <Style x:Key="RoomActionButton" TargetType="Button">
            <Setter Property="Background"      Value="{DynamicResource Brush.BlueActive}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"      Value="{DynamicResource Brush.GoldSoft}"/>
            <Setter Property="FontFamily"      Value="Georgia"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Padding"         Value="14,5"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Directional movement buttons (overlaid on image) -->
        <Style x:Key="DirButton" TargetType="Button">
            <Setter Property="Background"      Value="#B2080D10"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"      Value="{DynamicResource Brush.GoldSoft}"/>
            <Setter Property="FontFamily"      Value="Georgia"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Padding"         Value="12,5"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CC0A1824"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.GoldSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Room image -->
        <Image Source="{Binding ImageSource}" Stretch="Fill"/>

        <!-- ── Bottom info panel ── -->
        <Border Grid.Row="1"
                Background="{DynamicResource Brush.MainPanelGradient}"
                BorderBrush="{DynamicResource Brush.Gold}"
                BorderThickness="0,1,0,0"
                Padding="16,7,12,7"
                Effect="{StaticResource Effect.PanelShadow}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: room name + description + action buttons -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">

                    <TextBlock Text="{Binding RoomName}"
                               FontFamily="Georgia"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Foreground}"/>

                    <TextBlock Text="{Binding RoomDescription}"
                               FontFamily="Georgia"
                               FontSize="12"
                               Foreground="{DynamicResource Brush.Foreground}"
                                Opacity="0.75"
                                TextWrapping="Wrap"
                                MaxHeight="48"
                                Margin="0,3,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                        <Button Content="{Binding BtnFight}"
                                Command="{Binding StartFightCommand}"
                                Visibility="{Binding BtnFightVisibility}"
                                Style="{StaticResource RoomActionButton}"
                                Margin="0,0,8,0"/>
                        <Button Content="{Binding BtnGroupFight}"
                                Command="{Binding StartGroupFightLocalCommand}"
                                Visibility="{Binding BtnFightVisibility}"
                                Style="{StaticResource RoomActionButton}"
                                Margin="0,0,8,0"/>
                        <Button Content="{Binding BtnGather}"
                                Command="{Binding StartGatheringCommand}"
                                Visibility="{Binding BtnGatherVisibility}"
                                Style="{StaticResource RoomActionButton}"/>
                    </StackPanel>

                </StackPanel>

                <!-- Right: NPCs + activity log -->
                <Border Grid.Column="1"
                        Width="690"
                        MaxHeight="118"
                        Background="{DynamicResource Brush.PanelDark}"
                        BorderBrush="#AA9B6A2E"
                        BorderThickness="1"
                        CornerRadius="2"
                        Padding="8"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="156"/>
                            <ColumnDefinition Width="232"/>
                        </Grid.ColumnDefinitions>

                        <!-- NPC list — hidden when room has no NPCs -->
                        <StackPanel Grid.Column="0"
                                    Visibility="{Binding HasNpcsVisibility}"
                                    Width="190">

                            <!-- Section label -->
                            <TextBlock Text="{Binding BtnNpcs}"
                                       FontFamily="Georgia"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.GoldSoft}"
                                       Margin="2,0,0,4"/>

                            <ListBox ItemsSource="{Binding Npcs}"
                                     SelectedItem="{Binding SelectedNpc}"
                                     Background="{DynamicResource Brush.PanelDark}"
                                     BorderBrush="#339B6A2E"
                                     BorderThickness="1"
                                     MaxHeight="76"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,1"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <EventSetter Event="MouseDoubleClick" Handler="NpcListItem_MouseDoubleClick"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd"
                                                            CornerRadius="2"
                                                            Padding="6,3"
                                                            Background="Transparent">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding}"
                                                                       FontFamily="Georgia"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource Brush.Foreground}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center"/>
                                                            <Border x:Name="TypeBadge"
                                                                    Grid.Column="1"
                                                                    CornerRadius="2"
                                                                    Padding="4,0"
                                                                    Background="{DynamicResource Brush.Panel}"
                                                                    BorderBrush="#669B6A2E"
                                                                    BorderThickness="1"
                                                                    Margin="5,0,0,0">
                                                                <TextBlock Text="{Binding Type}"
                                                                           FontFamily="Georgia"
                                                                           FontSize="9"
                                                                           FontWeight="Bold"
                                                                           Foreground="{DynamicResource Brush.GoldSoft}"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BlueActive}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BlueActive}"/>
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
                                                            <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                                                            <Setter TargetName="TypeBadge" Property="Background" Value="#33FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </StackPanel>

                        <!-- NPC detail — hidden when room has no NPCs -->
                        <StackPanel Grid.Column="1"
                                    Visibility="{Binding HasNpcsVisibility}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,0,0">

                            <!-- Divider -->
                            <Rectangle Width="1"
                                       Fill="{DynamicResource Brush.Gold}"
                                       Opacity="0.35"
                                       Margin="10,0"
                                       Height="88"/>
                        </StackPanel>

                        <!-- NPC detail content — hidden when room has no NPCs -->
                        <StackPanel Grid.Column="1"
                                    Visibility="{Binding HasNpcsVisibility}"
                                    VerticalAlignment="Center"
                                    Width="132"
                                    Margin="18,-5,6,0">
                            <TextBlock Text="{Binding SelectedNpcName}"
                                       FontFamily="Georgia"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Foreground}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SelectedNpcDescription}"
                                       FontFamily="Georgia"
                                       FontSize="11"
                                       Foreground="{DynamicResource Brush.Foreground}"
                                       Opacity="0.68"
                                       TextWrapping="Wrap"
                                       MaxHeight="40"
                                       Margin="0,2,0,5"/>
                            <Button Content="{Binding BtnTalk}"
                                    Command="{Binding TalkCommand}"
                                    Style="{StaticResource RoomActionButton}"
                                    FontSize="12"
                                    Padding="10,3"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!-- Activity log -->
                        <Border Grid.Column="2"
                                Background="#08131D"
                                BorderBrush="#339B6A2E"
                                BorderThickness="1"
                                CornerRadius="2"
                                Padding="8,6"
                                Margin="8,0,0,0">
                            <StackPanel>
                            <!-- Section label -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding TblLog}"
                                           FontFamily="Georgia"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.GoldSoft}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <Rectangle Grid.Column="1"
                                           Height="1"
                                           Fill="{DynamicResource Brush.Gold}"
                                           Opacity="0.3"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <ScrollViewer x:Name="LogScrollViewer"
                                          MaxHeight="76"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Log}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       FontFamily="Georgia"
                                                       FontSize="10"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Brush.Foreground}"
                                                       Opacity="0.78"
                                                       Margin="0,0,0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            </StackPanel>
                        </Border>

                    </Grid>
                </Border>

            </Grid>
        </Border>

        <!-- Directional exit buttons (overlaid on image) -->
        <Button Content="{Binding BtnNorth}"
                Command="{Binding MoveCommand}" CommandParameter="North"
                Visibility="{Binding HasNorth, Converter={StaticResource BoolToVis}}"
                Style="{StaticResource DirButton}"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,10,0,0"/>

        <Button Content="{Binding BtnSouth}"
                Command="{Binding MoveCommand}" CommandParameter="South"
                Visibility="{Binding HasSouth, Converter={StaticResource BoolToVis}}"
                Style="{StaticResource DirButton}"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,56"/>

        <Button Content="{Binding BtnGuildHouse}"
                Command="{Binding EnterGuildCommand}"
                Visibility="{Binding HasGuildEntry, Converter={StaticResource BoolToVis}}"
                Style="{StaticResource DirButton}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,10,56"/>

        <Button Content="{Binding BtnWest}"
                Command="{Binding MoveCommand}" CommandParameter="West"
                Visibility="{Binding HasWest, Converter={StaticResource BoolToVis}}"
                Style="{StaticResource DirButton}"
                HorizontalAlignment="Left" VerticalAlignment="Center"
                Margin="10,0,0,0"/>

        <Button Content="{Binding BtnEast}"
                Command="{Binding MoveCommand}" CommandParameter="East"
                Visibility="{Binding HasEast, Converter={StaticResource BoolToVis}}"
                Style="{StaticResource DirButton}"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Margin="0,0,10,0"/>
    </Grid>
</Page>
