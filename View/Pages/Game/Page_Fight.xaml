<Page x:Class="Myria.Wpf.View.Pages.Game.Page_Fight"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Background="Transparent">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>          <!-- transparent: game scene + HUD cards -->
            <RowDefinition Height="2*"/>  <!-- combat panel -->
        </Grid.RowDefinitions>

        <!-- Combat panel -->
        <Border Grid.Row="1"
                Background="{DynamicResource Brush.HudBodyGradient}"
                BorderBrush="{DynamicResource Brush.Gold}"
                BorderThickness="0,1,0,0"
                Effect="{StaticResource Effect.PanelShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="230"/>
                </Grid.ColumnDefinitions>

                <!-- ── Combat log ── -->
                <Border Grid.Column="0"
                        Background="{DynamicResource Brush.PanelDark}"
                        Margin="0" BorderThickness="0">
                    <ScrollViewer x:Name="LogScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="14,10">
                        <ItemsControl ItemsSource="{Binding LogLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Bullet}"
                                                   Foreground="{Binding BulletColor}"
                                                   FontFamily="Segoe UI Symbol" FontSize="12"
                                                   VerticalAlignment="Top" Margin="0,1,0,0"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Text}"
                                                   Foreground="{Binding Color}"
                                                   FontFamily="Georgia" FontSize="12"
                                                   TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Vertical divider -->
                <Rectangle Grid.Column="1"
                           Fill="{DynamicResource Brush.Gold}"
                           Opacity="0.35"/>

                <!-- ── Action column ── -->
                <Grid Grid.Column="2" Margin="12,12,12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Attack -->
                        <RowDefinition Height="*"/>     <!-- Skills -->
                        <RowDefinition Height="Auto"/>  <!-- Run -->
                    </Grid.RowDefinitions>

                    <!-- Attack button -->
                    <Button Grid.Row="0"
                            Content="{Binding BtnAttack}"
                            Command="{Binding AttackCommand}"
                            IsEnabled="{Binding CanAct}"
                            Style="{StaticResource ShopPrimaryButton}"
                            Height="40"
                            Margin="0,0,0,10"/>

                    <!-- Skill grid -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Skills}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="50" Height="54"
                                            Margin="0,0,5,5"
                                            Command="{Binding DataContext.CastSkillCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource ShopQtyButton}"
                                            Padding="2">
                                        <Button.ToolTip>
                                            <Border Background="{DynamicResource Brush.PanelDark}"
                                                    BorderBrush="{DynamicResource Brush.Gold}"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Padding="10,8"
                                                    MaxWidth="240">
                                                <StackPanel>
                                                    <Border Background="{DynamicResource Brush.BlueActive}"
                                                            BorderBrush="{DynamicResource Brush.Gold}"
                                                            BorderThickness="1"
                                                            CornerRadius="3" Padding="5,2"
                                                            Margin="0,0,0,5"
                                                            HorizontalAlignment="Left"
                                                            Visibility="{Binding HasTag, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding Tag}"
                                                                   FontFamily="Georgia" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Brush.GoldSoft}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontFamily="Georgia" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Brush.GoldSoft}"
                                                               Margin="0,0,0,3"/>
                                                    <TextBlock Text="{Binding Description}"
                                                               FontFamily="Georgia" FontSize="11"
                                                               Foreground="{DynamicResource Brush.Foreground}"
                                                               TextWrapping="Wrap" Opacity="0.85"/>
                                                    <TextBlock Text="{Binding ManaCostText}"
                                                               FontFamily="Georgia" FontSize="10"
                                                               Foreground="#65B5E8"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Button.ToolTip>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ButtonLabel}"
                                                       FontFamily="Georgia" FontSize="11" FontWeight="Bold"
                                                       Foreground="{DynamicResource Brush.GoldSoft}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding ManaCost}"
                                                       FontFamily="Georgia" FontSize="9"
                                                       Foreground="#65B5E8"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Run button -->
                    <Button Grid.Row="2"
                            Content="{Binding BtnRun}"
                            Command="{Binding RunCommand}"
                            Style="{StaticResource ShopQtyButton}"
                            Height="34"
                            Margin="0,8,0,0"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
