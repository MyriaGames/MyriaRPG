<Page x:Class="Myria.Wpf.View.Pages.Game.IngameWindow.Page_Friends"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="720" d:DesignWidth="980"
      Background="Transparent"
      Title="Friends">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <DropShadowEffect x:Key="SocialGlow" BlurRadius="18" ShadowDepth="0" Opacity="0.45"
                          Color="{DynamicResource Color.Gold}"/>

        <!-- Tab button (Friends / Requests / Blocked switcher) -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Height"          Value="46"/>
            <Setter Property="Foreground"      Value="{DynamicResource Brush.Muted}"/>
            <Setter Property="Background"      Value="{DynamicResource Brush.PanelDark}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily"      Value="Georgia"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.NavHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action button inside friend/request/blocked cards -->
        <Style x:Key="SocialButton" TargetType="Button">
            <Setter Property="MinHeight"               Value="42"/>
            <Setter Property="Foreground"              Value="{DynamicResource Brush.GoldSoft}"/>
            <Setter Property="Background"              Value="{DynamicResource Brush.PanelDark}"/>
            <Setter Property="BorderBrush"             Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="BorderThickness"         Value="1"/>
            <Setter Property="FontFamily"              Value="Georgia"/>
            <Setter Property="FontSize"                Value="15"/>
            <Setter Property="Cursor"                  Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
            <Setter Property="Padding"                 Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.NavHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.BlueActive}"/>
                                <Setter Property="Effect"     Value="{StaticResource SocialGlow}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SocialIconButton" TargetType="Button" BasedOn="{StaticResource SocialButton}">
            <Setter Property="Width"      Value="42"/>
            <Setter Property="MinHeight"  Value="42"/>
            <Setter Property="Padding"    Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize"   Value="18"/>
        </Style>

        <Style x:Key="SocialDangerButton" TargetType="Button" BasedOn="{StaticResource SocialButton}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Error}"/>
        </Style>

        <!-- Friend / request / blocked card row -->
        <Style x:Key="SocialEntry" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource Brush.PanelDark}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="2"/>
            <Setter Property="Padding"         Value="14"/>
            <Setter Property="Margin"          Value="0,0,0,8"/>
        </Style>

        <!-- Search box -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Height"                  Value="46"/>
            <Setter Property="Background"              Value="{DynamicResource Brush.PanelDark}"/>
            <Setter Property="Foreground"              Value="{DynamicResource Brush.Foreground}"/>
            <Setter Property="BorderBrush"             Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="BorderThickness"         Value="1"/>
            <Setter Property="FontFamily"              Value="Georgia"/>
            <Setter Property="FontSize"                Value="15"/>
            <Setter Property="Padding"                 Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid MinWidth="600" MinHeight="360" Background="{DynamicResource Brush.WindowBackgroundGradient}">

        <!-- Decorative watermark -->
        <TextBlock Text="✦"
                   FontSize="220"
                   Foreground="{DynamicResource Brush.Panel}"
                   Opacity="0.4"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="0,10,40,0"/>

        <!-- Outer gold-bordered container -->
        <Border Margin="10"
                BorderBrush="{DynamicResource Brush.Gold}"
                BorderThickness="1">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ── HEADER ────────────────────────────────────────────── -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                        <TextBlock Text="→"
                                   Foreground="{DynamicResource Brush.Gold}"
                                   FontSize="34"
                                   Margin="0,4,14,0"/>
                        <TextBlock Text="FRIENDS"
                                   Style="{StaticResource HeaderText}"/>
                        <TextBlock Foreground="{DynamicResource Brush.GoldSoft}"
                                   FontFamily="Georgia"
                                   FontStyle="Italic"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="18,6,0,0">
                            <Run Text=" | "/>
                            <Run Text="{Binding FriendCount, Mode=OneWay}"/>
                            <Run Text=" / 100 friends connected"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Refresh button -->
                    <Button Grid.Column="1"
                            Content="↺  REFRESH"
                            Command="{Binding RefreshCommand}"
                            VerticalAlignment="Center"
                            Margin="0,0,0,10"
                            Padding="16,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                <Setter Property="FontSize" Value="12"/>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Rectangle Grid.ColumnSpan="2"
                               Height="1"
                               Fill="{DynamicResource Brush.Gold}"
                               VerticalAlignment="Bottom"
                               Opacity="0.55"/>
                </Grid>

                <!-- ── BODY ──────────────────────────────────────────────── -->
                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ── Tab content ──────────────────────────────────── -->
                    <Grid Grid.Row="1">

                        <!-- ╔══ FRIENDS TAB ═══════════════════════════════╗ -->
                        <Border Style="{StaticResource GoldBorder}" Padding="14"
                                Visibility="{Binding IsFriendsTab, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Search + sort -->
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SearchBox}"/>
                                    <Button Grid.Column="2"
                                            Command="{Binding ToggleSortCommand}"
                                            Style="{StaticResource SocialButton}"
                                            MinWidth="160">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding SortLabel}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text=" ▾" FontFamily="Segoe UI Symbol" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Friend list -->
                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Padding="0,0,10,0"
                                              Margin="0,0,0,12">
                                    <ItemsControl ItemsSource="{Binding FilteredFriends}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource SocialEntry}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="48"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Avatar circle -->
                                                        <Border Grid.Column="0"
                                                                Width="42" Height="42"
                                                                CornerRadius="21"
                                                                Background="{Binding OnlineColor}"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding AvatarInitial}"
                                                                       Foreground="White"
                                                                       FontFamily="Georgia"
                                                                       FontSize="17"
                                                                       FontWeight="Bold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>

                                                        <!-- Name + level/class -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                                                            <TextBlock Text="{Binding Username}"
                                                                       Foreground="{DynamicResource Brush.Foreground}"
                                                                       FontFamily="Georgia"
                                                                       FontSize="16"
                                                                       FontWeight="Bold"/>
                                                            <TextBlock Text="{Binding LevelClassText}"
                                                                       Style="{StaticResource MutedText}"
                                                                       Margin="0,3,0,0"/>
                                                        </StackPanel>

                                                        <!-- Status badge + location -->
                                                        <StackPanel Grid.Column="2"
                                                                    VerticalAlignment="Center"
                                                                    HorizontalAlignment="Right"
                                                                    Margin="0,0,12,0">
                                                            <Border Background="{Binding StatusBackground}"
                                                                    BorderBrush="{DynamicResource Brush.Gold}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="2"
                                                                    Padding="10,4"
                                                                    HorizontalAlignment="Right">
                                                                <TextBlock Text="{Binding StatusText}"
                                                                           Foreground="{Binding StatusForeground}"
                                                                           FontFamily="Georgia"
                                                                           FontSize="11"
                                                                           FontWeight="Bold"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Location}"
                                                                       Style="{StaticResource MutedText}"
                                                                       FontSize="11"
                                                                       Margin="0,5,0,0"
                                                                       HorizontalAlignment="Right"/>
                                                        </StackPanel>

                                                        <!-- Whisper + more options -->
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="✉"
                                                                    Style="{StaticResource SocialIconButton}"
                                                                    Command="{Binding WhisperCommand}"
                                                                    ToolTip="{Binding DataContext.TblWhisper, RelativeSource={RelativeSource AncestorType=Page}}"/>
                                                            <Button Content="⋮"
                                                                    Style="{StaticResource SocialIconButton}"
                                                                    ToolTip="{Binding DataContext.TblMoreOptions, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                    Margin="8,0,0,0"
                                                                    Click="MoreOptions_Click"
                                                                    Tag="{Binding}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- Add Friend button -->
                                <Button Grid.Row="2"
                                        Content="{Binding TblAddFriend}"
                                        Command="{Binding AddFriendCommand}"
                                        Style="{StaticResource SocialButton}"
                                        Background="{DynamicResource Brush.BlueActive}"
                                        Height="46"/>
                            </Grid>
                        </Border>

                        <!-- ╔══ REQUESTS TAB ══════════════════════════════╗ -->
                        <Border Style="{StaticResource GoldBorder}" Padding="14"
                                Visibility="{Binding IsRequestsTab, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="{Binding TblRequestsHeader}"
                                           Style="{StaticResource SectionTitle}"
                                           Margin="0,0,0,14"/>

                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Padding="0,0,10,0">
                                    <StackPanel>

                                        <!-- Empty state -->
                                        <TextBlock Text="{Binding TblRequestsEmpty}"
                                                   FontStyle="Italic"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,28,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasRequests}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <ItemsControl ItemsSource="{Binding Requests}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource SocialEntry}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="48"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="10"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0"
                                                                    Width="42" Height="42"
                                                                    CornerRadius="21"
                                                                    Background="{DynamicResource Brush.PanelDark}"
                                                                    BorderBrush="{DynamicResource Brush.Gold}"
                                                                    BorderThickness="1"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding AvatarInitial}"
                                                                           Foreground="{DynamicResource Brush.GoldSoft}"
                                                                           FontFamily="Georgia"
                                                                           FontSize="17"
                                                                           FontWeight="Bold"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>

                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding FromUsername}"
                                                                       Foreground="{DynamicResource Brush.Foreground}"
                                                                       FontFamily="Georgia"
                                                                       FontSize="16"
                                                                       FontWeight="Bold"
                                                                       VerticalAlignment="Center"
                                                                       Margin="12,0"/>

                                                            <Button Grid.Column="2"
                                                                    Content="{Binding DataContext.TblAccept, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                    Command="{Binding AcceptCommand}"
                                                                    Style="{StaticResource SocialButton}"
                                                                    Background="{DynamicResource Brush.Success}"
                                                                    Foreground="{DynamicResource Brush.Foreground}"
                                                                    MinWidth="100"/>

                                                            <Button Grid.Column="4"
                                                                    Content="{Binding DataContext.TblDecline, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                    Command="{Binding DeclineCommand}"
                                                                    Style="{StaticResource SocialButton}"
                                                                    MinWidth="100"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- ╔══ BLOCKED TAB ════════════════════════════════╗ -->
                        <Border Style="{StaticResource GoldBorder}" Padding="14"
                                Visibility="{Binding IsBlockedTab, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="{Binding TblBlockedHeader}"
                                           Style="{StaticResource SectionTitle}"
                                           Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="1"
                                           Text="{Binding TblBlockedDesc}"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,0,0,14"/>

                                <ScrollViewer Grid.Row="2"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Padding="0,0,10,0">
                                    <StackPanel>

                                        <!-- Empty state -->
                                        <TextBlock Text="{Binding TblBlockedEmpty}"
                                                   FontStyle="Italic"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,28,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasBlocked}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <ItemsControl ItemsSource="{Binding BlockedCharacters}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource SocialEntry}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="48"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0"
                                                                    Width="42" Height="42"
                                                                    CornerRadius="21"
                                                                    Background="{DynamicResource Brush.PanelDark}"
                                                                    BorderBrush="{DynamicResource Brush.Error}"
                                                                    BorderThickness="1"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding AvatarInitial}"
                                                                           Foreground="{DynamicResource Brush.Error}"
                                                                           FontFamily="Georgia"
                                                                           FontSize="17"
                                                                           FontWeight="Bold"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>

                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                                                                <TextBlock Text="{Binding Username}"
                                                                           Foreground="{DynamicResource Brush.Foreground}"
                                                                           FontFamily="Georgia"
                                                                           FontSize="16"
                                                                           FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding DataContext.TblBlockedLabel, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                           Foreground="{DynamicResource Brush.Error}"
                                                                           FontFamily="Georgia"
                                                                           FontSize="12"
                                                                           Margin="0,3,0,0"/>
                                                            </StackPanel>

                                                            <Button Grid.Column="2"
                                                                    Content="{Binding DataContext.TblUnblock, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                    Command="{Binding UnblockCommand}"
                                                                    Style="{StaticResource SocialDangerButton}"
                                                                    MinWidth="110"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
