<Page x:Class="Myria.Wpf.View.Pages.Game.IngameWindow.Page_SkillDetail"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="Transparent">

    <Page.Resources>
        <Style x:Key="SkillUpgradeButton" TargetType="Button" BasedOn="{StaticResource GoldButtonBase}">
            <Setter Property="Height"      Value="30"/>
            <Setter Property="MinWidth"    Value="80"/>
            <Setter Property="Foreground"  Value="{DynamicResource Brush.GoldSoft}"/>
            <Setter Property="Background"  Value="{DynamicResource Brush.PanelDark}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="FontSize"    Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.NavHover}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>

            <TextBlock Text="{Binding Name}"
                       FontFamily="{StaticResource Font.Body}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.GoldSoft}"
                       Margin="0,0,0,6"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="{Binding ClassName}"
                           Foreground="{DynamicResource Brush.SecondaryText}"
                           Margin="0,0,10,0"/>
                <TextBlock Text="&#x25AA;"
                           Foreground="{DynamicResource Brush.Gold}"
                           Opacity="0.5"
                           Margin="0,0,10,0"/>
                <TextBlock Text="{Binding TypeText}"
                           Foreground="{DynamicResource Brush.Foreground}"
                           Margin="0,0,10,0"/>
                <TextBlock Text="&#x25AA;"
                           Foreground="{DynamicResource Brush.Gold}"
                           Opacity="0.5"
                           Margin="0,0,10,0"/>
                <TextBlock Text="{Binding TargetText}"
                           Foreground="{DynamicResource Brush.Foreground}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Mana: " Foreground="{DynamicResource Brush.SecondaryText}"/>
                <TextBlock Text="{Binding ManaCost}" Foreground="{DynamicResource Brush.Foreground}" Margin="0,0,16,0"/>
                <TextBlock Text="{Binding TimingText}" Foreground="{DynamicResource Brush.SecondaryText}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="Scaling: " Foreground="{DynamicResource Brush.SecondaryText}"/>
                <TextBlock Text="{Binding ScalingText}" Foreground="{DynamicResource Brush.Foreground}"/>
            </StackPanel>

            <Rectangle Height="1"
                       Fill="{DynamicResource Brush.Gold}"
                       Opacity="0.3"
                       Margin="0,0,0,16"/>

            <TextBlock Text="Description"
                       FontWeight="SemiBold"
                       FontFamily="{StaticResource Font.Body}"
                       FontSize="13"
                       Foreground="{DynamicResource Brush.SecondaryText}"
                       Margin="0,0,0,6"/>
            <TextBlock Text="{Binding Description}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Foreground}"
                       LineHeight="22"/>

            <!-- What the skill actually does in combat (poison, stun, lifesteal, etc.) - separate
                 from Description, which is just flavor text. Omitted entirely for skills with no
                 data-driven Effects (most damage/heal-only skills). -->
            <StackPanel Visibility="{Binding HasEffects, Converter={StaticResource BoolToVis}}">

                <TextBlock Text="Effects"
                           FontWeight="SemiBold"
                           FontFamily="{StaticResource Font.Body}"
                           FontSize="13"
                           Foreground="{DynamicResource Brush.SecondaryText}"
                           Margin="0,16,0,6"/>

                <ItemsControl ItemsSource="{Binding Effects}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Gold}"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    Padding="10,8"
                                    Margin="0,0,0,6">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.GoldSoft}"/>
                                        <TextBlock Text="{Binding TargetText, StringFormat=' — {0}'}"
                                                   Foreground="{DynamicResource Brush.SecondaryText}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource Brush.Foreground}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>

            <!-- Leveling / upgrades - only for real base skills (not e.g. the Rune tab's entries) -->
            <StackPanel Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}">

                <Rectangle Height="1"
                           Fill="{DynamicResource Brush.Gold}"
                           Opacity="0.3"
                           Margin="0,16,0,16"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Level " Foreground="{DynamicResource Brush.SecondaryText}"/>
                    <TextBlock Text="{Binding Level}" Foreground="{DynamicResource Brush.GoldSoft}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                    <TextBlock Text="Used " Foreground="{DynamicResource Brush.SecondaryText}"/>
                    <TextBlock Text="{Binding UsageCount}" Foreground="{DynamicResource Brush.Foreground}" Margin="0,0,16,0"/>
                    <TextBlock Text="Unspent points: " Foreground="{DynamicResource Brush.SecondaryText}"/>
                    <TextBlock Text="{Binding UnspentPoints}" Foreground="{DynamicResource Brush.GoldSoft}" FontWeight="SemiBold"/>
                </StackPanel>

                <TextBlock Text="Upgrades"
                           FontWeight="SemiBold"
                           FontFamily="{StaticResource Font.Body}"
                           FontSize="13"
                           Foreground="{DynamicResource Brush.SecondaryText}"
                           Margin="0,10,0,6"/>

                <ItemsControl ItemsSource="{Binding UpgradeOptions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Gold}"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    Padding="10,8"
                                    Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Description}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Brush.Foreground}"/>
                                        <TextBlock Text="{Binding AddsEffectText}"
                                                   TextWrapping="Wrap"
                                                   FontStyle="Italic"
                                                   Foreground="{DynamicResource Brush.SecondaryText}"
                                                   Margin="0,2,0,0"
                                                   Visibility="{Binding HasAddsEffectText, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding TimesPurchased, StringFormat='Purchased ×{0}'}"
                                                   FontStyle="Italic"
                                                   Foreground="{DynamicResource Brush.GoldSoft}"
                                                   Margin="0,2,0,0"
                                                   Visibility="{Binding HasPurchases, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Buy"
                                            Style="{StaticResource SkillUpgradeButton}"
                                            IsEnabled="{Binding CanPurchase}"
                                            Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.SpendPointCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Margin="10,0,0,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding UnavailableReasonText}"
                                               Foreground="{DynamicResource Brush.Muted}"
                                               FontStyle="Italic"
                                               VerticalAlignment="Center"
                                               TextAlignment="Right"
                                               MaxWidth="120"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding IsUnavailable, Converter={StaticResource BoolToVis}}"
                                               Margin="10,0,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="No upgrades authored for this skill yet."
                           Foreground="{DynamicResource Brush.Muted}"
                           FontStyle="Italic"
                           Margin="0,4,0,0"
                           Visibility="{Binding NoUpgradeOptions, Converter={StaticResource BoolToVis}}"/>

                <Button Content="{Binding RespecCost, StringFormat='Respec ({0} gold)'}"
                        Style="{StaticResource SkillUpgradeButton}"
                        IsEnabled="{Binding HasPurchasedUpgrades}"
                        Command="{Binding RespecCommand}"
                        HorizontalAlignment="Left"
                        Margin="0,10,0,0"/>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
