<Page x:Class="Myria.Wpf.View.Pages.Game.IngameWindow.Page_Guild"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="720" d:DesignWidth="980"
      Background="Transparent"
      Title="Guild">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Height"          Value="46"/>
            <Setter Property="Foreground"      Value="{DynamicResource Brush.Muted}"/>
            <Setter Property="Background"      Value="{DynamicResource Brush.PanelDark}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily"      Value="Georgia"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.NavHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button" BasedOn="{StaticResource TabBtn}">
            <Setter Property="Height"          Value="36"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Padding"         Value="10,0"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Foreground"  Value="{DynamicResource Brush.Error}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Error}"/>
        </Style>

        <Style x:Key="MemberRow" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource Brush.PanelDark}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="2"/>
            <Setter Property="Padding"         Value="12,8"/>
            <Setter Property="Margin"          Value="0,0,0,6"/>
        </Style>

        <Style x:Key="PrimaryInput" TargetType="TextBox">
            <Setter Property="Height"                  Value="42"/>
            <Setter Property="Background"              Value="{DynamicResource Brush.PanelDark}"/>
            <Setter Property="Foreground"              Value="{DynamicResource Brush.Foreground}"/>
            <Setter Property="BorderBrush"             Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="BorderThickness"         Value="1"/>
            <Setter Property="FontFamily"              Value="Georgia"/>
            <Setter Property="FontSize"                Value="14"/>
            <Setter Property="Padding"                 Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid MinWidth="600" MinHeight="360" Background="{DynamicResource Brush.WindowBackgroundGradient}">

        <!-- Watermark -->
        <TextBlock Text="⚔"
                   FontSize="220" Opacity="0.07"
                   Foreground="{DynamicResource Brush.Gold}"
                   HorizontalAlignment="Right" VerticalAlignment="Top"
                   Margin="0,10,30,0"/>

        <Border Margin="10" BorderBrush="{DynamicResource Brush.Gold}" BorderThickness="1">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ── HEADER ─────────────────────────────────────────────── -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                        <TextBlock Text="→" Foreground="{DynamicResource Brush.Gold}"
                                   FontSize="34" Margin="0,4,14,0"/>
                        <TextBlock Text="GUILD" Style="{StaticResource HeaderText}"/>

                        <!-- Guild name when in guild -->
                        <TextBlock Visibility="{Binding IsInGuild, Converter={StaticResource BoolToVis}}"
                                   Foreground="{DynamicResource Brush.GoldSoft}"
                                   FontFamily="Georgia" FontStyle="Italic" FontSize="13"
                                   VerticalAlignment="Center" Margin="18,6,0,0">
                            <Run Text=" | "/>
                            <Run Text="{Binding GuildName, Mode=OneWay}"/>
                            <Run Text=" ["/>
                            <Run Text="{Binding GuildTag, Mode=OneWay}"/>
                            <Run Text="]"/>
                        </TextBlock>

                        <!-- My rank badge -->
                        <Border Visibility="{Binding IsInGuild, Converter={StaticResource BoolToVis}}"
                                Background="{DynamicResource Brush.PanelDark}"
                                BorderBrush="{DynamicResource Brush.Gold}" BorderThickness="1"
                                CornerRadius="2" Padding="8,2" Margin="12,6,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding MyRank}" FontFamily="Georgia" FontSize="11"
                                       Foreground="{DynamicResource Brush.GoldSoft}" FontWeight="Bold"/>
                        </Border>

                        <!-- Counts -->
                        <TextBlock Visibility="{Binding IsInGuild, Converter={StaticResource BoolToVis}}"
                                   Foreground="{DynamicResource Brush.Muted}"
                                   FontFamily="Georgia" FontSize="12"
                                   VerticalAlignment="Center" Margin="12,6,0,0">
                            <Run Text="{Binding MemberCount, Mode=OneWay}"/>
                            <Run Text="/50 members ·"/>
                            <Run Text="{Binding RookieCount, Mode=OneWay}"/>
                            <Run Text="/50 rookies"/>
                        </TextBlock>
                    </StackPanel>

                    <Button Grid.Column="1" Content="↺  REFRESH"
                            Command="{Binding RefreshCommand}"
                            VerticalAlignment="Center" Margin="0,0,0,10" Padding="16,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabBtn}">
                                <Setter Property="FontSize" Value="12"/>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Rectangle Grid.ColumnSpan="2" Height="1"
                               Fill="{DynamicResource Brush.Gold}"
                               VerticalAlignment="Bottom" Opacity="0.55"/>
                </Grid>

                <!-- ── BODY ──────────────────────────────────────────────── -->
                <Grid Grid.Row="1" Margin="0,14,0,0">

                    <!-- ══ NOT IN GUILD ══ -->
                    <Grid Visibility="{Binding HasNoGuild, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Status / error -->
                        <TextBlock Grid.Row="0"
                                   Text="{Binding StatusMessage}"
                                   Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}"
                                   Foreground="{DynamicResource Brush.Error}"
                                   FontFamily="Georgia" FontSize="13"
                                   Margin="0,0,0,10"/>

                        <!-- Pending invites -->
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="PENDING INVITES" FontFamily="Georgia" FontSize="12"
                                       FontWeight="Bold" Foreground="{DynamicResource Brush.GoldSoft}"
                                       Margin="0,0,0,8"/>

                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding PendingInvites}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource MemberRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock FontFamily="Georgia" FontSize="15"
                                                                   Foreground="{DynamicResource Brush.Foreground}">
                                                            <Run Text="["/><Run Text="{Binding GuildTag}"/><Run Text="] "/>
                                                            <Run Text="{Binding GuildName}" FontWeight="Bold"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding TypeLabel}"
                                                                   Foreground="{DynamicResource Brush.GoldSoft}"
                                                                   FontFamily="Georgia" FontSize="11"/>
                                                    </StackPanel>

                                                    <Button Grid.Column="1" Content="ACCEPT"
                                                            Command="{Binding AcceptCommand}"
                                                            Style="{StaticResource ActionBtn}"
                                                            Margin="0,0,8,0"/>
                                                    <Button Grid.Column="2" Content="DECLINE"
                                                            Command="{Binding DeclineCommand}"
                                                            Style="{StaticResource DangerBtn}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock Text="No pending guild invites."
                                       FontFamily="Georgia" FontSize="13" FontStyle="Italic"
                                       Foreground="{DynamicResource Brush.Muted}"
                                       Margin="0,8,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PendingInvites.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- Create guild panel -->
                        <Grid Grid.Row="2" Margin="0,14,0,0">
                            <!-- Create button (not showing form) -->
                            <Button Content="+ CREATE GUILD"
                                    Command="{Binding OpenCreateCommand}"
                                    Width="200" HorizontalAlignment="Left">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TabBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowCreatePanel}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Create form -->
                            <Border Visibility="{Binding ShowCreatePanel, Converter={StaticResource BoolToVis}}"
                                    Background="{DynamicResource Brush.PanelDark}"
                                    BorderBrush="{DynamicResource Brush.Gold}" BorderThickness="1"
                                    CornerRadius="2" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="CREATE GUILD" FontFamily="Georgia" FontSize="13"
                                               FontWeight="Bold" Foreground="{DynamicResource Brush.GoldSoft}"
                                               Margin="0,0,0,12"/>

                                    <TextBlock Text="Name" FontFamily="Georgia" FontSize="12"
                                               Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding CreateName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource PrimaryInput}" Margin="0,0,0,10"
                                             MaxLength="60"/>

                                    <TextBlock Text="Tag (up to 5 letters)" FontFamily="Georgia" FontSize="12"
                                               Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding CreateTag, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource PrimaryInput}" Margin="0,0,0,10"
                                             MaxLength="5" Width="120" HorizontalAlignment="Left"/>

                                    <TextBlock Text="Description (optional)" FontFamily="Georgia" FontSize="12"
                                               Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding CreateDesc, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource PrimaryInput}" Margin="0,0,0,10"
                                             MaxLength="300"/>

                                    <TextBlock Text="{Binding CreateError}"
                                               Foreground="{DynamicResource Brush.Error}"
                                               FontFamily="Georgia" FontSize="12"
                                               Visibility="{Binding HasCreateError, Converter={StaticResource BoolToVis}}"
                                               Margin="0,0,0,8"/>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="CANCEL" Command="{Binding CancelCreateCommand}"
                                                Style="{StaticResource ActionBtn}" Margin="0,0,8,0"/>
                                        <Button Content="CREATE" Command="{Binding SubmitCreateCommand}"
                                                Style="{StaticResource ActionBtn}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ══ IN GUILD ══ -->
                    <Grid Visibility="{Binding IsInGuild, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Status message -->
                        <TextBlock Grid.Row="0"
                                   Text="{Binding StatusMessage}"
                                   Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}"
                                   Foreground="{DynamicResource Brush.Error}"
                                   FontFamily="Georgia" FontSize="13" Margin="0,0,0,8"/>

                        <!-- Invite panel (officer+) -->
                        <Grid Grid.Row="1" Margin="0,0,0,10"
                              Visibility="{Binding CanManage, Converter={StaticResource BoolToVis}}">

                            <!-- Toggle button — shown when panel is closed -->
                            <Button Content="+ INVITE PLAYER"
                                    Command="{Binding OpenInviteCommand}"
                                    HorizontalAlignment="Left" Width="180">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TabBtn}">
                                        <Setter Property="FontSize" Value="12"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowInvitePanel}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Invite form -->
                            <Border Visibility="{Binding ShowInvitePanel, Converter={StaticResource BoolToVis}}"
                                    Background="{DynamicResource Brush.PanelDark}"
                                    BorderBrush="{DynamicResource Brush.Gold}" BorderThickness="1"
                                    CornerRadius="2" Padding="14,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Name input row -->
                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding InviteName, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource PrimaryInput}"
                                                 Height="38"
                                                 MaxLength="50">
                                            <TextBox.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="0"/>
                                                </Style>
                                            </TextBox.Resources>
                                        </TextBox>
                                        <Button Grid.Column="1" Content="SEND"
                                                Command="{Binding SendInviteCommand}"
                                                Style="{StaticResource ActionBtn}"
                                                Margin="6,0,6,0"/>
                                        <Button Grid.Column="2" Content="✕"
                                                Command="{Binding CancelInviteCommand}"
                                                Style="{StaticResource ActionBtn}"
                                                Width="36" Padding="0"/>
                                    </Grid>

                                    <!-- Invite type toggle -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                                        <RadioButton Content="Member"
                                                     IsChecked="{Binding InviteAsMember}"
                                                     Foreground="{DynamicResource Brush.Foreground}"
                                                     FontFamily="Georgia" FontSize="13"
                                                     Margin="0,0,16,0"/>
                                        <RadioButton Content="Rookie"
                                                     IsChecked="{Binding InviteAsRookie}"
                                                     Foreground="{DynamicResource Brush.Foreground}"
                                                     FontFamily="Georgia" FontSize="13"/>
                                    </StackPanel>

                                    <!-- Rookie level note -->
                                    <TextBlock Grid.Row="2"
                                               Text="⚠ Rookie invites are only accepted by characters below level 20."
                                               Visibility="{Binding ShowRookieLevelNote, Converter={StaticResource BoolToVis}}"
                                               Foreground="{DynamicResource Brush.GoldSoft}"
                                               FontFamily="Georgia" FontSize="11" FontStyle="Italic"
                                               Margin="0,0,0,6"/>

                                    <!-- Invite error -->
                                    <TextBlock Grid.Row="3"
                                               Text="{Binding InviteError}"
                                               Visibility="{Binding HasInviteError, Converter={StaticResource BoolToVis}}"
                                               Foreground="{DynamicResource Brush.Error}"
                                               FontFamily="Georgia" FontSize="12"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Tab selector -->
                        <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,12">
                            <Button Content="ROSTER" Command="{Binding SelectRosterTabCommand}"
                                    Margin="0,0,4,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TabBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRosterTab}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Gold}"/>
                                                <Setter Property="BorderThickness" Value="1,1,1,3"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="ROOKIES" Command="{Binding SelectRookiesTabCommand}"
                                    Margin="4,0,4,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TabBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRookiesTab}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Gold}"/>
                                                <Setter Property="BorderThickness" Value="1,1,1,3"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="PROPERTY" Command="{Binding SelectPropertyTabCommand}"
                                    Margin="4,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TabBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPropertyTab}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Gold}"/>
                                                <Setter Property="BorderThickness" Value="1,1,1,3"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </UniformGrid>

                        <!-- Member list -->
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Roster tab -->
                                <ItemsControl ItemsSource="{Binding Members}"
                                              Visibility="{Binding IsRosterTab, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource MemberRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Avatar -->
                                                    <Border Grid.Column="0" Width="34" Height="34"
                                                            Background="{DynamicResource Brush.PanelDark}"
                                                            BorderBrush="{Binding RankBrush}"
                                                            BorderThickness="2" CornerRadius="17">
                                                        <TextBlock Text="{Binding AvatarInitial}"
                                                                   FontFamily="Georgia" FontSize="14"
                                                                   Foreground="{DynamicResource Brush.Foreground}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>

                                                    <!-- Name + rank -->
                                                    <StackPanel Grid.Column="1" Margin="12,0,8,0"
                                                                VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding OnlineDot}"
                                                                       Foreground="{Binding OnlineBrush}"
                                                                       FontSize="10" Margin="0,0,6,0"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontFamily="Georgia" FontSize="14"
                                                                       Foreground="{DynamicResource Brush.Foreground}"
                                                                       FontWeight="Bold"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Rank}"
                                                                   Foreground="{Binding RankBrush}"
                                                                   FontFamily="Georgia" FontSize="11"/>
                                                    </StackPanel>

                                                    <!-- Promote / Demote (officer+) -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                VerticalAlignment="Center" Margin="0,0,6,0"
                                                                Visibility="{Binding DataContext.CanManage,
                                                                    RelativeSource={RelativeSource AncestorType=Page},
                                                                    Converter={StaticResource BoolToVis}}">
                                                        <Button Content="▲" Command="{Binding PromoteCommand}"
                                                                Style="{StaticResource ActionBtn}"
                                                                Width="34" Padding="0"
                                                                Margin="0,0,4,0" ToolTip="Promote"/>
                                                        <Button Content="▼" Command="{Binding DemoteCommand}"
                                                                Style="{StaticResource ActionBtn}"
                                                                Width="34" Padding="0"
                                                                Visibility="{Binding DataContext.IsLeader,
                                                                    RelativeSource={RelativeSource AncestorType=Page},
                                                                    Converter={StaticResource BoolToVis}}"
                                                                ToolTip="Demote"/>
                                                    </StackPanel>

                                                    <!-- Kick (officer+) -->
                                                    <Button Grid.Column="3" Content="KICK"
                                                            Command="{Binding KickCommand}"
                                                            Style="{StaticResource DangerBtn}"
                                                            Visibility="{Binding DataContext.CanManage,
                                                                RelativeSource={RelativeSource AncestorType=Page},
                                                                Converter={StaticResource BoolToVis}}"
                                                            ToolTip="Remove from guild"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Rookies tab -->
                                <ItemsControl ItemsSource="{Binding Rookies}"
                                              Visibility="{Binding IsRookiesTab, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource MemberRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="34" Height="34"
                                                            Background="{DynamicResource Brush.PanelDark}"
                                                            BorderBrush="{DynamicResource Brush.Muted}"
                                                            BorderThickness="2" CornerRadius="17">
                                                        <TextBlock Text="{Binding AvatarInitial}"
                                                                   FontFamily="Georgia" FontSize="14"
                                                                   Foreground="{DynamicResource Brush.Foreground}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="12,0,8,0"
                                                                VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding OnlineDot}"
                                                                       Foreground="{Binding OnlineBrush}"
                                                                       FontSize="10" Margin="0,0,6,0"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontFamily="Georgia" FontSize="14"
                                                                       Foreground="{DynamicResource Brush.Foreground}"
                                                                       FontWeight="Bold"/>
                                                        </StackPanel>
                                                        <TextBlock Text="Rookie"
                                                                   Foreground="{DynamicResource Brush.Muted}"
                                                                   FontFamily="Georgia" FontSize="11"/>
                                                    </StackPanel>

                                                    <!-- Promote to member -->
                                                    <Button Grid.Column="2" Content="PROMOTE"
                                                            Command="{Binding PromoteCommand}"
                                                            Style="{StaticResource ActionBtn}"
                                                            Visibility="{Binding DataContext.CanManage,
                                                                RelativeSource={RelativeSource AncestorType=Page},
                                                                Converter={StaticResource BoolToVis}}"
                                                            Margin="0,0,6,0" ToolTip="Promote to Member"/>

                                                    <!-- Fire rookie -->
                                                    <Button Grid.Column="3" Content="REMOVE"
                                                            Command="{Binding KickCommand}"
                                                            Style="{StaticResource DangerBtn}"
                                                            Visibility="{Binding DataContext.CanManage,
                                                                RelativeSource={RelativeSource AncestorType=Page},
                                                                Converter={StaticResource BoolToVis}}"
                                                            ToolTip="Remove from rookie program"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- ── Property tab - no property ── -->
                                <StackPanel Visibility="{Binding ShowPropertyAcquire, Converter={StaticResource BoolToVis}}"
                                            Margin="0,8,0,0">

                                    <TextBlock Text="Your guild does not own a property."
                                               FontFamily="Georgia" FontSize="13" FontStyle="Italic"
                                               Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,16"/>

                                    <!-- Buy House (leader only) -->
                                    <Border Margin="0,0,0,12"
                                            Background="{DynamicResource Brush.PanelDark}"
                                            BorderBrush="{DynamicResource Brush.Gold}" BorderThickness="1"
                                            CornerRadius="2" Padding="16,12"
                                            Visibility="{Binding IsLeader, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="GUILD HOUSE"
                                                       FontFamily="Georgia" FontSize="12" FontWeight="Bold"
                                                       Foreground="{DynamicResource Brush.GoldSoft}"
                                                       Margin="0,0,0,4"/>
                                            <TextBlock Text="Purchase a house at a city location. Cost scales with the city's prestige level."
                                                       FontFamily="Georgia" FontSize="12"
                                                       Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,10"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="City Room ID"
                                                           FontFamily="Georgia" FontSize="12"
                                                           Foreground="{DynamicResource Brush.Muted}"
                                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBox Text="{Binding BuyHouseIdInput, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource PrimaryInput}"
                                                         Width="110" Height="36"/>
                                                <Button Content="BUY HOUSE"
                                                        Command="{Binding BuyHouseCommand}"
                                                        Style="{StaticResource ActionBtn}" Margin="8,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding BuyHouseError}"
                                                       Visibility="{Binding HasBuyHouseError, Converter={StaticResource BoolToVis}}"
                                                       Foreground="{DynamicResource Brush.Error}"
                                                       FontFamily="Georgia" FontSize="12" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Establish Base (leader only) -->
                                    <Border Background="{DynamicResource Brush.PanelDark}"
                                            BorderBrush="{DynamicResource Brush.Gold}" BorderThickness="1"
                                            CornerRadius="2" Padding="16,12"
                                            Visibility="{Binding IsLeader, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="GUILD BASE"
                                                       FontFamily="Georgia" FontSize="12" FontWeight="Bold"
                                                       Foreground="{DynamicResource Brush.GoldSoft}"
                                                       Margin="0,0,0,4"/>
                                            <TextBlock Text="Claim your current room as the guild's permanent base. Rooms are built using materials."
                                                       FontFamily="Georgia" FontSize="12"
                                                       Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,10"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="Current room:"
                                                           FontFamily="Georgia" FontSize="12"
                                                           Foreground="{DynamicResource Brush.Muted}"
                                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding CurrentRoomLabel}"
                                                           FontFamily="Georgia" FontSize="12" FontWeight="Bold"
                                                           Foreground="{DynamicResource Brush.Foreground}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Button Content="ESTABLISH BASE HERE"
                                                    Command="{Binding EstablishBaseCommand}"
                                                    Style="{StaticResource ActionBtn}" HorizontalAlignment="Left"/>
                                            <TextBlock Text="{Binding EstablishBaseError}"
                                                       Visibility="{Binding HasEstablishBaseError, Converter={StaticResource BoolToVis}}"
                                                       Foreground="{DynamicResource Brush.Error}"
                                                       FontFamily="Georgia" FontSize="12" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Non-leader note -->
                                    <TextBlock Text="Only the guild leader can acquire a property."
                                               FontFamily="Georgia" FontSize="12" FontStyle="Italic"
                                               Foreground="{DynamicResource Brush.Muted}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLeader}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <!-- ── Property tab - property owned ── -->
                                <StackPanel Visibility="{Binding ShowPropertyDetail, Converter={StaticResource BoolToVis}}"
                                            Margin="0,8,0,0">

                                    <!-- Header -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <TextBlock Text="{Binding PropertyType}"
                                                   FontFamily="Georgia" FontSize="15" FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush.Gold}" Margin="0,0,12,0"/>
                                        <TextBlock FontFamily="Georgia" FontSize="12"
                                                   Foreground="{DynamicResource Brush.Muted}"
                                                   VerticalAlignment="Center">
                                            <Run Text="acquired"/>
                                            <Run Text="{Binding PropertyAcquiredAt, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <TextBlock Text="ROOMS"
                                               FontFamily="Georgia" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.GoldSoft}"
                                               Margin="0,0,0,8"/>

                                    <ItemsControl ItemsSource="{Binding PropertyRooms}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource MemberRow}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="70"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding DisplayName}"
                                                                   FontFamily="Georgia" FontSize="13"
                                                                   Foreground="{DynamicResource Brush.Foreground}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1"
                                                                   FontFamily="Georgia" FontSize="11"
                                                                   Foreground="{DynamicResource Brush.Muted}"
                                                                   VerticalAlignment="Center" Margin="16,0">
                                                            <Run Text="{Binding MinRankRequired, Mode=OneWay}"/><Run Text="+"/>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="2"
                                                                   FontFamily="Georgia" FontSize="12"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Right">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text"       Value="Built"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.GoldSoft}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsBuilt}" Value="False">
                                                                            <Setter Property="Text"       Value="Planned"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- Danger zone -->
                        <Border Grid.Row="4"
                                BorderBrush="{DynamicResource Brush.Error}" BorderThickness="1"
                                CornerRadius="2" Padding="14,10" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           FontFamily="Georgia" FontSize="12"
                                           Foreground="{DynamicResource Brush.Muted}"
                                           VerticalAlignment="Center">
                                    <Run Text="Danger zone · "/>
                                    <Run Text="{Binding GuildName}"/>
                                </TextBlock>

                                <!-- Leave (non-leader) -->
                                <Button Grid.Column="1"
                                        Content="LEAVE GUILD"
                                        Command="{Binding LeaveGuildCommand}"
                                        Margin="0,0,8,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource DangerBtn}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLeader}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Disband (leader only) -->
                                <Button Grid.Column="2"
                                        Content="DISBAND GUILD"
                                        Command="{Binding DisbandGuildCommand}"
                                        Style="{StaticResource DangerBtn}"
                                        Visibility="{Binding IsLeader, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Border>
                    </Grid>

                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
