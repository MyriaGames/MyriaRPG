<Page x:Class="Myria.Wpf.View.Pages.Game.IngameWindow.Page_LocalMap"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:Myria.Wpf.View.UserControls"
      mc:Ignorable="d"
      Title="Map">

    <!-- ZoomButton/MapHeaderButton were page-local near-duplicates of the shared IconButton/
         GoldButtonBase styles (AR4 consolidation) - removed, usages below now reuse those. -->


    <Grid Background="{DynamicResource Brush.WindowBackgroundGradient}">

        <!-- Decorative watermark -->
        <TextBlock Text="⊕"
                   FontSize="220"
                   Foreground="{DynamicResource Brush.Panel}"
                   Opacity="0.35"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="0,0,40,0"/>

        <!-- Outer gold-bordered container -->
        <Border Margin="10"
                BorderBrush="{DynamicResource Brush.Gold}"
                BorderThickness="1">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ── HEADER ──────────────────────────────────────────── -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                        <TextBlock Text="→"
                                   Foreground="{DynamicResource Brush.Gold}"
                                   FontSize="34"
                                   Margin="0,4,14,0"/>
                        <TextBlock Text="{Binding MapTitle}"
                                   Style="{StaticResource HeaderText}"/>
                        <TextBlock Text=" | Navigate the world around you."
                                   Foreground="{DynamicResource Brush.GoldSoft}"
                                   FontFamily="{StaticResource Font.Body}"
                                   FontStyle="Italic"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="18,6,0,0"/>
                    </StackPanel>

                    <!-- Map controls -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Top"
                                Margin="0,10,0,0">
                        <Button Content="Back"
                                MinWidth="76" Height="36" Padding="12,0"
                                Foreground="{DynamicResource Brush.GoldSoft}"
                                Background="{DynamicResource Brush.PanelDark}"
                                BorderBrush="{DynamicResource Brush.Gold}"
                                FontSize="13" FontWeight="Bold"
                                Command="{Binding BackMapCommand}"
                                ToolTip="Back to previous map">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GoldButtonBase}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.BlueActive}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="World"
                                MinWidth="76" Height="36" Padding="12,0"
                                Foreground="{DynamicResource Brush.GoldSoft}"
                                Background="{DynamicResource Brush.PanelDark}"
                                BorderBrush="{DynamicResource Brush.Gold}"
                                FontSize="13" FontWeight="Bold"
                                Margin="6,0,12,0"
                                Command="{Binding WorldMapCommand}"
                                ToolTip="Show world map">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GoldButtonBase}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.BlueActive}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="BtnZoomIn"
                                Content="＋"
                                Style="{StaticResource IconButton}"
                                FontSize="18" FontWeight="Bold"
                                Click="BtnZoomIn_Click"
                                ToolTip="Zoom in"/>
                        <Button x:Name="BtnZoomOut"
                                Content="－"
                                Style="{StaticResource IconButton}"
                                FontSize="18" FontWeight="Bold"
                                Margin="6,0,0,0"
                                Click="BtnZoomOut_Click"
                                ToolTip="Zoom out"/>
                    </StackPanel>

                    <Rectangle Grid.ColumnSpan="2"
                               Height="1"
                               Fill="{DynamicResource Brush.Gold}"
                               VerticalAlignment="Bottom"
                               Opacity="0.55"/>
                </Grid>

                <!-- ── MAP CANVAS ─────────────────────────────────────── -->
                <Border Grid.Row="1"
                        BorderBrush="{DynamicResource Brush.Gold}"
                        BorderThickness="1"
                        CornerRadius="2"
                        Margin="0,14,0,0">
                    <controls:LocalMapControl x:Name="MapControl"
                                              Nodes="{Binding Nodes}"
                                              Edges="{Binding Edges}"
                                              GroupNodeClickedCommand="{Binding GroupNodeClickCommand}"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
