<Page x:Class="Myria.Wpf.View.Pages.Game.IngameWindow.Page_LocalMap"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:Myria.Wpf.View.UserControls"
      mc:Ignorable="d"
      Title="Map">

    <Page.Resources>
        <Style x:Key="ZoomButton" TargetType="Button">
            <Setter Property="Width"           Value="36"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Foreground"      Value="{DynamicResource Brush.GoldSoft}"/>
            <Setter Property="Background"      Value="{DynamicResource Brush.PanelDark}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily"      Value="Georgia"/>
            <Setter Property="FontSize"        Value="18"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BlueActive}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MapHeaderButton" TargetType="Button">
            <Setter Property="MinWidth"         Value="76"/>
            <Setter Property="Height"           Value="36"/>
            <Setter Property="Padding"          Value="12,0"/>
            <Setter Property="Foreground"       Value="{DynamicResource Brush.GoldSoft}"/>
            <Setter Property="Background"       Value="{DynamicResource Brush.PanelDark}"/>
            <Setter Property="BorderBrush"      Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="FontFamily"       Value="Georgia"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="FontWeight"       Value="Bold"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BlueActive}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="{DynamicResource Brush.WindowBackgroundGradient}">

        <!-- Decorative watermark -->
        <TextBlock Text="⊕"
                   FontSize="220"
                   Foreground="{DynamicResource Brush.Panel}"
                   Opacity="0.35"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="0,0,40,0"/>

        <!-- Outer gold-bordered container -->
        <Border Margin="10"
                BorderBrush="{DynamicResource Brush.Gold}"
                BorderThickness="1">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ── HEADER ──────────────────────────────────────────── -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                        <TextBlock Text="→"
                                   Foreground="{DynamicResource Brush.Gold}"
                                   FontSize="34"
                                   Margin="0,4,14,0"/>
                        <TextBlock Text="{Binding MapTitle}"
                                   Style="{StaticResource HeaderText}"/>
                        <TextBlock Text=" | Navigate the world around you."
                                   Foreground="{DynamicResource Brush.GoldSoft}"
                                   FontFamily="Georgia"
                                   FontStyle="Italic"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="18,6,0,0"/>
                    </StackPanel>

                    <!-- Map controls -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Top"
                                Margin="0,10,0,0">
                        <Button Content="Back"
                                Style="{StaticResource MapHeaderButton}"
                                Command="{Binding BackMapCommand}"
                                ToolTip="Back to previous map"/>
                        <Button Content="World"
                                Style="{StaticResource MapHeaderButton}"
                                Margin="6,0,12,0"
                                Command="{Binding WorldMapCommand}"
                                ToolTip="Show world map"/>
                        <Button x:Name="BtnZoomIn"
                                Content="＋"
                                Style="{StaticResource ZoomButton}"
                                Click="BtnZoomIn_Click"
                                ToolTip="Zoom in"/>
                        <Button x:Name="BtnZoomOut"
                                Content="－"
                                Style="{StaticResource ZoomButton}"
                                Margin="6,0,0,0"
                                Click="BtnZoomOut_Click"
                                ToolTip="Zoom out"/>
                    </StackPanel>

                    <Rectangle Grid.ColumnSpan="2"
                               Height="1"
                               Fill="{DynamicResource Brush.Gold}"
                               VerticalAlignment="Bottom"
                               Opacity="0.55"/>
                </Grid>

                <!-- ── MAP CANVAS ─────────────────────────────────────── -->
                <Border Grid.Row="1"
                        BorderBrush="{DynamicResource Brush.Gold}"
                        BorderThickness="1"
                        CornerRadius="2"
                        Margin="0,14,0,0">
                    <controls:LocalMapControl x:Name="MapControl"
                                              Nodes="{Binding Nodes}"
                                              Edges="{Binding Edges}"
                                              GroupNodeClickedCommand="{Binding GroupNodeClickCommand}"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
