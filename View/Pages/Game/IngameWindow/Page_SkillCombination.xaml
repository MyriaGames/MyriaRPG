<Page x:Class="Myria.Wpf.View.Pages.Game.IngameWindow.Page_SkillCombination"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="900"
      Title="Skill Combination">

    <Page.Resources>

        <!-- Tab-style button (Back) -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Height"          Value="38"/>
            <Setter Property="Foreground"      Value="{DynamicResource Brush.Muted}"/>
            <Setter Property="Background"      Value="{DynamicResource Brush.PanelDark}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily"      Value="Georgia"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.NavHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary action button (Combine) -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height"          Value="46"/>
            <Setter Property="Foreground"      Value="{DynamicResource Brush.GoldSoft}"/>
            <Setter Property="Background"      Value="{DynamicResource Brush.BlueActive}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily"      Value="Georgia"/>
            <Setter Property="FontSize"        Value="15"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.NavHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource Brush.PanelDark}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost button (Add to Slot, ✕ remove) -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground"      Value="{DynamicResource Brush.Muted}"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily"      Value="Georgia"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource Brush.NavHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid MinWidth="600" MinHeight="360" Background="{DynamicResource Brush.WindowBackgroundGradient}">

        <!-- Decorative watermark -->
        <TextBlock Text="✦"
                   FontSize="220"
                   Foreground="{DynamicResource Brush.Panel}"
                   Opacity="0.4"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="0,10,40,0"/>

        <!-- Outer gold-bordered container -->
        <Border Margin="10"
                BorderBrush="{DynamicResource Brush.Gold}"
                BorderThickness="1">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ── HEADER ────────────────────────────────────────────── -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                        <TextBlock Text="→"
                                   Foreground="{DynamicResource Brush.Gold}"
                                   FontSize="34"
                                   Margin="0,4,14,0"/>
                        <TextBlock Text="{Binding TblTitle}"
                                   Style="{StaticResource HeaderText}"/>
                        <TextBlock Text=" | Forge new power from existing skills."
                                   Foreground="{DynamicResource Brush.GoldSoft}"
                                   FontFamily="Georgia"
                                   FontStyle="Italic"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="18,6,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="{Binding TblBack}"
                            Command="{Binding GoBackCommand}"
                            Style="{StaticResource TabButton}"
                            VerticalAlignment="Center"
                            Padding="16,0"
                            Margin="0,0,0,10"/>

                    <Rectangle Grid.ColumnSpan="2"
                               Height="1"
                               Fill="{DynamicResource Brush.Gold}"
                               VerticalAlignment="Bottom"
                               Opacity="0.55"/>
                </Grid>

                <!-- ── BODY ──────────────────────────────────────────────── -->
                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ╔══ LEFT: available skills ══════════════════════════╗ -->
                    <Border Grid.Column="0" Style="{StaticResource GoldBorder}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="{Binding TblAvailable}"
                                       Style="{StaticResource SectionTitle}"
                                       Margin="0,0,0,10"/>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding AvailableSkills}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Brush.Border}"
                                                    BorderThickness="1"
                                                    Background="{DynamicResource Brush.PanelDark}"
                                                    Padding="10,8"
                                                    Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="✦"
                                                               Foreground="{DynamicResource Brush.Gold}"
                                                               FontSize="16"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"/>

                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Foreground="{DynamicResource Brush.Foreground}"
                                                                   FontFamily="Georgia"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding ShortDescription}"
                                                                   Style="{StaticResource MutedText}"
                                                                   FontSize="11"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,3,0,6"/>
                                                        <Button Content="{Binding DataContext.TblAddToSlot, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                Command="{Binding DataContext.AddToInputCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                IsEnabled="{Binding DataContext.CanAddMore, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                Style="{StaticResource GhostButton}"
                                                                Height="26" Padding="10,0"
                                                                HorizontalAlignment="Left"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- ╔══ CENTER: input slots + combine ══════════════════╗ -->
                    <Border Grid.Column="2" Style="{StaticResource GoldBorder}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="{Binding TblInputSlots}"
                                       Style="{StaticResource SectionTitle}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,10"/>

                            <!-- Input slot cards -->
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding InputSlots}"
                                          VerticalAlignment="Center">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="SlotBorder"
                                                BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="1"
                                                Background="{DynamicResource Brush.PanelDark}"
                                                Padding="10,8"
                                                Margin="0,0,0,6"
                                                MinHeight="38">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock x:Name="SlotLabel"
                                                           Grid.Column="0"
                                                           Text="{Binding Label}"
                                                           Style="{StaticResource MutedText}"
                                                           FontFamily="Georgia"
                                                           FontSize="13"
                                                           FontStyle="Italic"
                                                           VerticalAlignment="Center"/>

                                                <Button Grid.Column="1"
                                                        Content="✕"
                                                        Command="{Binding DataContext.RemoveInputCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource GhostButton}"
                                                        Height="24" Width="28" Padding="0"
                                                        Visibility="{Binding IsSet, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSet}" Value="True">
                                                <Setter TargetName="SlotBorder" Property="BorderBrush"
                                                        Value="{DynamicResource Brush.Gold}"/>
                                                <Setter TargetName="SlotBorder" Property="Background"
                                                        Value="{DynamicResource Brush.BlueActive}"/>
                                                <Setter TargetName="SlotLabel" Property="FontStyle"
                                                        Value="Normal"/>
                                                <Setter TargetName="SlotLabel" Property="Foreground"
                                                        Value="{DynamicResource Brush.Foreground}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Count + Combine + Status -->
                            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                <TextBlock Text="{Binding InputCountText}"
                                           Style="{StaticResource MutedText}"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,10"/>

                                <Button Content="{Binding TblCombine}"
                                        Command="{Binding CombineCommand}"
                                        IsEnabled="{Binding CanCombine}"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Stretch"/>

                                <TextBlock Text="{Binding StatusText}"
                                           Foreground="{DynamicResource Brush.GoldSoft}"
                                           FontFamily="Georgia"
                                           FontStyle="Italic"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0"
                                           Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ╔══ RIGHT: created combinations ═════════════════════╗ -->
                    <Border Grid.Column="4" Style="{StaticResource GoldBorder}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="{Binding TblCreated}"
                                       Style="{StaticResource SectionTitle}"
                                       Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="1"
                                       Text="{Binding HeaderText}"
                                       Style="{StaticResource MutedText}"
                                       FontSize="11"
                                       Margin="0,0,0,10"/>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding CombinedSkills}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Brush.Border}"
                                                    BorderThickness="1"
                                                    Background="{DynamicResource Brush.PanelDark}"
                                                    Padding="10,8"
                                                    Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="✦"
                                                               Foreground="{DynamicResource Brush.Accent}"
                                                               FontSize="16"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"/>

                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   Foreground="{DynamicResource Brush.Foreground}"
                                                                   FontFamily="Georgia"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding ComponentsText}"
                                                                   Style="{StaticResource MutedText}"
                                                                   FontSize="11"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
