<Page x:Class="Myria.Wpf.View.Pages.Game.IngameWindow.Inventory.Inventory"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="520" d:DesignWidth="800"
      Background="Transparent"
      Title="Inventory">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="InventorySlotStyle" TargetType="Border">
            <Setter Property="Background"    Value="{DynamicResource Brush.PanelDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"       Value="2"/>
            <Setter Property="AllowDrop"     Value="True"/>
            <Setter Property="Margin"        Value="2"/>
            <Setter Property="CornerRadius"  Value="2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.BlueActive}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Page.Resources>

    <Grid>
        <Border Background="{DynamicResource Brush.HudBodyGradient}"
                BorderBrush="{DynamicResource Brush.Gold}"
                BorderThickness="1"
                CornerRadius="2"
                Padding="14,10,14,12"
                Effect="{StaticResource Effect.PanelShadow}">
            <StackPanel>

                <!-- Section header -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding InventoryTitle}"
                               FontFamily="Georgia"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Brush.GoldSoft}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <Rectangle Grid.Column="1"
                               Height="1"
                               Fill="{DynamicResource Brush.Gold}"
                               Opacity="0.3"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Class restriction notification -->
                <Border Visibility="{Binding IsNotificationVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="{DynamicResource Brush.PanelDark}"
                        BorderBrush="{DynamicResource Brush.Error}"
                        BorderThickness="1"
                        CornerRadius="2"
                        Padding="10,8"
                        Margin="0,0,0,8">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="✕"
                                Command="{Binding DismissNotificationCommand}"
                                Foreground="{DynamicResource Brush.GoldSoft}"
                                Background="Transparent" BorderThickness="0"
                                FontSize="12" Cursor="Hand" Margin="8,0,0,0"
                                VerticalAlignment="Center" Style="{x:Null}"/>
                        <TextBlock DockPanel.Dock="Left" Text="&#x26A0;"
                                   Foreground="{DynamicResource Brush.Error}"
                                   FontFamily="Segoe UI Symbol" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding NotificationMessage}"
                                   Foreground="{DynamicResource Brush.Foreground}"
                                   FontFamily="Georgia" FontSize="11"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- Item grid -->
                <ItemsControl ItemsSource="{Binding InventoryItems}" x:Name="InventoryItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="64"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="64"/>
                                    <RowDefinition Height="64"/>
                                    <RowDefinition Height="64"/>
                                    <RowDefinition Height="64"/>
                                    <RowDefinition Height="64"/>
                                    <RowDefinition Height="64"/>
                                    <RowDefinition Height="64"/>
                                </Grid.RowDefinitions>
                            </Grid>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Grid.Column" Value="{Binding GridColumn}"/>
                            <Setter Property="Grid.Row"    Value="{Binding GridRow}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource InventorySlotStyle}"
                                    BorderBrush="{Binding RarityBrush}"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    AllowDrop="True"
                                    Drop="InventorySlot_Drop"
                                    DragOver="InventorySlot_DragOver"
                                    PreviewMouseLeftButtonDown="InventorySlot_PreviewMouseLeftButtonDown"
                                    MouseEnter="InventorySlot_MouseEnter"
                                    MouseLeave="InventorySlot_MouseLeave">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{Binding PlacementTarget.Tag.LblEquip, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  Command="{Binding PlacementTarget.Tag.EquipItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  Visibility="{Binding PlacementTarget.DataContext.IsEquipment, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <MenuItem Header="{Binding PlacementTarget.Tag.LblUse, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  Command="{Binding PlacementTarget.Tag.UseItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  Visibility="{Binding PlacementTarget.DataContext.IsConsumable, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid Background="Transparent">
                                    <ContentControl Content="{Binding Item}"
                                                    Style="{StaticResource IconSwitcherStyle}"
                                                    Margin="2"/>
                                    <!-- Stack count badge -->
                                    <Border Background="#AA030506"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            CornerRadius="2"
                                            Margin="0,0,3,3"
                                            Padding="3,1">
                                        <TextBlock Text="{Binding Item.StackSize}"
                                                   Foreground="{DynamicResource Brush.GoldSoft}"
                                                   FontFamily="Georgia"
                                                   FontSize="10"
                                                   FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </Border>

        <!-- Tooltip -->
        <Popup x:Name="ItemTooltipPopup"
               IsOpen="{Binding IsTooltipVisible}"
               Placement="Custom"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               StaysOpen="True"
               IsHitTestVisible="False">
            <Border Background="{DynamicResource Brush.HudBodyGradient}"
                    BorderBrush="{DynamicResource Brush.Gold}"
                    BorderThickness="1"
                    CornerRadius="2"
                    Padding="12,10"
                    MaxWidth="260"
                    Effect="{StaticResource Effect.HudShadow}">
                <StackPanel DataContext="{Binding CurrentTooltip}">
                    <TextBlock Text="{Binding ItemName}"
                               FontFamily="Georgia" FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Foreground}"
                               TextWrapping="Wrap" Margin="0,0,0,3"/>
                    <TextBlock Text="{Binding ItemRarity}"
                               FontFamily="Georgia" FontSize="10" FontWeight="Bold"
                               Foreground="{Binding RarityColor}" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding ItemType}"
                               FontFamily="Georgia" FontSize="10"
                               Foreground="{DynamicResource Brush.GoldSoft}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding ClassText}"
                               Visibility="{Binding HasClassInfo, Converter={StaticResource BoolToVisibilityConverter}}"
                               Foreground="{Binding ClassColor}"
                               FontFamily="Georgia" FontSize="10"
                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <Rectangle Height="1" Fill="{DynamicResource Brush.Gold}" Opacity="0.3" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding ItemStats}"
                               FontFamily="Georgia" FontSize="10"
                               Foreground="{DynamicResource Brush.Foreground}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Page>
