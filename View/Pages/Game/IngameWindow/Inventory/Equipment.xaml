<Page x:Class="Myria.Wpf.View.Pages.Game.IngameWindow.Inventory.Equipment"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="160" d:DesignWidth="800"
      Background="Transparent"
      Title="Equipment">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="EquipmentSlotStyle" TargetType="ContentControl">
            <Setter Property="Width"  Value="80"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border x:Name="SlotBd"
                                Background="{DynamicResource Brush.PanelDark}"
                                BorderBrush="{DynamicResource Brush.Gold}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Effect="{StaticResource Effect.HudShadow}">
                            <Grid>
                                <TextBlock x:Name="HintLbl"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="{DynamicResource Brush.GoldSoft}"
                                           FontFamily="Georgia"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Opacity="0.45"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="4"/>
                                <ContentPresenter/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SlotBd" Property="Background" Value="{DynamicResource Brush.BlueActive}"/>
                                <Setter TargetName="SlotBd" Property="BorderBrush" Value="{DynamicResource Brush.GoldSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid>
        <Border Background="{DynamicResource Brush.HudBodyGradient}"
                BorderBrush="{DynamicResource Brush.Gold}"
                BorderThickness="1"
                CornerRadius="2"
                Padding="14,10,14,12"
                Effect="{StaticResource Effect.PanelShadow}">
            <StackPanel>

                <!-- Section header -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding EquipmentTitle}"
                               FontFamily="Georgia"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Brush.GoldSoft}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <Rectangle Grid.Column="1"
                               Height="1"
                               Fill="{DynamicResource Brush.Gold}"
                               Opacity="0.3"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Class restriction notification -->
                <Border Visibility="{Binding IsNotificationVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="{DynamicResource Brush.PanelDark}"
                        BorderBrush="{DynamicResource Brush.Error}"
                        BorderThickness="1"
                        CornerRadius="2"
                        Padding="10,8"
                        Margin="0,0,0,8">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="✕"
                                Command="{Binding DismissNotificationCommand}"
                                Foreground="{DynamicResource Brush.GoldSoft}"
                                Background="Transparent" BorderThickness="0"
                                FontSize="12" Cursor="Hand" Margin="8,0,0,0"
                                VerticalAlignment="Center" Style="{x:Null}"/>
                        <TextBlock DockPanel.Dock="Left" Text="&#x26A0;"
                                   Foreground="{DynamicResource Brush.Error}"
                                   FontFamily="Segoe UI Symbol" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding NotificationMessage}"
                                   Foreground="{DynamicResource Brush.Foreground}"
                                   FontFamily="Georgia" FontSize="11"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- Equipment slots -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ContentControl x:Name="WeaponSlot"
                           Style="{StaticResource EquipmentSlotStyle}"
                           DataContext="{Binding WeaponSlot}"
                           Tag="{Binding DataContext.WeaponHint, RelativeSource={RelativeSource AncestorType=Page}}"
                           AllowDrop="True"
                           Drop="EquipmentSlot_Drop"
                           DragOver="EquipmentSlot_DragOver"
                           PreviewMouseLeftButtonDown="EquipmentSlot_PreviewMouseLeftButtonDown"
                           PreviewMouseRightButtonDown="EquipmentSlot_PreviewMouseRightButtonDown"
                           MouseEnter="EquipmentSlot_MouseEnter"
                           MouseLeave="EquipmentSlot_MouseLeave">
                        <Border BorderBrush="{Binding BorderColor}" BorderThickness="2" CornerRadius="3">
                            <ContentControl Content="{Binding Item}" Style="{StaticResource IconSwitcherStyle}"/>
                        </Border>
                    </ContentControl>

                    <ContentControl x:Name="ArmorSlot"
                           Style="{StaticResource EquipmentSlotStyle}"
                           DataContext="{Binding ArmorSlot}"
                           Tag="{Binding DataContext.ArmorHint, RelativeSource={RelativeSource AncestorType=Page}}"
                           AllowDrop="True"
                           Drop="EquipmentSlot_Drop"
                           DragOver="EquipmentSlot_DragOver"
                           PreviewMouseLeftButtonDown="EquipmentSlot_PreviewMouseLeftButtonDown"
                           PreviewMouseRightButtonDown="EquipmentSlot_PreviewMouseRightButtonDown"
                           MouseEnter="EquipmentSlot_MouseEnter"
                           MouseLeave="EquipmentSlot_MouseLeave">
                        <Border BorderBrush="{Binding BorderColor}" BorderThickness="2" CornerRadius="3">
                            <ContentControl Content="{Binding Item}" Style="{StaticResource IconSwitcherStyle}"/>
                        </Border>
                    </ContentControl>

                    <ContentControl x:Name="AccessorySlot"
                           Style="{StaticResource EquipmentSlotStyle}"
                           DataContext="{Binding AccessorySlot}"
                           Tag="{Binding DataContext.AccessoryHint, RelativeSource={RelativeSource AncestorType=Page}}"
                           AllowDrop="True"
                           Drop="EquipmentSlot_Drop"
                           DragOver="EquipmentSlot_DragOver"
                           PreviewMouseLeftButtonDown="EquipmentSlot_PreviewMouseLeftButtonDown"
                           PreviewMouseRightButtonDown="EquipmentSlot_PreviewMouseRightButtonDown"
                           MouseEnter="EquipmentSlot_MouseEnter"
                           MouseLeave="EquipmentSlot_MouseLeave">
                        <Border BorderBrush="{Binding BorderColor}" BorderThickness="2" CornerRadius="3">
                            <ContentControl Content="{Binding Item}" Style="{StaticResource IconSwitcherStyle}"/>
                        </Border>
                    </ContentControl>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- Tooltip -->
        <Popup x:Name="ItemTooltipPopup"
               IsOpen="{Binding IsTooltipVisible}"
               Placement="Custom"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               StaysOpen="True"
               IsHitTestVisible="False">
            <Border Background="{DynamicResource Brush.HudBodyGradient}"
                    BorderBrush="{DynamicResource Brush.Gold}"
                    BorderThickness="1"
                    CornerRadius="2"
                    Padding="12,10"
                    MaxWidth="260"
                    Effect="{StaticResource Effect.HudShadow}">
                <StackPanel DataContext="{Binding CurrentTooltip}">
                    <TextBlock Text="{Binding ItemName}"
                               FontFamily="Georgia" FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Foreground}"
                               TextWrapping="Wrap" Margin="0,0,0,3"/>
                    <TextBlock Text="{Binding ItemRarity}"
                               FontFamily="Georgia" FontSize="10" FontWeight="Bold"
                               Foreground="{Binding RarityColor}" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding ItemType}"
                               FontFamily="Georgia" FontSize="10"
                               Foreground="{DynamicResource Brush.GoldSoft}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding ClassText}"
                               Visibility="{Binding HasClassInfo, Converter={StaticResource BoolToVisibilityConverter}}"
                               Foreground="{Binding ClassColor}"
                               FontFamily="Georgia" FontSize="10"
                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <Rectangle Height="1" Fill="{DynamicResource Brush.Gold}" Opacity="0.3" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding ItemStats}"
                               FontFamily="Georgia" FontSize="10"
                               Foreground="{DynamicResource Brush.Foreground}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Page>
