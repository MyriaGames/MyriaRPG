<Page x:Class="Myria.Wpf.View.Pages.Game.IngameWindow.Page_QuestList"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:conv="clr-namespace:Myria.Wpf.View.Converters"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="900"
      Title="Quests"
>

    <Page.Resources>

        <!-- Tab button (uses regular Button; active state via DataTrigger) -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Height"          Value="46"/>
            <Setter Property="Foreground"      Value="{DynamicResource Brush.Muted}"/>
            <Setter Property="Background"      Value="{DynamicResource Brush.PanelDark}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily"      Value="Georgia"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.NavHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary action button (TRACK QUEST) -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height"          Value="52"/>
            <Setter Property="Foreground"      Value="{DynamicResource Brush.GoldSoft}"/>
            <Setter Property="Background"      Value="{DynamicResource Brush.BlueActive}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily"      Value="Georgia"/>
            <Setter Property="FontSize"        Value="16"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.NavHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.PanelDark}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="QuestButton" TargetType="Button">
            <Setter Property="Height"          Value="10"/>
            <Setter Property="Foreground"      Value="{DynamicResource Brush.GoldSoft}"/>
            <Setter Property="Background"      Value="{DynamicResource Brush.BlueActive}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily"      Value="Georgia"/>
            <Setter Property="FontSize"        Value="16"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.NavHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.PanelDark}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost / secondary button (Abandon) -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Height"          Value="30"/>
            <Setter Property="Foreground"      Value="{DynamicResource Brush.Muted}"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily"      Value="Georgia"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.NavHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBoxItem: removes default WPF selection chrome entirely -->
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding"          Value="0"/>
            <Setter Property="Margin"           Value="0"/>
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <conv:TruncateAtWordConverter x:Key="TruncateAtWord"/>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </Page.Resources>

    <Grid MinWidth="560" MinHeight="360" Background="{DynamicResource Brush.WindowBackgroundGradient}">

        <!-- Decorative watermark -->
        <TextBlock Text="♜"
                   FontSize="200"
                   Foreground="{DynamicResource Brush.Panel}"
                   Opacity="0.4"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="0,10,50,0"/>

        <!-- Outer gold-bordered container -->
        <Border Margin="10"
                BorderBrush="{DynamicResource Brush.Gold}"
                BorderThickness="1">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ── HEADER ──────────────────────────────────────────── -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                        <TextBlock Text="→"
                                   Foreground="{DynamicResource Brush.Gold}"
                                   FontSize="34"
                                   Margin="0,4,14,0"/>
                        <TextBlock Text="{Binding TblTitle}"
                                   Style="{StaticResource HeaderText}"/>
                        <TextBlock Text=" | Every journey begins with a purpose."
                                   Foreground="{DynamicResource Brush.GoldSoft}"
                                   FontFamily="Georgia"
                                   FontStyle="Italic"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="18,6,0,0"/>
                    </StackPanel>

                    <Rectangle Grid.ColumnSpan="2"
                               Height="1"
                               Fill="{DynamicResource Brush.Gold}"
                               VerticalAlignment="Bottom"
                               Opacity="0.55"/>
                </Grid>

                <!-- ── BODY ────────────────────────────────────────────── -->
                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*" MinWidth="220"/>
                    </Grid.ColumnDefinitions>

                    <!-- ╔══ QUEST LIST ══════════════════════════════════╗ -->
                    <Border Grid.Column="0" Style="{StaticResource GoldBorder}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Tab row -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <!-- Active tab -->
                                <Button Grid.Column="0"
                                        Content="{Binding ActiveCountLabel}"
                                        Command="{Binding SelectActiveTabCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowActive}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.BlueActive}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.GoldSoft}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Available tab -->
                                <Button Grid.Column="2"
                                        Content="{Binding AvailableCountLabel}"
                                        Command="{Binding SelectAvailableTabCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowAvailable}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.BlueActive}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.GoldSoft}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>

                            <!-- Quest items -->
                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          Margin="0,0,0,10">
                                <Grid>
                                    <ListBox ItemsSource="{Binding Quests}"
                                             SelectedItem="{Binding SelectedQuest, Mode=TwoWay}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             VirtualizingPanel.IsVirtualizing="False"
                                             Visibility="{Binding QuestListVisibility}">

                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="CardBorder"
                                                        BorderBrush="{DynamicResource Brush.Border}"
                                                        BorderThickness="1"
                                                        Background="{DynamicResource Brush.PanelDark}"
                                                        Padding="12" Margin="0,0,0,8"
                                                        Cursor="Hand">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="42"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="54"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Quest-type icon (colored by status) -->
                                                        <TextBlock Grid.Column="0"
                                                                   Text="◇"
                                                                   Foreground="{Binding AccentBrush}"
                                                                   FontSize="24"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Center"/>

                                                        <!-- Title + subtitle -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}"
                                                                       Style="{StaticResource BodyText}"
                                                                       FontSize="15"
                                                                       FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding SubtitleText}"
                                                                       Style="{StaticResource MutedText}"
                                                                       FontSize="12"
                                                                       Margin="0,4,0,0"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>

                                                        <!-- Level -->
                                                        <StackPanel Grid.Column="2"
                                                                    VerticalAlignment="Center"
                                                                    HorizontalAlignment="Right">
                                                            <TextBlock Foreground="{DynamicResource Brush.GoldSoft}"
                                                                       FontFamily="Georgia"
                                                                       FontSize="13"
                                                                       HorizontalAlignment="Right">
                                                                <Run Text="Lv. "/>
                                                                <Run Text="{Binding Level}"/>
                                                            </TextBlock>
                                                            <!-- DONE / ↻ badge -->
                                                            <TextBlock Text="{Binding StatusBadge}"
                                                                       Foreground="{DynamicResource Brush.Success}"
                                                                       FontFamily="Georgia"
                                                                       FontSize="11"
                                                                       HorizontalAlignment="Right"
                                                                       Margin="0,3,0,0"
                                                                       Visibility="{Binding HasStatusBadge, Converter={StaticResource BoolVis}}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter TargetName="CardBorder" Property="Background"    Value="{DynamicResource Brush.BlueActive}"/>
                                                        <Setter TargetName="CardBorder" Property="BorderBrush"   Value="{DynamicResource Brush.Gold}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource Brush.NavHover}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- Empty state -->
                                    <TextBlock Text="{Binding EmptyStateText}"
                                               Visibility="{Binding EmptyStateVisibility}"
                                               Style="{StaticResource MutedText}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               Margin="16"/>
                                </Grid>
                            </ScrollViewer>

                            <!-- Sort / footer button -->
                            <Button Grid.Row="2"
                                    HorizontalAlignment="Left"
                                    Width="160"
                                    Style="{StaticResource GhostButton}"
                                    Height="38"
                                    FontSize="12"
                                    Content="SORT: RECENT  ▾"/>
                        </Grid>
                    </Border>

                    <!-- ╔══ QUEST DETAILS ════════════════════════════════╗ -->
                    <Border Grid.Column="2" Style="{StaticResource GoldBorder}" Padding="15">
                        <Grid>

                            <!-- No-selection hint -->
                            <TextBlock Text="{Binding TblInfo}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontStyle="Italic">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSelected}" Value="Visible">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Detail view -->
                            <Grid Visibility="{Binding HasSelected}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="30"/>
                                </Grid.RowDefinitions>

                                <!-- Hero summary block -->
                                <Border Grid.Row="0"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="1"
                                        Background="{DynamicResource Brush.PanelDark}"
                                        Padding="16,14"
                                        Margin="0,0,0,14">
                                    <Grid>
                                        <!-- Faint watermark behind the text -->
                                        <TextBlock Text="♜"
                                                   FontSize="88"
                                                   Foreground="{DynamicResource Brush.Panel}"
                                                   Opacity="0.5"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>

                                        <StackPanel>
                                            <!-- Quest label -->
                                            <TextBlock Text="QUEST"
                                                       Style="{StaticResource MutedText}"
                                                       FontSize="11"/>

                                            <!-- Title + Level -->
                                            <DockPanel Margin="0,6,0,0">
                                                <TextBlock DockPanel.Dock="Right"
                                                           Foreground="{DynamicResource Brush.GoldSoft}"
                                                           FontFamily="Georgia"
                                                           FontSize="14"
                                                           Margin="14,6,0,0"
                                                           VerticalAlignment="Top">
                                                    <Run Text="Lv. "/>
                                                    <Run Text="{Binding SelectedQuest.Level}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding SelectedQuest.Title}"
                                                           Foreground="{DynamicResource Brush.Foreground}"
                                                           FontFamily="Georgia"
                                                           FontSize="22"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"/>
                                            </DockPanel>

                                            <!-- Area / subtitle -->
                                            <TextBlock Foreground="{DynamicResource Brush.GoldSoft}"
                                                       FontFamily="Georgia"
                                                       FontSize="14"
                                                       Margin="0,6,0,10">
                                                <Run Text="{Binding SelectedQuest.AreaName}"/>
                                            </TextBlock>

                                            <Rectangle Height="1" Fill="{DynamicResource Brush.Gold}" Opacity="0.45" Margin="0,0,0,10"/>

                                            <!-- Description preview -->
                                            <TextBlock Text="{Binding SelectedQuest.Description, Converter={StaticResource TruncateAtWord}}"
                                                       Style="{StaticResource BodyText}"
                                                       FontSize="13"
                                                       LineHeight="22"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Objectives + Rewards (scrollable) -->
                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              Margin="0,0,0,14">
                                    <StackPanel>

                                        <!-- Objectives section -->
                                        <Border BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="1"
                                                Background="{DynamicResource Brush.PanelDark}"
                                                Padding="14"
                                                Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="{Binding TblObjectives}"
                                                           Style="{StaticResource SectionTitle}"
                                                           Margin="0,0,0,10"/>
                                                <ItemsControl ItemsSource="{Binding SelectedQuest.Objectives}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Margin="0,0,0,8"
                                                                       Style="{StaticResource BodyText}"
                                                                       FontSize="14">
                                                                <Run Text="◇  " Foreground="{DynamicResource Brush.GoldSoft}"/>
                                                                <Run Text="{Binding Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- Rewards section -->
                                        <Border BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="1"
                                                Background="{DynamicResource Brush.PanelDark}"
                                                Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="{Binding TblRewards}"
                                                           Style="{StaticResource SectionTitle}"
                                                           Margin="0,0,0,12"/>
                                                <!-- Each reward as a gold-bordered tile -->
                                                <ItemsControl ItemsSource="{Binding SelectedQuest.Rewards}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{DynamicResource Brush.Gold}"
                                                                    BorderThickness="1"
                                                                    Background="{DynamicResource Brush.PanelDark}"
                                                                    Padding="10,8"
                                                                    Margin="0,0,10,8"
                                                                    MinWidth="70">
                                                                <TextBlock Text="{Binding}"
                                                                           Style="{StaticResource MutedText}"
                                                                           FontSize="13"
                                                                           HorizontalAlignment="Center"
                                                                           TextAlignment="Center"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </ScrollViewer>

                                <!-- ── Action row ────────────────────────────── -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Active tab: Return (primary) + Abandon (secondary) -->
                                    <Grid Grid.ColumnSpan="3"
                                          Visibility="{Binding IsShowingActive}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Return / Track Quest (primary, gold-bordered) -->
                                        <Button Grid.Column="0"
                                                Content="{Binding BtnTrack}"
                                                Command="{Binding ReturnQuestCommand}"
                                                CommandParameter="{Binding SelectedQuest}"
                                                Visibility="{Binding IsSelectedQuestReturnable}"
                                                Style="{StaticResource QuestButton}"/>

                                        <!-- Abandon (secondary) -->
                                        <Button Grid.Column="2"
                                                Content="{Binding BtnAbandon}"
                                                Command="{Binding AbandonQuestCommand}"
                                                CommandParameter="{Binding SelectedQuest}"
                                                Style="{StaticResource GhostButton}"
                                                Padding="16,0"/>
                                    </Grid>

                                    <!-- Available tab: direct-accept for known repeatables -->
                                    <Button Grid.Column="0" Grid.ColumnSpan="3"
                                            Content="{Binding BtnAccept}"
                                            Command="{Binding AcceptQuestCommand}"
                                            CommandParameter="{Binding SelectedQuest}"
                                            Visibility="{Binding IsSelectedQuestDirectlyAcceptable}"
                                            Style="{StaticResource PrimaryButton}"/>

                                    <!-- Available tab: speak-to hint when direct accept is not possible -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding GiverNpcHint}"
                                               Visibility="{Binding IsGiverNpcHintVisible}"
                                               Style="{StaticResource MutedText}"
                                               FontStyle="Italic"
                                               VerticalAlignment="Center"/>
                                </Grid>

                            </Grid>
                        </Grid>
                    </Border>

                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
