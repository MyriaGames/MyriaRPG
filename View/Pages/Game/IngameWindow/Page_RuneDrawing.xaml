<Page x:Class="Myria.Wpf.View.Pages.Game.IngameWindow.Page_RuneDrawing"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:vm="clr-namespace:Myria.Wpf.ViewModel.Pages.Game.IngameWindow"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="900"
      d:DataContext="{d:DesignInstance vm:RuneDrawingViewModel}"
      Title="Rune Drawing">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Foreground"      Value="{DynamicResource Brush.Muted}"/>
            <Setter Property="Background"      Value="{DynamicResource Brush.PanelDark}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily"      Value="Georgia"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.NavHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid MinWidth="580" MinHeight="420" Background="{DynamicResource Brush.WindowBackgroundGradient}">

        <Border Margin="10"
                BorderBrush="{DynamicResource Brush.Gold}"
                BorderThickness="1">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ── HEADER ────────────────────────────────────────────── -->
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                        <TextBlock Text="→"
                                   Foreground="{DynamicResource Brush.Gold}"
                                   FontSize="34"
                                   Margin="0,4,14,0"/>
                        <TextBlock Text="{Binding TblTitle}"
                                   Style="{StaticResource HeaderText}"/>
                        <TextBlock Text=" | Draw each letter one at a time."
                                   Foreground="{DynamicResource Brush.GoldSoft}"
                                   FontFamily="Georgia"
                                   FontStyle="Italic"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="18,6,0,0"/>
                    </StackPanel>
                    <Rectangle Height="1"
                               Fill="{DynamicResource Brush.Gold}"
                               VerticalAlignment="Bottom"
                               Opacity="0.55"/>
                </Grid>

                <!-- ── BODY: two-column layout ───────────────────────────── -->
                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: canvas area -->
                    <Border Grid.Column="0"
                            Style="{StaticResource GoldBorder}"
                            Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- InkCanvas -->
                            <Border Grid.Row="0"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1"
                                    Background="White"
                                    MinHeight="260">
                                <InkCanvas x:Name="DrawingCanvas"
                                           Background="White">
                                    <InkCanvas.DefaultDrawingAttributes>
                                        <DrawingAttributes Color="Black" Width="4" Height="4" FitToCurve="True"/>
                                    </InkCanvas.DefaultDrawingAttributes>
                                </InkCanvas>
                            </Border>

                            <!-- Canvas actions -->
                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,10,0,0">
                                <Button x:Name="BtnClearCanvas"
                                        Content="{Binding TblClearCanvas}"
                                        Style="{StaticResource ActionButton}"
                                        Padding="14,0"
                                        Margin="0,0,8,0"
                                        Click="BtnClearCanvas_Click"/>
                                <Button x:Name="BtnConfirmLetter"
                                        Content="{Binding TblConfirmLetter}"
                                        Style="{StaticResource ActionButton}"
                                        Padding="18,0"
                                        Click="BtnConfirmLetter_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- RIGHT: word buffer and result -->
                    <Border Grid.Column="2"
                            Style="{StaticResource GoldBorder}"
                            Padding="14">
                        <StackPanel>

                            <!-- Word buffer header -->
                            <TextBlock Text="Word:"
                                       Style="{StaticResource MutedText}"
                                       FontSize="11"
                                       Margin="0,0,0,6"/>

                            <!-- Recognized letters in Myriac font -->
                            <Border BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1"
                                    Background="{DynamicResource Brush.PanelDark}"
                                    Padding="10,8"
                                    MinHeight="48"
                                    Margin="0,0,0,8">
                                <TextBlock Text="{Binding CurrentWord}"
                                           FontFamily="{StaticResource Font.Myriac}"
                                           Foreground="{DynamicResource Brush.Gold}"
                                           FontSize="26"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <!-- Latin letters below for readability -->
                            <ItemsControl ItemsSource="{Binding RecognizedLetters}"
                                          Margin="0,0,0,12">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="1"
                                                CornerRadius="2"
                                                Padding="6,2"
                                                Margin="2,2,0,0">
                                            <TextBlock Text="{Binding}"
                                                       Foreground="{DynamicResource Brush.GoldSoft}"
                                                       FontFamily="Georgia"
                                                       FontSize="13"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Last recognized feedback -->
                            <StackPanel Margin="0,0,0,8"
                                        Visibility="{Binding LastRecognized, Converter={StaticResource BoolToVis}, ConverterParameter=notEmpty}">
                                <TextBlock Style="{StaticResource MutedText}" FontSize="11">
                                    <Run Text="Recognized: "/>
                                    <Run Text="{Binding LastRecognized, Mode=OneWay}"
                                         Foreground="{DynamicResource Brush.Gold}"/>
                                    <Run Text=" ("/>
                                    <Run Text="{Binding ConfidenceText, Mode=OneWay}"
                                         Foreground="{DynamicResource Brush.GoldSoft}"/>
                                    <Run Text=")"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- Status message -->
                            <TextBlock Text="{Binding StatusMessage}"
                                       Style="{StaticResource MutedText}"
                                       FontSize="12"
                                       FontStyle="Italic"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>

                            <Rectangle Height="1"
                                       Fill="{DynamicResource Brush.Border}"
                                       Margin="0,0,0,12"/>

                            <!-- Word controls -->
                            <Button Content="{Binding TblUndo}"
                                    Command="{Binding UndoLetterCommand}"
                                    Style="{StaticResource ActionButton}"
                                    HorizontalAlignment="Stretch"
                                    Padding="0"
                                    Margin="0,0,0,6"/>

                            <Button Content="{Binding TblClearWord}"
                                    Command="{Binding ClearWordCommand}"
                                    Style="{StaticResource ActionButton}"
                                    HorizontalAlignment="Stretch"
                                    Padding="0"
                                    Margin="0,0,0,14"/>

                            <!-- Submit -->
                            <Button x:Name="BtnSubmitWord"
                                    Content="{Binding TblSubmit}"
                                    Style="{StaticResource ActionButton}"
                                    HorizontalAlignment="Stretch"
                                    Padding="0"
                                    Margin="0,0,0,6"
                                    IsEnabled="{Binding CanSubmit}"
                                    Click="BtnSubmitWord_Click"/>

                            <Button Content="{Binding TblBack}"
                                    Command="{Binding BackCommand}"
                                    Style="{StaticResource ActionButton}"
                                    HorizontalAlignment="Stretch"
                                    Padding="0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
