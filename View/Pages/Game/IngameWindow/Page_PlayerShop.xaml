<Page x:Class="Myria.Wpf.View.Pages.Game.IngameWindow.Page_CharacterShop"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:conv="clr-namespace:Myria.Wpf.View.Converters"
      mc:Ignorable="d"
      d:DesignWidth="360"
      Background="Transparent"
      Title="CharacterShop">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:IsItemStagedConverter x:Key="IsItemStaged"/>

        <Style x:Key="ShopPanelBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.HudBodyGradient}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Effect" Value="{StaticResource Effect.PanelShadow}"/>
        </Style>

        <Style x:Key="ShopSectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.GoldSoft}"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="ShopBodyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="ShopMutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="ShopTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="{DynamicResource Brush.PanelDark}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.Foreground}"/>
        </Style>

        <Style x:Key="ShopGoldButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.GoldSoft}"/>
            <Setter Property="Background" Value="{DynamicResource Brush.PanelDark}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.NavHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShopPrimaryGoldButton" TargetType="Button" BasedOn="{StaticResource ShopGoldButton}">
            <Setter Property="Background" Value="{DynamicResource Brush.BlueActive}"/>
        </Style>

        <Style x:Key="ShopDangerGoldButton" TargetType="Button" BasedOn="{StaticResource ShopGoldButton}">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Error}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Error}"/>
        </Style>

        <!-- Inventory deposit tile - click selects (or, for a stack, opens the quantity stepper
             below) instead of the drag-to-move behavior Inventory.xaml uses; visuals otherwise
             match that page's InventorySlotStyle. -->
        <Style x:Key="DepositTileButton" TargetType="Button">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{DynamicResource Brush.PanelDark}"
                                BorderBrush="{Binding RarityBrush}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Padding="2">
                            <Grid Background="Transparent">
                                <ContentControl Content="{Binding Item}" Style="{StaticResource IconSwitcherStyle}" Margin="2"/>
                                <Border Background="#AA030506"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        CornerRadius="2" Margin="0,0,2,2" Padding="3,1"
                                        Visibility="{Binding IsStack, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding Item.StackSize}"
                                               Foreground="{DynamicResource Brush.GoldSoft}"
                                               FontFamily="Georgia" FontSize="9" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </Border>
                        <!-- Already staged for deposit - dim it so a repeat click isn't a silent
                             no-op with no visible reason why (see SelectInventoryItem). -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── / +  stepper button, matching the NPC shop buy-quantity control ── -->
        <Style x:Key="ShopQtyStepButton" TargetType="Button" BasedOn="{StaticResource ShopGoldButton}">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="4">

        <!-- Header -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Title}"
                       Foreground="{DynamicResource Brush.GoldSoft}"
                       FontFamily="Georgia" FontSize="16" FontWeight="Bold"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content="{Binding ToggleShopLabel}"
                    Command="{Binding ToggleShopCommand}"
                    Style="{StaticResource ShopPrimaryGoldButton}"
                    Visibility="{Binding IsOwner, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <!-- ── Owner: deposit picker ─────────────────────────────────────────────── -->
        <Border Style="{StaticResource ShopPanelBorder}"
                Visibility="{Binding IsOwner, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Deposit from Inventory" Style="{StaticResource ShopSectionHeader}"/>
                </Grid>

                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding InventoryVm.InventoryItems}"
                                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource DepositTileButton}"
                                        Command="{Binding Tag.SelectInventoryItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.IsEnabled>
                                        <MultiBinding Converter="{StaticResource IsItemStaged}">
                                            <Binding/>
                                            <Binding Path="Tag.StagedItems" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                        </MultiBinding>
                                    </Button.IsEnabled>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Quantity stepper - only shown right after clicking a stack (>1) -->
                <StackPanel Margin="0,8,0,0" Visibility="{Binding IsPendingQuantityVisible, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource ShopMutedText}" Margin="0,0,0,6">
                        <Run Text="How many"/> <Run Text="{Binding PendingItem.Item.StackSize, Mode=OneWay, StringFormat='(of {0})'}"/><Run Text="?"/>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="−" Command="{Binding DecreasePendingQtyCommand}" Style="{StaticResource ShopQtyStepButton}"/>
                        <TextBlock Text="{Binding PendingQuantity}" Style="{StaticResource ShopBodyText}"
                                   FontWeight="Bold" Width="36" TextAlignment="Center" VerticalAlignment="Center"/>
                        <Button Content="+" Command="{Binding IncreasePendingQtyCommand}" Style="{StaticResource ShopQtyStepButton}"/>
                        <Button Content="Max" Command="{Binding MaxPendingQtyCommand}" Style="{StaticResource ShopQtyStepButton}" Width="Auto" Margin="6,0,0,0"/>
                        <Button Content="Select" Command="{Binding ConfirmPendingQtyCommand}" Style="{StaticResource ShopPrimaryGoldButton}" Width="Auto" Margin="6,0,0,0"/>
                        <Button Content="✕" Command="{Binding CancelPendingQtyCommand}" Style="{StaticResource ShopGoldButton}" Width="26" Margin="6,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Staged items - nothing here has actually been deposited yet -->
                <StackPanel Margin="0,10,0,0" Visibility="{Binding HasStagedItems, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Selected to deposit:" Style="{StaticResource ShopMutedText}" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding StagedItems}"
                                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,4" Padding="6,4"
                                        Background="{DynamicResource Brush.PanelDark}" CornerRadius="2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource ShopBodyText}" FontSize="11">
                                            <Run Text="{Binding DisplayName, Mode=OneWay}"/>
                                            <Run Text="{Binding Quantity, Mode=OneWay, StringFormat=' ×{0}'}"/>
                                        </TextBlock>
                                        <Button Grid.Column="1" Content="✕"
                                                Command="{Binding Tag.RemoveStagedItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ShopGoldButton}" Width="22" Height="22" Padding="0" FontSize="10"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Deposit Selected"
                            Command="{Binding DepositSelectedCommand}"
                            Style="{StaticResource ShopPrimaryGoldButton}"
                            HorizontalAlignment="Stretch" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── Storage / listings — owner sees everything (incl. unpriced + the Merchant's
             Seal); buyer sees only priced items (server-enforced, see GameHub.BrowseShop).
             Deposited items are never auto-listed - the owner sets a price explicitly below. ── -->
        <Border Style="{StaticResource ShopPanelBorder}">
            <StackPanel>
                <TextBlock Text="Storage" Style="{StaticResource ShopSectionHeader}" Margin="0,0,0,8"
                           Visibility="{Binding IsOwner, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="For Sale" Margin="0,0,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource ShopSectionHeader}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOwner}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ListBox ItemsSource="{Binding Listings}"
                         SelectedItem="{Binding SelectedListing}"
                         Background="Transparent" BorderThickness="0"
                         MaxHeight="180" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,4"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,6" Background="{DynamicResource Brush.PanelDark}" CornerRadius="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ItemId}" Style="{StaticResource ShopBodyText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='×{0}'}"
                                               Foreground="{DynamicResource Brush.Muted}" FontFamily="Georgia" FontSize="11"
                                               VerticalAlignment="Center" Margin="8,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding PriceText}"
                                               Foreground="{DynamicResource Brush.Gold}" FontFamily="Georgia" FontSize="11"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Owner: act on the selected storage row -->
                <StackPanel Margin="0,10,0,0" Visibility="{Binding IsOwner, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource ShopMutedText}" Margin="0,0,0,6">
                        <Run Text="Selected:"/> <Run Text="{Binding SelectedListing.ItemId, Mode=OneWay, TargetNullValue='(none)'}"/>
                    </TextBlock>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding WithdrawQty, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ShopTextBox}" ToolTip="Quantity to withdraw"/>
                        <Button Grid.Column="1" Content="Withdraw" Command="{Binding WithdrawCommand}"
                                Style="{StaticResource ShopGoldButton}" Margin="6,0,0,0"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ShopTextBox}" ToolTip="Price (Bronze)"/>
                        <Button Grid.Column="1" Content="Set Price" Command="{Binding SetPriceCommand}"
                                Style="{StaticResource ShopPrimaryGoldButton}" Margin="6,0,0,0"/>
                        <Button Grid.Column="2" Content="Unlist" Command="{Binding UnlistCommand}"
                                Style="{StaticResource ShopGoldButton}" Margin="6,0,0,0"/>
                    </Grid>
                </StackPanel>

                <!-- Buyer: buy the selected listing -->
                <StackPanel Margin="0,10,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOwner}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding BuyQty, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ShopTextBox}" ToolTip="Quantity to buy"/>
                        <Button Grid.Column="1" Content="Buy" Command="{Binding BuyCommand}"
                                Style="{StaticResource ShopPrimaryGoldButton}" Margin="6,0,0,0"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Status + Close -->
        <TextBlock Text="{Binding Status}" Style="{StaticResource ShopMutedText}" Margin="0,0,0,8"/>
        <Button Content="Close" Command="{Binding CloseCommand}"
                Style="{StaticResource ShopGoldButton}" HorizontalAlignment="Left"/>
    </StackPanel>
    </ScrollViewer>
</Page>
