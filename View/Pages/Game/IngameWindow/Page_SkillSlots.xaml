<Page x:Class="Myria.Wpf.View.Pages.Game.IngameWindow.Page_SkillSlots"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="900"
      Title="Skill Slots">

    <Page.Resources>

        <!-- Tab-style button (Back) -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Height"          Value="38"/>
            <Setter Property="Foreground"      Value="{DynamicResource Brush.Muted}"/>
            <Setter Property="Background"      Value="{DynamicResource Brush.PanelDark}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily"      Value="Georgia"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.NavHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost button (Slot, Unslot, ↑↓) -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground"      Value="{DynamicResource Brush.Muted}"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily"      Value="Georgia"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource Brush.NavHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shared card template for all three available-skill lists -->
        <DataTemplate x:Key="AvailableSkillCard">
            <Border x:Name="CardBorder"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    Background="{DynamicResource Brush.PanelDark}"
                    Padding="10,8"
                    Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="✦"
                               Foreground="{DynamicResource Brush.Gold}"
                               FontSize="16"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding Name}"
                                   Foreground="{DynamicResource Brush.Foreground}"
                                   FontFamily="Georgia"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TypeAndTarget}"
                                   Style="{StaticResource MutedText}"
                                   FontSize="11"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="{Binding DataContext.TblSlot, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            Command="{Binding DataContext.SlotSkillCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            IsEnabled="{Binding CanSlot}"
                            Style="{StaticResource GhostButton}"
                            Height="26" Padding="10,0"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSlotted}" Value="True">
                    <Setter TargetName="CardBorder" Property="BorderBrush"
                            Value="{DynamicResource Brush.Gold}"/>
                    <Setter TargetName="CardBorder" Property="Opacity" Value="0.55"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid MinWidth="600" MinHeight="360" Background="{DynamicResource Brush.WindowBackgroundGradient}">

        <!-- Decorative watermark -->
        <TextBlock Text="✦"
                   FontSize="220"
                   Foreground="{DynamicResource Brush.Panel}"
                   Opacity="0.4"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="0,10,40,0"/>

        <!-- Outer gold-bordered container -->
        <Border Margin="10"
                BorderBrush="{DynamicResource Brush.Gold}"
                BorderThickness="1">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ── HEADER ────────────────────────────────────────────── -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                        <TextBlock Text="→"
                                   Foreground="{DynamicResource Brush.Gold}"
                                   FontSize="34"
                                   Margin="0,4,14,0"/>
                        <TextBlock Text="{Binding TblTitle}"
                                   Style="{StaticResource HeaderText}"/>
                        <TextBlock Text=" | Equip skills for battle."
                                   Foreground="{DynamicResource Brush.GoldSoft}"
                                   FontFamily="Georgia"
                                   FontStyle="Italic"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="18,6,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,0,10">
                        <TextBlock Text="{Binding SlotCountText}"
                                   Style="{StaticResource MutedText}"
                                   FontFamily="Georgia"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,0"/>
                        <Button Content="{Binding TblBack}"
                                Command="{Binding GoBackCommand}"
                                Style="{StaticResource TabButton}"
                                Padding="16,0"/>
                    </StackPanel>

                    <Rectangle Grid.ColumnSpan="2"
                               Height="1"
                               Fill="{DynamicResource Brush.Gold}"
                               VerticalAlignment="Bottom"
                               Opacity="0.55"/>
                </Grid>

                <!-- ── BODY ──────────────────────────────────────────────── -->
                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ╔══ LEFT: available skills ══════════════════════════╗ -->
                    <Border Grid.Column="0" Style="{StaticResource GoldBorder}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="{Binding TblAvailable}"
                                       Style="{StaticResource SectionTitle}"
                                       Margin="0,0,0,10"/>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>

                                    <!-- Regular skills -->
                                    <TextBlock Text="{Binding TblRegular}"
                                               Style="{StaticResource MutedText}"
                                               FontSize="11"
                                               Margin="2,0,0,6"/>
                                    <ItemsControl ItemsSource="{Binding AvailableRegularSkills}"
                                                  ItemTemplate="{StaticResource AvailableSkillCard}"/>

                                    <!-- Combined skills -->
                                    <TextBlock Text="{Binding TblCombined}"
                                               Style="{StaticResource MutedText}"
                                               FontSize="11"
                                               Margin="2,10,0,6"
                                               Visibility="{Binding HasCombinedSkills, Converter={StaticResource BoolToVis}}"/>
                                    <ItemsControl ItemsSource="{Binding AvailableCombinedSkills}"
                                                  ItemTemplate="{StaticResource AvailableSkillCard}"/>

                                    <!-- Fusion skills -->
                                    <TextBlock Text="{Binding TblFusion}"
                                               Style="{StaticResource MutedText}"
                                               FontSize="11"
                                               Margin="2,10,0,6"
                                               Visibility="{Binding HasFusionSkills, Converter={StaticResource BoolToVis}}"/>
                                    <ItemsControl ItemsSource="{Binding AvailableFusionSkills}"
                                                  ItemTemplate="{StaticResource AvailableSkillCard}"/>

                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- ╔══ RIGHT: active slots ══════════════════════════════╗ -->
                    <Border Grid.Column="2" Style="{StaticResource GoldBorder}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="{Binding TblActiveSlots}"
                                       Style="{StaticResource SectionTitle}"
                                       Margin="0,0,0,10"/>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ActiveSlots}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Brush.Gold}"
                                                    BorderThickness="1"
                                                    Background="{DynamicResource Brush.BlueActive}"
                                                    Padding="10,8"
                                                    Margin="0,0,0,6"
                                                    MinHeight="44">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Slot number badge -->
                                                    <Border Grid.Column="0"
                                                            Width="22" Height="22"
                                                            BorderBrush="{DynamicResource Brush.Gold}"
                                                            BorderThickness="1"
                                                            CornerRadius="2"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding SlotNumber}"
                                                                   Foreground="{DynamicResource Brush.GoldSoft}"
                                                                   FontFamily="Georgia"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>

                                                    <!-- Skill name + source tag -->
                                                    <StackPanel Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                Margin="4,0,8,0">
                                                        <TextBlock Text="{Binding SkillName}"
                                                                   Foreground="{DynamicResource Brush.Foreground}"
                                                                   FontFamily="Georgia"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding SourceTag}"
                                                                   Style="{StaticResource MutedText}"
                                                                   FontSize="11"
                                                                   Margin="0,2,0,0"
                                                                   Visibility="{Binding HasSourceTag, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>

                                                    <!-- Move up / down -->
                                                    <StackPanel Grid.Column="2"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,6,0">
                                                        <Button Content="↑"
                                                                Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource GhostButton}"
                                                                Height="26" Width="28" Padding="0"
                                                                Margin="0,0,4,0"/>
                                                        <Button Content="↓"
                                                                Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource GhostButton}"
                                                                Height="26" Width="28" Padding="0"/>
                                                    </StackPanel>

                                                    <!-- Unslot -->
                                                    <Button Grid.Column="3"
                                                            Content="{Binding DataContext.TblUnslot, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            Command="{Binding DataContext.UnslotSkillCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource GhostButton}"
                                                            Height="26" Padding="10,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
