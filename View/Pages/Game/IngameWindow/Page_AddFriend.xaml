<Page x:Class="Myria.Wpf.View.Pages.Game.IngameWindow.Page_AddFriend"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="Add Friend">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Brush.GoldSoft}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="20,18" Background="{DynamicResource Brush.WindowBackgroundGradient}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding TblInstruction}"
                   Foreground="{DynamicResource Brush.SecondaryText}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,0,0,14"/>

        <TextBox Grid.Row="1"
                 Text="{Binding CharacterName, UpdateSourceTrigger=PropertyChanged}"
                 Background="{DynamicResource Brush.Background}"
                 Foreground="{DynamicResource Brush.Foreground}"
                 BorderBrush="{DynamicResource Brush.Border}"
                 BorderThickness="1"
                 Padding="10,8"
                 FontSize="13"
                 Margin="0,0,0,10">
            <TextBox.InputBindings>
                <KeyBinding Key="Return" Command="{Binding SendCommand}"/>
            </TextBox.InputBindings>
        </TextBox>

        <Button Grid.Row="2"
                Content="{Binding TblSendRequest}"
                Command="{Binding SendCommand}"
                Style="{StaticResource PrimaryBtn}"
                Background="{DynamicResource Brush.Accent}"
                Padding="0,10"
                FontSize="13"
                FontWeight="SemiBold"
                HorizontalAlignment="Stretch"/>

        <TextBlock Grid.Row="3"
                   Text="{Binding Feedback}"
                   FontSize="12"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Error}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</Page>
