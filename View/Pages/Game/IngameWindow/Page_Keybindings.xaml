<Page x:Class="Myria.Wpf.View.Pages.Game.IngameWindow.Page_Keybindings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="820"
      d:DesignWidth="1280"
      Background="Transparent"
      Title="Page_Keybindings">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <DropShadowEffect x:Key="KeybindGoldGlow" BlurRadius="16" ShadowDepth="0" Opacity="0.45" Color="{DynamicResource Color.Gold}"/>

        <Style x:Key="KeybindHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.GoldSoft}"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="44"/>
        </Style>

        <Style x:Key="KeybindBodyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="KeybindColumnHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.GoldSoft}"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="KeybindKeyButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
            <Setter Property="Background" Value="{DynamicResource Brush.PanelDark}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.NavHover}"/>
                    <Setter Property="Effect" Value="{StaticResource KeybindGoldGlow}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KeybindResetButton" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.GoldSoft}"/>
            <Setter Property="Background" Value="{DynamicResource Brush.PanelDark}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.NavHover}"/>
                    <Setter Property="Effect" Value="{StaticResource KeybindGoldGlow}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KeybindPrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="MinWidth" Value="250"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.GoldSoft}"/>
            <Setter Property="Background" Value="{DynamicResource Brush.BlueActive}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.NavHover}"/>
                    <Setter Property="Effect" Value="{StaticResource KeybindGoldGlow}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Border Background="{DynamicResource Brush.WindowBackgroundGradient}"
            BorderBrush="{DynamicResource Brush.Gold}"
            BorderThickness="1">

        <Grid Margin="34,24,34,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="4*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Ellipse Width="420"
                     Height="420"
                     Stroke="{DynamicResource Brush.Gold}"
                     StrokeThickness="1"
                     Opacity="0.22"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Margin="0,-126,-80,0"/>
            <Ellipse Width="280"
                     Height="280"
                     Stroke="{DynamicResource Brush.Gold}"
                     StrokeThickness="1"
                     Opacity="0.16"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Margin="0,-58,-10,0"/>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource KeybindHeaderText}"/>
                <TextBlock Text="{Binding TblDescription}"
                           Foreground="{DynamicResource Brush.GoldSoft}"
                           FontFamily="Georgia"
                           FontStyle="Italic"
                           FontSize="17"
                           Margin="34,8,0,0"/>
                <Grid Width="440" HorizontalAlignment="Left" Margin="18,14,0,0">
                    <Rectangle Height="1" Fill="{DynamicResource Brush.Gold}" Opacity="0.65"/>
                    <TextBlock Text="&#x25C7;"
                               Foreground="{DynamicResource Brush.GoldSoft}"
                               FontFamily="Segoe UI Symbol"
                               FontSize="24"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,-17,0,0"/>
                </Grid>
            </StackPanel>

            <Border Grid.Row="1"
                    Background="{DynamicResource Brush.MainPanelGradient}"
                    BorderBrush="{DynamicResource Brush.Gold}"
                    BorderThickness="1"
                    Effect="{StaticResource Effect.PanelShadow}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42*"/>
                        <ColumnDefinition Width="25*"/>
                        <ColumnDefinition Width="25*"/>
                        <ColumnDefinition Width="8*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,1">
                        <TextBlock Text="{Binding TblColumnAction}" Style="{StaticResource KeybindColumnHeaderText}" HorizontalAlignment="Left" Margin="34,0,0,0"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,1">
                        <TextBlock Text="{Binding TblColumnPrimary}" Style="{StaticResource KeybindColumnHeaderText}"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,1">
                        <TextBlock Text="{Binding TblColumnSecondary}" Style="{StaticResource KeybindColumnHeaderText}"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="3" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                        <TextBlock Text="&#x21BA;" Style="{StaticResource KeybindColumnHeaderText}" FontFamily="Segoe UI Symbol" FontSize="20"/>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  Grid.ColumnSpan="4"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="56">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42*"/>
                                            <ColumnDefinition Width="25*"/>
                                            <ColumnDefinition Width="25*"/>
                                            <ColumnDefinition Width="8*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.ColumnSpan="4" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"/>

                                        <StackPanel Grid.Column="0"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="34,0,16,0">
                                            <TextBlock Text="&#x25C6;"
                                                       Foreground="{DynamicResource Brush.GoldSoft}"
                                                       FontFamily="Segoe UI Symbol"
                                                       FontSize="18"
                                                       Margin="0,0,18,0"/>
                                            <TextBlock Text="{Binding Label}"
                                                       Style="{StaticResource KeybindBodyText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Style="{StaticResource KeybindKeyButton}"
                                                Command="{Binding ListenCommand}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <TextBlock TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
                                                        <Setter Property="Text" Value="{Binding KeyName}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsListening}" Value="True">
                                                                <Setter Property="Text" Value="{Binding TblListening}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.GoldSoft}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>

                                        <TextBlock Grid.Column="2"
                                                   Text="-"
                                                   Style="{StaticResource KeybindBodyText}"
                                                   Foreground="{DynamicResource Brush.Muted}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                        <Button Grid.Column="3"
                                                Content="&#x21BA;"
                                                Style="{StaticResource KeybindResetButton}"
                                                Command="{Binding ResetCommand}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                ToolTip="{Binding TblResetDefault}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Button Style="{StaticResource KeybindPrimaryButton}"
                        Command="{Binding ResetAllCommand}"
                        HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x21BA;"
                                   FontFamily="Segoe UI Symbol"
                                   Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding ResetAllLabel}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Page>
