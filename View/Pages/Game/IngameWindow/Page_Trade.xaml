<Page x:Class="Myria.Wpf.View.Pages.Game.IngameWindow.Page_Trade"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Background="Transparent"
      Title="{Binding Title}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Section divider header -->
        <Style x:Key="SectionDivider" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Compact inventory slot (drag source) -->
        <Style x:Key="InvTileStyle" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource Brush.PanelDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin"          Value="2"/>
            <Setter Property="CornerRadius"    Value="2"/>
            <Setter Property="Padding"         Value="2"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.BlueActive}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Offered item row -->
        <Style x:Key="TradeItemRow" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource Brush.PanelDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Border}"/>
            <Setter Property="CornerRadius"    Value="2"/>
            <Setter Property="Padding"         Value="8,5"/>
            <Setter Property="Margin"          Value="0,0,4,4"/>
        </Style>
    </Page.Resources>

    <Grid Margin="14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- partner offer -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>  <!-- my offer -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>     <!-- my inventory -->
            <RowDefinition Height="Auto"/>  <!-- footer -->
        </Grid.RowDefinitions>

        <!-- ── Partner's Offer ─────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{DynamicResource Brush.HudBodyGradient}"
                BorderBrush="{DynamicResource Brush.Gold}"
                BorderThickness="1"
                CornerRadius="2"
                Padding="12,10">
            <StackPanel>

                <!-- Header row -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding PartnerOfferLabel}"
                               Foreground="{DynamicResource Brush.GoldSoft}"
                               FontFamily="Georgia" FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Rectangle Grid.Column="1" Height="1"
                               Fill="{DynamicResource Brush.Gold}" Opacity="0.35"
                               VerticalAlignment="Center"/>
                    <!-- Partner ready badge -->
                    <Border Grid.Column="2" Margin="10,0,0,0" CornerRadius="2" Padding="6,2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Brush.PanelDark}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TheyAreReady}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Brush.BlueActive}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding TheirReadyText}"
                                   FontFamily="Georgia" FontSize="10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TheyAreReady}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.GoldSoft}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>

                <!-- Their gold -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="♦" Foreground="{DynamicResource Brush.GoldSoft}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding TheirGoldText}"
                               Foreground="{DynamicResource Brush.Foreground}"
                               FontFamily="Georgia" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Their items -->
                <ItemsControl ItemsSource="{Binding TheirItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource TradeItemRow}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{DynamicResource Brush.Foreground}"
                                               FontFamily="Georgia" FontSize="12"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Quantity, StringFormat=' ×{0}'}"
                                               Foreground="{DynamicResource Brush.GoldSoft}"
                                               FontFamily="Georgia" FontSize="11"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty state -->
                <TextBlock Text="— nothing offered yet —"
                           Foreground="{DynamicResource Brush.Muted}"
                           FontFamily="Georgia" FontSize="11" FontStyle="Italic"
                           Margin="2,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TheirItems.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

            </StackPanel>
        </Border>

        <!-- ── My Offer (drop target) ──────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="{DynamicResource Brush.HudBodyGradient}"
                BorderBrush="{DynamicResource Brush.Gold}"
                BorderThickness="1"
                CornerRadius="2"
                Padding="12,10"
                AllowDrop="True"
                DragOver="MyOffer_DragOver"
                Drop="MyOffer_Drop">
            <StackPanel>

                <!-- Header row -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding MyOfferLabel}"
                               Foreground="{DynamicResource Brush.GoldSoft}"
                               FontFamily="Georgia" FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Rectangle Grid.Column="1" Height="1"
                               Fill="{DynamicResource Brush.Gold}" Opacity="0.35"
                               VerticalAlignment="Center"/>
                    <!-- My ready badge -->
                    <Border Grid.Column="2" Margin="10,0,0,0" CornerRadius="2" Padding="6,2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Brush.PanelDark}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ImReady}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Brush.BlueActive}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ImReadyText}"
                                   FontFamily="Georgia" FontSize="10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ImReady}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.GoldSoft}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>

                <!-- My gold input -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="♦"
                               Foreground="{DynamicResource Brush.GoldSoft}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding GoldInput, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource Brush.PanelDark}"
                             Foreground="{DynamicResource Brush.Foreground}"
                             BorderBrush="{DynamicResource Brush.Gold}" BorderThickness="1"
                             FontFamily="Georgia" FontSize="12"
                             Padding="6,3"/>
                    <Button Grid.Column="2"
                            Content="{Binding SetLabel}"
                            Command="{Binding SetGoldCommand}"
                            Margin="6,0,0,0" Height="26"
                            Background="{DynamicResource Brush.PanelDark}"
                            Foreground="{DynamicResource Brush.GoldSoft}"
                            BorderBrush="{DynamicResource Brush.Gold}" BorderThickness="1"
                            FontFamily="Georgia" FontSize="11" Cursor="Hand"/>
                </Grid>

                <!-- My items (with remove buttons) -->
                <ItemsControl ItemsSource="{Binding MyItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource TradeItemRow}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{DynamicResource Brush.Foreground}"
                                               FontFamily="Georgia" FontSize="12"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Quantity, StringFormat=' ×{0}'}"
                                               Foreground="{DynamicResource Brush.GoldSoft}"
                                               FontFamily="Georgia" FontSize="11"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Button Content="✕"
                                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding ItemId}"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="{DynamicResource Brush.Muted}"
                                            FontSize="10" Cursor="Hand"
                                            VerticalAlignment="Center"
                                            Padding="0" Style="{x:Null}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Drop hint -->
                <Border CornerRadius="2" Padding="10,6" Margin="0,4,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background"     Value="{DynamicResource Brush.PanelDark}"/>
                            <Setter Property="BorderBrush"    Value="{DynamicResource Brush.Border}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MyItems.Count}" Value="0">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.GoldSoft}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="↑ Drag items from your inventory here"
                               Foreground="{DynamicResource Brush.Muted}"
                               FontFamily="Georgia" FontSize="11" FontStyle="Italic"
                               HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MyItems.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

            </StackPanel>
        </Border>

        <!-- ── My Inventory (drag source) ─────────────────────────────────── -->
        <Border Grid.Row="4"
                Background="{DynamicResource Brush.HudBodyGradient}"
                BorderBrush="{DynamicResource Brush.Gold}"
                BorderThickness="1"
                CornerRadius="2"
                Padding="12,10">
            <StackPanel>

                <!-- Header -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Your Inventory"
                               Foreground="{DynamicResource Brush.GoldSoft}"
                               FontFamily="Georgia" FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Rectangle Grid.Column="1" Height="1"
                               Fill="{DynamicResource Brush.Gold}" Opacity="0.35"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Compact inventory grid (7 cols × N rows, 48×48 tiles) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="170">
                    <ItemsControl ItemsSource="{Binding InventoryGrid.InventoryItems}"
                                  x:Name="InvControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="48"/>
                                        <RowDefinition Height="48"/>
                                        <RowDefinition Height="48"/>
                                        <RowDefinition Height="48"/>
                                        <RowDefinition Height="48"/>
                                        <RowDefinition Height="48"/>
                                        <RowDefinition Height="48"/>
                                    </Grid.RowDefinitions>
                                </Grid>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Grid.Column" Value="{Binding GridColumn}"/>
                                <Setter Property="Grid.Row"    Value="{Binding GridRow}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource InvTileStyle}"
                                        BorderBrush="{Binding RarityBrush}"
                                        PreviewMouseLeftButtonDown="InvTile_PreviewMouseLeftButtonDown"
                                        ToolTip="{Binding Item.Name}">
                                    <Grid Background="Transparent">
                                        <ContentControl Content="{Binding Item}"
                                                        Style="{StaticResource IconSwitcherStyle}"
                                                        Margin="2"/>
                                        <Border Background="#AA030506"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                CornerRadius="2" Margin="0,0,2,2" Padding="2,1"
                                                Visibility="{Binding IsStack, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding Item.StackSize}"
                                                       Foreground="{DynamicResource Brush.GoldSoft}"
                                                       FontFamily="Georgia" FontSize="9" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </StackPanel>
        </Border>

        <!-- ── Trade outcome banner (overlay) ─────────────────────────────── -->
        <Border Grid.Row="0" Grid.RowSpan="6"
                VerticalAlignment="Top"
                Visibility="{Binding IsResultVisible, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource Brush.PanelDark}"
                BorderBrush="{DynamicResource Brush.Success}"
                BorderThickness="1"
                CornerRadius="2"
                Padding="10,8"
                Margin="0,0,0,8">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="✕"
                        Command="{Binding DismissResultCommand}"
                        Foreground="{DynamicResource Brush.GoldSoft}"
                        Background="Transparent" BorderThickness="0"
                        FontSize="12" Cursor="Hand" Margin="8,0,0,0"
                        VerticalAlignment="Center" Style="{x:Null}"/>
                <TextBlock DockPanel.Dock="Left" Text="&#x2713;"
                           Foreground="{DynamicResource Brush.Success}"
                           FontFamily="Segoe UI Symbol" FontSize="14"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding ResultMessage}"
                           Foreground="{DynamicResource Brush.Foreground}"
                           FontFamily="Georgia" FontSize="11"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ── Footer ──────────────────────────────────────────────────────── -->
        <Grid Grid.Row="5" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="{Binding ConfirmLabel}"
                    Command="{Binding ConfirmCommand}"
                    Height="36"
                    Background="{DynamicResource Brush.BlueActive}"
                    Foreground="{DynamicResource Brush.GoldSoft}"
                    BorderBrush="{DynamicResource Brush.Gold}" BorderThickness="1"
                    FontFamily="Georgia" FontSize="13" FontWeight="Bold" Cursor="Hand"/>

            <Button Grid.Column="2"
                    Content="{Binding CancelTradeLabel}"
                    Command="{Binding CancelCommand}"
                    Height="36" MinWidth="90"
                    Background="Transparent"
                    Foreground="{DynamicResource Brush.Muted}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    FontFamily="Georgia" FontSize="13" Cursor="Hand"/>
        </Grid>

    </Grid>
</Page>
