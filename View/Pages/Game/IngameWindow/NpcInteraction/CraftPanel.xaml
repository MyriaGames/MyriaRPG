<Page x:Class="Myria.Wpf.View.Pages.Game.IngameWindow.NpcInteraction.CraftPanel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Myria.Wpf.View.Pages.Game.IngameWindow.NpcInteraction"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Background="Transparent"
      Title="CraftPanel">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Page title as section header -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding Title}"
                       FontFamily="Georgia"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Brush.GoldSoft}"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <Rectangle Grid.Column="1"
                       Height="1"
                       Fill="{DynamicResource Brush.Gold}"
                       Opacity="0.3"
                       VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Recipes panel -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Brush.HudBodyGradient}"
                    BorderBrush="{DynamicResource Brush.Gold}"
                    BorderThickness="1"
                    CornerRadius="2"
                    Padding="8,6"
                    Effect="{StaticResource Effect.PanelShadow}">
                <ListBox ItemsSource="{Binding Recipes}"
                         SelectedItem="{Binding SelectedRecipe}"
                         ItemContainerStyle="{StaticResource NpcListItem}"
                         BorderThickness="0"
                         Background="{x:Null}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </Border>

            <!-- Recipe details panel -->
            <Border Grid.Column="2"
                    Background="{DynamicResource Brush.HudBodyGradient}"
                    BorderBrush="{DynamicResource Brush.Gold}"
                    BorderThickness="1"
                    CornerRadius="2"
                    Padding="12,10"
                    Effect="{StaticResource Effect.PanelShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Recipe name as section header -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ContentControl Grid.Column="0"
                                        Content="{Binding SelectedRecipe}"
                                        Style="{StaticResource IconSwitcherStyle}"
                                        Width="{Binding FontSize, ElementName=RecipeNameText}"
                                        Height="{Binding FontSize, ElementName=RecipeNameText}"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"/>
                        <TextBlock x:Name="RecipeNameText"
                                   Grid.Column="1"
                                   Text="{Binding SelectedName}"
                                   FontFamily="Georgia"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.GoldSoft}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <Rectangle Grid.Column="2"
                                   Height="1"
                                   Fill="{DynamicResource Brush.Gold}"
                                   Opacity="0.3"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Ingredients list -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedIngredients}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,3"
                                            Padding="8,6"
                                            Background="{DynamicResource Brush.PanelDark}"
                                            BorderBrush="{DynamicResource Brush.Gold}"
                                            BorderThickness="1"
                                            CornerRadius="2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ContentControl Content="{Binding}"
                                                            Style="{StaticResource IconSwitcherStyle}"
                                                            Width="{Binding FontSize, ElementName=IngredientNameText}"
                                                            Height="{Binding FontSize, ElementName=IngredientNameText}"/>
                                            <TextBlock x:Name="IngredientNameText"
                                                       Grid.Column="1"
                                                       Text="{Binding DisplayString}"
                                                       FontFamily="Georgia"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource Brush.Foreground}"
                                                       VerticalAlignment="Center"
                                                       Margin="10,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Quantity + craft button -->
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontFamily="Georgia"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.Muted}"
                                   Margin="0,0,0,8"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding QuantityLabel}"
                                   FontFamily="Georgia"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.GoldSoft}"
                                   Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="&#x2212;"
                                    Command="{Binding DecreaseQuantityCommand}"
                                    Style="{StaticResource ShopQtyButton}"
                                    Width="30"/>
                            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                     Width="60"
                                     Style="{StaticResource ShopQtyTextBox}"
                                     Margin="5,0"/>
                            <Button Content="+"
                                    Command="{Binding IncreaseQuantityCommand}"
                                    Style="{StaticResource ShopQtyButton}"
                                    Width="30"/>
                            <Button Content="{Binding MaxLabel}"
                                    Command="{Binding MaxQuantityCommand}"
                                    Style="{StaticResource ShopQtyButton}"
                                    Margin="5,0,0,0"
                                    Padding="8,0"/>
                        </StackPanel>
                        <Button Content="{Binding BtnCraft}"
                                Command="{Binding CraftCommand}"
                                IsEnabled="{Binding CanCraft}"
                                Style="{StaticResource ShopPrimaryButton}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Button Grid.Row="2"
                Content="{Binding BtnBack}"
                Command="{Binding BackCommand}"
                Style="{StaticResource ShopQtyButton}"
                Width="120"
                Padding="15,0"
                HorizontalAlignment="Right"
                Margin="0,10,0,0"/>
    </Grid>
</Page>
