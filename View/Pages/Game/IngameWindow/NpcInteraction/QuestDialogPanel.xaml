<Page x:Class="Myria.Wpf.View.Pages.Game.IngameWindow.NpcInteraction.QuestDialogPanel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Background="Transparent"
      Title="QuestDialogPanel">

    <Border Background="{DynamicResource Brush.HudBodyGradient}"
            BorderBrush="{DynamicResource Brush.Gold}"
            BorderThickness="1"
            CornerRadius="2"
            Padding="14,10,14,12"
            Effect="{StaticResource Effect.PanelShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Quest title as section header -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding QuestTitle}"
                           FontFamily="Georgia"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Brush.GoldSoft}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <Rectangle Grid.Column="1"
                           Height="1"
                           Fill="{DynamicResource Brush.Gold}"
                           Opacity="0.3"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Speaker tag -->
            <Border Grid.Row="1"
                    Background="{DynamicResource Brush.PanelDark}"
                    BorderBrush="{DynamicResource Brush.Gold}"
                    BorderThickness="1"
                    CornerRadius="2"
                    Padding="8,3"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Left">
                <TextBlock Text="{Binding SpeakerName}"
                           FontFamily="Georgia"
                           FontSize="11"
                           FontWeight="SemiBold"
                           FontStyle="Italic"
                           Foreground="{DynamicResource Brush.GoldSoft}"/>
            </Border>

            <!-- Dialog text -->
            <TextBlock Grid.Row="2"
                       Text="{Binding LineText}"
                       Foreground="{DynamicResource Brush.Foreground}"
                       FontFamily="Georgia"
                       FontSize="14"
                       TextWrapping="Wrap"
                       MaxWidth="520"
                       VerticalAlignment="Top"/>

            <!-- Buttons -->
            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Button Content="{Binding DeclineLabel}"
                        Command="{Binding DeclineCommand}"
                        Style="{StaticResource ShopQtyButton}"
                        Width="120" Height="36"
                        HorizontalAlignment="Left"/>
                <Button Content="{Binding NextLabel}"
                        Command="{Binding NextCommand}"
                        Visibility="{Binding NextVisible}"
                        Style="{StaticResource ShopPrimaryButton}"
                        Width="120" Height="36"
                        HorizontalAlignment="Right"/>
                <Button Content="{Binding ActionLabel}"
                        Command="{Binding ActionCommand}"
                        Visibility="{Binding ActionVisible}"
                        Style="{StaticResource ShopPrimaryButton}"
                        Width="120" Height="36"
                        HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Border>
</Page>
