<Page x:Class="Myria.Wpf.View.Pages.Game.IngameWindow.NpcInteraction.UpgradePanel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Myria.Wpf.View.Pages.Game.IngameWindow.NpcInteraction"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Background="Transparent"
      Title="UpgradePanel">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Page title as section header -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding Title}"
                       FontFamily="Georgia"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Brush.GoldSoft}"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <Rectangle Grid.Column="1"
                       Height="1"
                       Fill="{DynamicResource Brush.Gold}"
                       Opacity="0.3"
                       VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Equipment list panel -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Brush.HudBodyGradient}"
                    BorderBrush="{DynamicResource Brush.Gold}"
                    BorderThickness="1"
                    CornerRadius="2"
                    Padding="8,6"
                    Effect="{StaticResource Effect.PanelShadow}">
                <ListBox ItemsSource="{Binding Equipment}"
                         SelectedItem="{Binding SelectedEquipment}"
                         ItemContainerStyle="{StaticResource NpcListItem}"
                         BorderThickness="0"
                         Background="{x:Null}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                <Border Grid.Column="1"
                                        Background="{DynamicResource Brush.PanelDark}"
                                        BorderBrush="{DynamicResource Brush.Gold}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Padding="5,1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UpgradeLevel, StringFormat='+{0}'}"
                                               Foreground="{DynamicResource Brush.Gold}"
                                               FontSize="11"
                                               FontFamily="Georgia"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Selected item details panel -->
            <Border Grid.Column="2"
                    Background="{DynamicResource Brush.HudBodyGradient}"
                    BorderBrush="{DynamicResource Brush.Gold}"
                    BorderThickness="1"
                    CornerRadius="2"
                    Padding="12,10"
                    Effect="{StaticResource Effect.PanelShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Item name as section header -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding SelectedName}"
                                   FontFamily="Georgia"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.GoldSoft}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <Rectangle Grid.Column="1"
                                   Height="1"
                                   Fill="{DynamicResource Brush.Gold}"
                                   Opacity="0.3"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Stats -->
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="{Binding SelectedLevel}"
                                   FontFamily="Georgia"
                                   FontSize="13"
                                   Foreground="{DynamicResource Brush.Foreground}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding UpgradeCost}"
                                   FontFamily="Georgia"
                                   FontSize="13"
                                   Foreground="{DynamicResource Brush.GoldSoft}"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontFamily="Georgia"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.Muted}"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Upgrade button -->
                    <Button Grid.Row="2"
                            Content="{Binding BtnUpgrade}"
                            Command="{Binding UpgradeCommand}"
                            IsEnabled="{Binding CanUpgrade}"
                            Style="{StaticResource ShopPrimaryButton}"/>
                </Grid>
            </Border>
        </Grid>

        <Button Grid.Row="2"
                Content="{Binding BtnBack}"
                Command="{Binding BackCommand}"
                Style="{StaticResource ShopQtyButton}"
                Width="120"
                Padding="15,0"
                HorizontalAlignment="Right"
                Margin="0,10,0,0"/>
    </Grid>
</Page>
