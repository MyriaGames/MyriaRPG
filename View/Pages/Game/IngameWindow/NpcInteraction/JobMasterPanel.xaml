<Page x:Class="Myria.Wpf.View.Pages.Game.IngameWindow.NpcInteraction.JobMasterPanel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="AspectBar" TargetType="ProgressBar">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="5"/>
            <Setter Property="Background" Value="{DynamicResource Brush.PanelDark}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border CornerRadius="3" Background="{TemplateBinding Background}">
                            <Border x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        CornerRadius="3"
                                        Background="{TemplateBinding Foreground}"
                                        HorizontalAlignment="Left"/>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="←"
                    Command="{Binding GoBackCommand}"
                    Foreground="{DynamicResource Brush.GoldSoft}"
                    Background="Transparent"
                    BorderThickness="0"
                    FontFamily="Georgia"
                    FontSize="16"
                    Cursor="Hand"
                    Padding="4,0,12,0"/>

            <TextBlock Grid.Column="1"
                       Text="{Binding JobName}"
                       FontFamily="Georgia"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Brush.GoldSoft}"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <Rectangle Grid.Column="2"
                       Height="1"
                       Fill="{DynamicResource Brush.Gold}"
                       Opacity="0.3"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <!-- Job type badge -->
            <Border Grid.Column="3"
                    Background="{DynamicResource Brush.PanelDark}"
                    BorderBrush="{DynamicResource Brush.Gold}"
                    BorderThickness="1"
                    CornerRadius="2"
                    Padding="8,3"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding JobType}"
                           FontFamily="Georgia"
                           FontSize="11"
                           Foreground="{DynamicResource Brush.Muted}"/>
            </Border>
        </Grid>

        <!-- Description -->
        <TextBlock Grid.Row="2"
                   Text="{Binding JobDescription}"
                   FontFamily="Georgia"
                   FontSize="13"
                   Foreground="{DynamicResource Brush.Muted}"
                   TextWrapping="Wrap"/>

        <!-- Aspects -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Skill -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Brush.HudBodyGradient}"
                    BorderBrush="{DynamicResource Brush.Gold}"
                    BorderThickness="1"
                    CornerRadius="2"
                    Padding="12,10"
                    Effect="{StaticResource Effect.PanelShadow}">
                <StackPanel>
                    <TextBlock Text="{Binding SkillLabel}"
                               FontFamily="Georgia"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Accent}"
                               Margin="0,0,0,4"/>
                    <ProgressBar Value="{Binding SkillFraction, Mode=OneWay}"
                                 Maximum="1"
                                 Foreground="{DynamicResource Brush.Accent}"
                                 Style="{StaticResource AspectBar}"
                                 Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding SkillProgress}"
                               FontFamily="Georgia"
                               FontSize="10"
                               Foreground="{DynamicResource Brush.Muted}"/>
                </StackPanel>
            </Border>

            <!-- Knowledge -->
            <Border Grid.Column="2"
                    Background="{DynamicResource Brush.HudBodyGradient}"
                    BorderBrush="{DynamicResource Brush.Gold}"
                    BorderThickness="1"
                    CornerRadius="2"
                    Padding="12,10"
                    Effect="{StaticResource Effect.PanelShadow}">
                <StackPanel>
                    <TextBlock Text="{Binding KnowledgeLabel}"
                               FontFamily="Georgia"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Accent}"
                               Margin="0,0,0,4"/>
                    <ProgressBar Value="{Binding KnowledgeFraction, Mode=OneWay}"
                                 Maximum="1"
                                 Foreground="{DynamicResource Brush.Accent}"
                                 Style="{StaticResource AspectBar}"
                                 Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding KnowledgeProgress}"
                               FontFamily="Georgia"
                               FontSize="10"
                               Foreground="{DynamicResource Brush.Muted}"/>
                </StackPanel>
            </Border>

            <!-- Fame -->
            <Border Grid.Column="4"
                    Background="{DynamicResource Brush.HudBodyGradient}"
                    BorderBrush="{DynamicResource Brush.Gold}"
                    BorderThickness="1"
                    CornerRadius="2"
                    Padding="12,10"
                    Effect="{StaticResource Effect.PanelShadow}">
                <StackPanel>
                    <TextBlock Text="{Binding FameLabel}"
                               FontFamily="Georgia"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Gold}"
                               Margin="0,0,0,4"/>
                    <ProgressBar Value="{Binding FameFraction, Mode=OneWay}"
                                 Maximum="1"
                                 Foreground="{DynamicResource Brush.Gold}"
                                 Style="{StaticResource AspectBar}"
                                 Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding FameProgress}"
                               FontFamily="Georgia"
                               FontSize="10"
                               Foreground="{DynamicResource Brush.Muted}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Toggle active job button -->
        <Button Grid.Row="6"
                Content="{Binding ActiveButtonLabel}"
                Command="{Binding ToggleActiveCommand}"
                HorizontalAlignment="Right"
                Cursor="Hand"
                Padding="16,8"
                FontFamily="Georgia"
                FontSize="13">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{DynamicResource Brush.PanelDark}"
                            BorderBrush="{DynamicResource Brush.Gold}"
                            BorderThickness="1"
                            CornerRadius="2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <Button.Foreground>
                <DynamicResource ResourceKey="Brush.Foreground"/>
            </Button.Foreground>
        </Button>
    </Grid>
</Page>
