<Page x:Class="Myria.Wpf.View.Pages.Game.IngameWindow.NpcInteraction.DialogPanel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Myria.Wpf.View.Pages.Game.IngameWindow.NpcInteraction"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Background="Transparent"
      Title="DialogPanel">

    <Border Background="{DynamicResource Brush.HudBodyGradient}"
            BorderBrush="{DynamicResource Brush.Gold}"
            BorderThickness="1"
            CornerRadius="2"
            Padding="14,10,14,12"
            Effect="{StaticResource Effect.PanelShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Dialog text -->
            <TextBlock Text="{Binding DialogText}"
                       Foreground="{DynamicResource Brush.Foreground}"
                       FontFamily="Georgia"
                       FontSize="14"
                       TextWrapping="Wrap"
                       VerticalAlignment="Top"/>

            <!-- Divider -->
            <Rectangle Grid.Row="1"
                       Height="1"
                       Fill="{DynamicResource Brush.Gold}"
                       Opacity="0.3"
                       Margin="0,10,0,10"/>

            <!-- Service buttons -->
            <ItemsControl Grid.Row="2"
                          ItemsSource="{Binding ServiceOptions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding Command}"
                                Padding="12,8"
                                Style="{StaticResource NpcDialogButton}"
                                Margin="6"
                                MinWidth="160">
                            <StackPanel>
                                <TextBlock Text="{Binding Text}"
                                           FontFamily="Georgia"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.GoldSoft}"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</Page>
