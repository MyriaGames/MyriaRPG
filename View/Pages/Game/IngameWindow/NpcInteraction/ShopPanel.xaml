<Page x:Class="Myria.Wpf.View.Pages.Game.IngameWindow.NpcInteraction.ShopPanel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Myria.Wpf.View.Pages.Game.IngameWindow.NpcInteraction"
      mc:Ignorable="d"
      d:DesignHeight="750" d:DesignWidth="800"
      Background="Transparent"
      Title="ShopPanel">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="InventorySlotStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.PanelDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="AllowDrop" Value="True"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.BlueActive}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Shop item hover tooltip -->
        <Popup x:Name="ShopItemTooltipPopup"
               IsOpen="{Binding IsShopTooltipVisible}"
               Placement="Custom"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               StaysOpen="True"
               IsHitTestVisible="False">
            <Border Background="{DynamicResource Brush.HudBodyGradient}"
                    BorderBrush="{DynamicResource Brush.Gold}"
                    BorderThickness="1"
                    CornerRadius="2"
                    Padding="12,10"
                    MaxWidth="260"
                    Effect="{StaticResource Effect.HudShadow}">
                <StackPanel DataContext="{Binding CurrentShopTooltip}">
                    <TextBlock Text="{Binding ItemName}"
                               FontFamily="Georgia" FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Foreground}"
                               TextWrapping="Wrap" Margin="0,0,0,3"/>
                    <TextBlock Text="{Binding ItemRarity}"
                               FontFamily="Georgia" FontSize="10" FontWeight="Bold"
                               Foreground="{Binding RarityColor}" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding ItemType}"
                               FontFamily="Georgia" FontSize="10"
                               Foreground="{DynamicResource Brush.GoldSoft}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding ClassText}"
                               Visibility="{Binding HasClassInfo, Converter={StaticResource BoolToVisibilityConverter}}"
                               Foreground="{Binding ClassColor}"
                               FontFamily="Georgia" FontSize="10"
                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <Rectangle Height="1" Fill="{DynamicResource Brush.Gold}" Opacity="0.3" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding ItemStats}"
                               FontFamily="Georgia" FontSize="10"
                               Foreground="{DynamicResource Brush.Foreground}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Popup>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,0,0" Orientation="Vertical">

                <!-- Page header -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Title}"
                               FontFamily="Georgia"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Brush.GoldSoft}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding CharacterMoneyText}"
                               FontFamily="Georgia"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Gold}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <Rectangle Grid.Column="2"
                               Height="1"
                               Fill="{DynamicResource Brush.Gold}"
                               Opacity="0.3"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Main content: two columns -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: BUY SECTION -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource Brush.HudBodyGradient}"
                            BorderBrush="{DynamicResource Brush.Gold}"
                            BorderThickness="1"
                            CornerRadius="2"
                            Padding="12,10"
                            Effect="{StaticResource Effect.PanelShadow}">
                        <StackPanel Orientation="Vertical">

                            <!-- Stock section header -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding StockLabel}"
                                           FontFamily="Georgia"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.GoldSoft}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <Rectangle Grid.Column="1"
                                           Height="1"
                                           Fill="{DynamicResource Brush.Gold}"
                                           Opacity="0.3"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Filter tabs -->
                            <Border BorderBrush="{DynamicResource Brush.Gold}"
                                    BorderThickness="0,0,0,1"
                                    Opacity="0.9"
                                    Margin="0,0,0,10">
                                <UniformGrid Rows="1">
                                    <Button Content="{Binding LblWeapons}"
                                            Tag="&#x2694;"
                                            Command="{Binding FilterWeaponsCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ShopFilterTabButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFilter_Weapons}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.BlueActive}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Gold}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="{Binding LblArmor}"
                                            Tag="&#x26E8;"
                                            Command="{Binding FilterArmorCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ShopFilterTabButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFilter_Armor}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.BlueActive}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Gold}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="{Binding LblAccessories}"
                                            Tag="&#x2748;"
                                            Command="{Binding FilterAccessoriesCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ShopFilterTabButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFilter_Accessories}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.BlueActive}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Gold}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="{Binding LblUtilities}"
                                            Tag="&#x2692;"
                                            Command="{Binding FilterUtilitiesCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ShopFilterTabButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFilter_Utilities}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.BlueActive}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Gold}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="{Binding LblBuyback}"
                                            Tag="&#x21A9;"
                                            Command="{Binding FilterBuybackCommand}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ShopFilterTabButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFilter_Buyback}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.BlueActive}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Gold}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </UniformGrid>
                            </Border>

                            <!-- Shop items list -->
                            <ListBox ItemsSource="{Binding FilteredStock}"
                                     SelectedItem="{Binding SelectedStock}"
                                     ItemContainerStyle="{StaticResource NpcListItem}"
                                     Background="{x:Null}"
                                     BorderThickness="0"
                                     Height="180"
                                     Margin="0,0,0,10"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Background="Transparent"
                                              MouseEnter="ShopItem_MouseEnter"
                                              MouseLeave="ShopItem_MouseLeave">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           FontFamily="Georgia"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource Brush.GoldSoft}"/>
                                                <TextBlock FontFamily="Georgia" FontSize="11" Foreground="{DynamicResource Brush.Gold}">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0}: {1}">
                                                            <Binding Path="DataContext.StockPriceLabel" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                                            <Binding Path="BuyPrice"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Selected item details -->
                            <Border Background="{DynamicResource Brush.PanelDark}"
                                    BorderBrush="{DynamicResource Brush.Gold}"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    Padding="10"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedStockName}"
                                               FontFamily="Georgia"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.Foreground}"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding SelectedStockPrice}"
                                               FontFamily="Georgia"
                                               FontSize="11"
                                               Foreground="{DynamicResource Brush.GoldSoft}"
                                               Margin="0,0,0,6"/>
                                    <TextBlock FontFamily="Georgia" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Gold}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}: {1}">
                                                <Binding Path="TotalLabel"/>
                                                <Binding Path="BuyTotalPrice"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Quantity control -->
                            <StackPanel Margin="0,0,0,10"
                                        Visibility="{Binding IsQuantityControlVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding QuantityLabel}"
                                           FontFamily="Georgia"
                                           FontSize="11"
                                           Foreground="{DynamicResource Brush.GoldSoft}"
                                           Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="−"
                                            Command="{Binding DecreaseBuyQtyCommand}"
                                            Style="{StaticResource ShopQtyButton}"
                                            Width="30" Padding="0" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding BuyQuantity}"
                                               FontFamily="Georgia"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.Foreground}"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               Width="40"
                                               Margin="0,0,5,0"/>
                                    <Button Content="+"
                                            Command="{Binding IncreaseBuyQtyCommand}"
                                            Style="{StaticResource ShopQtyButton}"
                                            Width="30" Padding="0" Margin="0,0,5,0"/>
                                    <Button Content="{Binding MaxLabel}"
                                            Command="{Binding MaxBuyQtyCommand}"
                                            Style="{StaticResource ShopQtyButton}"
                                            FontSize="11"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Buy button -->
                            <Button Content="{Binding BtnBuy}"
                                    Command="{Binding BuyCommand}"
                                    IsEnabled="{Binding CanBuy}"
                                    Style="{StaticResource ShopPrimaryButton}"/>
                        </StackPanel>
                    </Border>

                    <!-- RIGHT: SELL SECTION (Inventory) -->
                    <Grid Grid.Column="2" x:Name="InventorySection">
                        <StackPanel>
                            <!-- Inventory panel -->
                            <Border Background="{DynamicResource Brush.HudBodyGradient}"
                                    BorderBrush="{DynamicResource Brush.Gold}"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    Padding="12,10"
                                    Effect="{StaticResource Effect.PanelShadow}">
                                <StackPanel>
                                    <!-- Inventory section header -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding InventoryTitle}"
                                                   FontFamily="Georgia"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush.GoldSoft}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                                        <Rectangle Grid.Column="1"
                                                   Height="1"
                                                   Fill="{DynamicResource Brush.Gold}"
                                                   Opacity="0.3"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Item grid -->
                                    <ItemsControl ItemsSource="{Binding InventoryItems}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="64"/>
                                                        <ColumnDefinition Width="64"/>
                                                        <ColumnDefinition Width="64"/>
                                                        <ColumnDefinition Width="64"/>
                                                        <ColumnDefinition Width="64"/>
                                                        <ColumnDefinition Width="64"/>
                                                        <ColumnDefinition Width="64"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="64"/>
                                                        <RowDefinition Height="64"/>
                                                        <RowDefinition Height="64"/>
                                                        <RowDefinition Height="64"/>
                                                        <RowDefinition Height="64"/>
                                                        <RowDefinition Height="64"/>
                                                        <RowDefinition Height="64"/>
                                                    </Grid.RowDefinitions>
                                                </Grid>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Grid.Column" Value="{Binding GridColumn}"/>
                                                <Setter Property="Grid.Row" Value="{Binding GridRow}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource InventorySlotStyle}"
                                                        BorderBrush="{Binding RarityBrush}"
                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        AllowDrop="True"
                                                        Drop="InventorySlot_Drop"
                                                        DragOver="InventorySlot_DragOver"
                                                        PreviewMouseLeftButtonDown="InventorySlot_PreviewMouseLeftButtonDown"
                                                        MouseEnter="InventorySlot_MouseEnter"
                                                        MouseLeave="InventorySlot_MouseLeave">
                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="{Binding PlacementTarget.DataContext.SellOneText, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      Command="{Binding PlacementTarget.Tag.SellOneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                            <MenuItem Header="{Binding PlacementTarget.DataContext.SellStackText, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      Command="{Binding PlacementTarget.Tag.SellStackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      Visibility="{Binding PlacementTarget.DataContext.IsStack, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <Grid Background="Transparent">
                                                        <ContentControl Content="{Binding Item}" Style="{StaticResource IconSwitcherStyle}" Margin="2"/>
                                                        <!-- Stack count badge -->
                                                        <Border Background="#AA030506"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Bottom"
                                                                CornerRadius="2"
                                                                Margin="0,0,3,3"
                                                                Padding="3,1">
                                                            <TextBlock Text="{Binding Item.StackSize}"
                                                                       Foreground="{DynamicResource Brush.GoldSoft}"
                                                                       FontFamily="Georgia"
                                                                       FontSize="10"
                                                                       FontWeight="Bold"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Money bag -->
                            <Border x:Name="MoneyBagSection"
                                    Background="{DynamicResource Brush.HudBodyGradient}"
                                    BorderBrush="{DynamicResource Brush.Gold}"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    Padding="14,10,14,12"
                                    Margin="0,8,0,0"
                                    Effect="{StaticResource Effect.PanelShadow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding MoneyBagTitle}"
                                               FontFamily="Georgia"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.GoldSoft}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding MoneyDisplay}"
                                               FontFamily="Georgia"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.Gold}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Inventory item tooltip -->
                        <Popup x:Name="ItemTooltipPopup"
                               IsOpen="{Binding IsTooltipVisible}"
                               Placement="Custom"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               StaysOpen="True"
                               IsHitTestVisible="False">
                            <Border Background="{DynamicResource Brush.HudBodyGradient}"
                                    BorderBrush="{DynamicResource Brush.Gold}"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    Padding="12,10"
                                    MaxWidth="260"
                                    Effect="{StaticResource Effect.HudShadow}">
                                <StackPanel DataContext="{Binding CurrentTooltip}">
                                    <TextBlock Text="{Binding ItemName}"
                                               FontFamily="Georgia" FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.Foreground}"
                                               TextWrapping="Wrap" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding ItemRarity}"
                                               FontFamily="Georgia" FontSize="10" FontWeight="Bold"
                                               Foreground="{Binding RarityColor}" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding ItemType}"
                                               FontFamily="Georgia" FontSize="10"
                                               Foreground="{DynamicResource Brush.GoldSoft}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding ClassText}"
                                               Visibility="{Binding HasClassInfo, Converter={StaticResource BoolToVisibilityConverter}}"
                                               Foreground="{Binding ClassColor}"
                                               FontFamily="Georgia" FontSize="10"
                                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <Rectangle Height="1" Fill="{DynamicResource Brush.Gold}" Opacity="0.3" Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding ItemStats}"
                                               FontFamily="Georgia" FontSize="10"
                                               Foreground="{DynamicResource Brush.Foreground}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </Grid>

                <!-- Status message -->
                <Border Background="{DynamicResource Brush.HudBodyGradient}"
                        BorderBrush="{DynamicResource Brush.Gold}"
                        BorderThickness="1"
                        CornerRadius="2"
                        Padding="12,10"
                        Margin="0,12,0,0"
                        Effect="{StaticResource Effect.PanelShadow}">
                    <TextBlock Text="{Binding StatusMessage}"
                               FontFamily="Georgia"
                               FontSize="12"
                               Foreground="{DynamicResource Brush.Muted}"
                               TextWrapping="Wrap"
                               MinHeight="36"/>
                </Border>

                <!-- Back button -->
                <Button Content="{Binding BtnBack}"
                        Command="{Binding BackCommand}"
                        Style="{StaticResource ShopQtyButton}"
                        Padding="15,0"
                        Margin="0,10,0,12"
                        HorizontalAlignment="Right"
                        Width="120"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
