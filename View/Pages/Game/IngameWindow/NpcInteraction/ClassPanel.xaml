<Page x:Class="Myria.Wpf.View.Pages.Game.IngameWindow.NpcInteraction.ClassPanel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="AspectBar" TargetType="ProgressBar">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="4"/>
            <Setter Property="Background" Value="{DynamicResource Brush.PanelDark}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border CornerRadius="2" Background="{TemplateBinding Background}">
                            <Border x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        CornerRadius="2"
                                        Background="{TemplateBinding Foreground}"
                                        HorizontalAlignment="Left"/>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="←"
                    Command="{Binding GoBackCommand}"
                    Foreground="{DynamicResource Brush.GoldSoft}"
                    Background="Transparent"
                    BorderThickness="0"
                    FontFamily="Georgia"
                    FontSize="16"
                    Cursor="Hand"
                    Padding="4,0,12,0"/>

            <TextBlock Grid.Column="1"
                       Text="{Binding Title}"
                       FontFamily="Georgia"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Brush.GoldSoft}"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <Rectangle Grid.Column="2"
                       Height="1"
                       Fill="{DynamicResource Brush.Gold}"
                       Opacity="0.3"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <!-- Active class badge -->
            <Border Grid.Column="3"
                    Background="{DynamicResource Brush.PanelDark}"
                    BorderBrush="{DynamicResource Brush.Gold}"
                    BorderThickness="1"
                    CornerRadius="2"
                    Padding="8,3"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding CurrentClass}"
                               FontFamily="Georgia"
                               FontSize="11"
                               Foreground="{DynamicResource Brush.Accent}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text=" · "
                               FontFamily="Georgia"
                               FontSize="11"
                               Foreground="{DynamicResource Brush.Muted}"/>
                    <TextBlock Text="{Binding CurrentLevel}"
                               FontFamily="Georgia"
                               FontSize="11"
                               Foreground="{DynamicResource Brush.Muted}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Notices -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="{Binding PenaltyInfo}"
                       FontFamily="Georgia"
                       FontSize="12"
                       Foreground="{DynamicResource Brush.Muted}"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{Binding TransferInfo}"
                       FontFamily="Georgia"
                       FontSize="12"
                       Foreground="{DynamicResource Brush.Muted}"
                       TextWrapping="Wrap"
                       Margin="0,3,0,0"/>
            <TextBlock Text="{Binding CooldownText}"
                       FontFamily="Georgia"
                       FontSize="12"
                       Foreground="Salmon"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"
                       Visibility="{Binding IsCooldownActive, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <!-- Class list -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Classes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Brush.HudBodyGradient}"
                                BorderBrush="{DynamicResource Brush.Gold}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Padding="12,10"
                                Margin="0,0,0,6"
                                Effect="{StaticResource Effect.PanelShadow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Name + level + progress -->
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Name}"
                                                   FontFamily="Georgia"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Foreground}"/>
                                        <Border Background="{DynamicResource Brush.PanelDark}"
                                                BorderBrush="{DynamicResource Brush.Gold}"
                                                BorderThickness="1"
                                                CornerRadius="2"
                                                Padding="5,1"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding GroupLabel}"
                                                       FontFamily="Georgia"
                                                       FontSize="9"
                                                       Foreground="{DynamicResource Brush.Muted}"/>
                                        </Border>
                                        <Border Background="{DynamicResource Brush.PanelDark}"
                                                BorderBrush="{DynamicResource Brush.Gold}"
                                                BorderThickness="1"
                                                CornerRadius="2"
                                                Padding="5,1"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="●"
                                                       FontSize="9"
                                                       Foreground="{DynamicResource Brush.Accent}"/>
                                        </Border>
                                    </StackPanel>
                                    <ProgressBar Value="{Binding ProgressFraction, Mode=OneWay}"
                                                 Maximum="1"
                                                 Foreground="{DynamicResource Brush.Accent}"
                                                 Style="{StaticResource AspectBar}"
                                                 Margin="0,0,0,3"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ClassLevel, StringFormat='Lv. {0}'}"
                                                   FontFamily="Georgia"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource Brush.Accent}"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding ProgressText}"
                                                   FontFamily="Georgia"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource Brush.Muted}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Forbidden label / Select button -->
                                <Grid Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ForbiddenLabel}"
                                               FontFamily="Georgia"
                                               FontSize="11"
                                               Foreground="{DynamicResource Brush.Muted}"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAllowed}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Button Command="{Binding SelectCommand}"
                                            Cursor="Hand"
                                            Padding="12,6"
                                            FontFamily="Georgia"
                                            FontSize="12">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAllowed}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        CornerRadius="2"
                                                        BorderThickness="1"
                                                        Padding="{TemplateBinding Padding}">
                                                    <Border.BorderBrush>
                                                        <DynamicResource ResourceKey="Brush.Gold"/>
                                                    </Border.BorderBrush>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.PanelDark}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock Text="{Binding ButtonLabel}"
                                                   FontFamily="Georgia"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Brush.Foreground}"/>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
