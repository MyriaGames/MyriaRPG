<Page x:Class="Myria.Wpf.View.Pages.Settings.Page_SettingsVisuals"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="820"
      d:DesignWidth="1280"
      Background="Transparent"
      Title="Page_SettingsVisuals">

    <Page.Resources>
        <DropShadowEffect x:Key="VisualGlow" BlurRadius="18" ShadowDepth="0" Opacity="0.55" Color="{DynamicResource Color.Gold}"/>

        <Style x:Key="VisualHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.GoldSoft}"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="44"/>
        </Style>

        <Style x:Key="VisualSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.GoldSoft}"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="VisualBodyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="VisualSettingsPanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.MainPanelGradient}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="26"/>
            <Setter Property="Effect" Value="{StaticResource Effect.PanelShadow}"/>
        </Style>

        <Style x:Key="VisualChoiceButton" TargetType="RadioButton">
            <Setter Property="MinHeight" Value="54"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.GoldSoft}"/>
            <Setter Property="Background" Value="{DynamicResource Brush.PanelDark}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.BlueActive}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Brush.GoldSoft}"/>
                    <Setter Property="Effect" Value="{StaticResource VisualGlow}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.NavHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VisualComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="54"/>
            <Setter Property="Background" Value="{DynamicResource Brush.PanelDark}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MaxDropDownHeight" Value="260"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="{DynamicResource Brush.PanelDark}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="14,10"/>
                        <Setter Property="FontFamily" Value="Georgia"/>
                        <Setter Property="FontSize" Value="18"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{DynamicResource Brush.Gold}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            TextElement.Foreground="{TemplateBinding Foreground}">
                                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                                          VerticalAlignment="Center"
                                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.NavHover}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.NavHover}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Foreground="{TemplateBinding Foreground}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="2"
                                                TextElement.Foreground="{TemplateBinding Foreground}">
                                            <Grid>
                                                <TextBlock Margin="14,0,44,0"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Brush.Foreground}"
                                                           FontFamily="Georgia"
                                                           FontSize="18"
                                                           Text="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                                <Path Data="M 0 0 L 5 5 L 10 0 Z"
                                                      Fill="{DynamicResource Brush.GoldSoft}"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,16,0"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide"
                                   MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="{DynamicResource Brush.PanelDark}"
                                        BorderBrush="{DynamicResource Brush.Gold}"
                                        BorderThickness="1"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer Background="{DynamicResource Brush.PanelDark}"
                                                  CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Border Background="{DynamicResource Brush.WindowBackgroundGradient}"
            BorderBrush="{DynamicResource Brush.Gold}"
            BorderThickness="1">

        <Grid Margin="34,24,34,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Ellipse Grid.RowSpan="2"
                     Width="420"
                     Height="420"
                     Stroke="{DynamicResource Brush.Gold}"
                     StrokeThickness="1"
                     Opacity="0.22"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Margin="0,-120,-80,0"/>
            <Ellipse Grid.RowSpan="2"
                     Width="280"
                     Height="280"
                     Stroke="{DynamicResource Brush.Gold}"
                     StrokeThickness="1"
                     Opacity="0.17"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Margin="0,-52,-8,0"/>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="{Binding TblVisualsTitle}" Style="{StaticResource VisualHeaderText}"/>
                <TextBlock Text="{Binding TblVisualsDescription}"
                           Foreground="{DynamicResource Brush.GoldSoft}"
                           FontFamily="Georgia"
                           FontStyle="Italic"
                           FontSize="17"
                           Margin="34,8,0,0"/>
                <Grid Width="440" HorizontalAlignment="Left" Margin="18,14,0,0">
                    <Rectangle Height="1" Fill="{DynamicResource Brush.Gold}" Opacity="0.65"/>
                    <TextBlock Text="&#x25C7;"
                               Foreground="{DynamicResource Brush.GoldSoft}"
                               FontFamily="Segoe UI Symbol"
                               FontSize="24"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,-17,0,0"/>
                </Grid>
            </StackPanel>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,12,0">
                <StackPanel>
                    <Border Style="{StaticResource VisualSettingsPanel}" Margin="0,0,0,18">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,18">
                                <TextBlock Text="&#x25CF;"
                                           Foreground="{DynamicResource Brush.GoldSoft}"
                                           FontFamily="Segoe UI Symbol"
                                           FontSize="34"
                                           DockPanel.Dock="Left"
                                           Margin="0,0,18,0"/>
                                <TextBlock Text="{Binding TblLanguage}"
                                           Style="{StaticResource VisualSectionTitle}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <Grid Margin="0,0,0,18">
                                <Rectangle Height="1" Fill="{DynamicResource Brush.Gold}" Opacity="0.65" VerticalAlignment="Center"/>
                                <TextBlock Text="&#x25C7;"
                                           Foreground="{DynamicResource Brush.GoldSoft}"
                                           FontFamily="Segoe UI Symbol"
                                           FontSize="18"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,-13,0,0"/>
                            </Grid>

                            <TextBlock Text="{Binding TblGameLanguage}" Style="{StaticResource VisualBodyText}" Margin="0,0,0,10"/>

                            <ComboBox Style="{StaticResource VisualComboBox}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding SelectedLanguage}"
                                      ItemsSource="{Binding Languages}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource VisualSettingsPanel}" Margin="0,0,0,18">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,18">
                                <TextBlock Text="&#x263C;"
                                           Foreground="{DynamicResource Brush.GoldSoft}"
                                           FontFamily="Segoe UI Symbol"
                                           FontSize="34"
                                           DockPanel.Dock="Left"
                                           Margin="0,0,18,0"/>
                                <TextBlock Text="{Binding TblAppearance}"
                                           Style="{StaticResource VisualSectionTitle}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <Grid Margin="0,0,0,18">
                                <Rectangle Height="1" Fill="{DynamicResource Brush.Gold}" Opacity="0.65" VerticalAlignment="Center"/>
                                <TextBlock Text="&#x25C7;"
                                           Foreground="{DynamicResource Brush.GoldSoft}"
                                           FontFamily="Segoe UI Symbol"
                                           FontSize="18"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,-13,0,0"/>
                            </Grid>

                            <TextBlock Text="{Binding DarkMode}" Style="{StaticResource VisualBodyText}" Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <RadioButton Grid.Column="0"
                                             IsChecked="{Binding DarkModeSetter, Mode=TwoWay}"
                                             Style="{StaticResource VisualChoiceButton}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#x263E;" FontFamily="Segoe UI Symbol" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding DarkMidnightMode}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Grid.Column="2"
                                             IsChecked="{Binding LightModeSetter, Mode=TwoWay}"
                                             Style="{StaticResource VisualChoiceButton}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#x263C;" FontFamily="Segoe UI Symbol" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding TblLightMode}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </RadioButton>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource VisualSettingsPanel}" Margin="0,0,0,18">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,18">
                                <TextBlock Text="&#x25AD;"
                                           Foreground="{DynamicResource Brush.GoldSoft}"
                                           FontFamily="Segoe UI Symbol"
                                           FontSize="34"
                                           DockPanel.Dock="Left"
                                           Margin="0,0,18,0"/>
                                <TextBlock Text="{Binding TblDisplay}"
                                           Style="{StaticResource VisualSectionTitle}"
                                           VerticalAlignment="Center"/>
                            </DockPanel>

                            <Grid Margin="0,0,0,18">
                                <Rectangle Height="1" Fill="{DynamicResource Brush.Gold}" Opacity="0.65" VerticalAlignment="Center"/>
                                <TextBlock Text="&#x25C7;"
                                           Foreground="{DynamicResource Brush.GoldSoft}"
                                           FontFamily="Segoe UI Symbol"
                                           FontSize="18"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,-13,0,0"/>
                            </Grid>

                            <TextBlock Text="{Binding FullScreen}" Style="{StaticResource VisualBodyText}" Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <RadioButton Grid.Column="0"
                                             IsChecked="{Binding FullScreenSetter, Mode=TwoWay}"
                                             Style="{StaticResource VisualChoiceButton}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#x26F6;" FontFamily="Segoe UI Symbol" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding FullScreenCheck}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Grid.Column="2"
                                             IsChecked="{Binding WindowedModeSetter, Mode=TwoWay}"
                                             Style="{StaticResource VisualChoiceButton}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#x25AD;" FontFamily="Segoe UI Symbol" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding TblWindowed}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </RadioButton>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Page>
