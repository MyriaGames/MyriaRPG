<Page x:Class="Myria.Wpf.View.Pages.Settings.Page_SettingsLanguage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Myria.Wpf.View.Pages.Settings"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page_SettingsLanguage">

    <StackPanel Margin="0,8,0,0">
        <TextBlock x:Name="tbl_Language"
                   Text="{Binding TblLanguage}"
                   FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Foreground}"
                   Margin="0,0,0,6"/>
        <ComboBox x:Name="cbx_Language"
                  Width="200"
                  HorizontalAlignment="Left"
                  FontSize="14"
                  DisplayMemberPath="DisplayName"
                  SelectedItem="{Binding SelectedLanguage}"
                  ItemsSource="{Binding Languages}"/>
    </StackPanel>
</Page>
