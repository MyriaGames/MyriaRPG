<Page x:Class="Myria.Wpf.View.Pages.Settings.Page_SettingsMods"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="820"
      d:DesignWidth="1280"
      Background="Transparent"
      Title="Page_SettingsMods">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <DropShadowEffect x:Key="ModsGoldGlow" BlurRadius="16" ShadowDepth="0" Opacity="0.45" Color="{DynamicResource Color.Gold}"/>

        <Style x:Key="ModsHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.GoldSoft}"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="44"/>
        </Style>

        <Style x:Key="ModsBodyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="ModsColumnHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.GoldSoft}"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModsIconButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.GoldSoft}"/>
            <Setter Property="Background" Value="{DynamicResource Brush.PanelDark}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.NavHover}"/>
                                <Setter Property="Effect" Value="{StaticResource ModsGoldGlow}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModsActionButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="118"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.GoldSoft}"/>
            <Setter Property="Background" Value="{DynamicResource Brush.BlueActive}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.NavHover}"/>
                                <Setter Property="Effect" Value="{StaticResource ModsGoldGlow}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModsSortButton" TargetType="RadioButton">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="128"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
            <Setter Property="Background" Value="{DynamicResource Brush.PanelDark}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BlueActive}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.GoldSoft}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.NavHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModsOrderTextBox" TargetType="TextBox">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="{DynamicResource Brush.PanelDark}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.GoldSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.GoldSoft}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Brush.BlueActive}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="6,0"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BlueActive}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.GoldSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModsActiveSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Brush.GoldSoft}"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel HorizontalAlignment="Center">
                            <Border x:Name="SwitchTrack"
                                    Width="48"
                                    Height="24"
                                    Background="{DynamicResource Brush.PanelDark}"
                                    BorderBrush="{DynamicResource Brush.Gold}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    HorizontalAlignment="Center">
                                <Grid>
                                    <Ellipse x:Name="SwitchThumb"
                                             Width="16"
                                             Height="16"
                                             Fill="{DynamicResource Brush.Muted}"
                                             HorizontalAlignment="Left"
                                             Margin="4,0,0,0"/>
                                </Grid>
                            </Border>
                            <ContentPresenter Margin="0,5,0,0"
                                              HorizontalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource Brush.BlueActive}"/>
                                <Setter TargetName="SwitchThumb" Property="Fill" Value="{DynamicResource Brush.GoldSoft}"/>
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,4,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource Brush.GoldSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thumb used by the gradient slider tracks below -->
        <Style x:Key="ColorPickerThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Width="14" Height="26"
                                CornerRadius="3"
                                Background="{DynamicResource Brush.PanelDark}"
                                BorderBrush="{DynamicResource Brush.GoldSoft}"
                                BorderThickness="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A Slider whose track background is set via the Background property. -->
        <Style x:Key="GradientSlider" TargetType="Slider">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="18" CornerRadius="9"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" Margin="9,0">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Height="18" Opacity="0"
                                                  Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ColorPickerThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Height="18" Opacity="0"
                                                  Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModsLinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Brush.GoldSoft}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Gold}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Border Background="{DynamicResource Brush.WindowBackgroundGradient}"
            BorderBrush="{DynamicResource Brush.Gold}"
            BorderThickness="1">

        <Grid Margin="34,24,34,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <!-- Detail panel: present only when a mod with settings is selected -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Ellipse Grid.Column="0" Width="420"
                     Height="420"
                     Stroke="{DynamicResource Brush.Gold}"
                     StrokeThickness="1"
                     Opacity="0.22"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Margin="0,-126,-80,0"/>
            <Ellipse Grid.Column="0" Width="280"
                     Height="280"
                     Stroke="{DynamicResource Brush.Gold}"
                     StrokeThickness="1"
                     Opacity="0.16"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Margin="0,-58,-10,0"/>

            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,18">
                <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource ModsHeaderText}"/>
                <TextBlock Text="{Binding TblDescription}"
                           Foreground="{DynamicResource Brush.GoldSoft}"
                           FontFamily="Georgia"
                           FontStyle="Italic"
                           FontSize="17"
                           Margin="34,8,0,0"/>
                <Grid Width="440" HorizontalAlignment="Left" Margin="18,14,0,0">
                    <Rectangle Height="1" Fill="{DynamicResource Brush.Gold}" Opacity="0.65"/>
                    <TextBlock Text="&#x25C7;"
                               Foreground="{DynamicResource Brush.GoldSoft}"
                               FontFamily="Segoe UI Symbol"
                               FontSize="24"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,-17,0,0"/>
                </Grid>
            </StackPanel>

            <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14" LastChildFill="False">
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource ModsActionButton}"
                        Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x21BA;" FontFamily="Segoe UI Symbol" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding TblRefresh}"/>
                    </StackPanel>
                </Button>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TblSort}"
                               Style="{StaticResource ModsBodyText}"
                               Foreground="{DynamicResource Brush.GoldSoft}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <RadioButton Content="{Binding TblSortLoadOrder}"
                                 GroupName="ModSort"
                                 IsChecked="{Binding SortByLoadOrder, Mode=TwoWay}"
                                 Style="{StaticResource ModsSortButton}"/>
                    <RadioButton Content="{Binding TblSortName}"
                                 GroupName="ModSort"
                                 IsChecked="{Binding SortByName, Mode=TwoWay}"
                                 Style="{StaticResource ModsSortButton}"
                                 Margin="8,0,0,0"/>
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="2" Grid.Column="0"
                    Background="{DynamicResource Brush.MainPanelGradient}"
                    BorderBrush="{DynamicResource Brush.Gold}"
                    BorderThickness="1"
                    Effect="{StaticResource Effect.PanelShadow}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="104"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,1"/>
                    <Border Grid.Row="0" Grid.Column="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,1">
                        <TextBlock Text="{Binding TblColumnPosition}" Style="{StaticResource ModsColumnHeaderText}"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,1">
                        <TextBlock Text="{Binding TblColumnLoadOrder}" Style="{StaticResource ModsColumnHeaderText}"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="3" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,1">
                        <TextBlock Text="{Binding TblColumnMod}" Style="{StaticResource ModsColumnHeaderText}" HorizontalAlignment="Left" Margin="24,0,0,0"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="4" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,1">
                        <TextBlock Text="{Binding TblColumnType}" Style="{StaticResource ModsColumnHeaderText}"/>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="5" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                        <TextBlock Text="{Binding TblColumnActive}" Style="{StaticResource ModsColumnHeaderText}"/>
                    </Border>

                    <TextBlock Grid.Row="1"
                               Grid.ColumnSpan="6"
                               Text="{Binding TblEmpty}"
                               Style="{StaticResource ModsBodyText}"
                               Foreground="{DynamicResource Brush.Muted}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding EmptyVisibility}"/>

                    <ScrollViewer Grid.Row="1"
                                  Grid.ColumnSpan="6"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding ModsVisibility}">
                        <ItemsControl ItemsSource="{Binding Mods}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="78">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="104"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.ColumnSpan="6" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"/>

                                        <StackPanel Grid.Column="0"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <Button Content="&#x25B2;"
                                                    Style="{StaticResource ModsIconButton}"
                                                    Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding CanMoveUp}"
                                                    ToolTip="{Binding DataContext.TblMoveUp, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                            <Button Content="&#x25BC;"
                                                    Style="{StaticResource ModsIconButton}"
                                                    Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding CanMoveDown}"
                                                    Margin="6,0,0,0"
                                                    ToolTip="{Binding DataContext.TblMoveDown, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding LoadPosition}"
                                                   Style="{StaticResource ModsBodyText}"
                                                   Foreground="{DynamicResource Brush.GoldSoft}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"/>

                                        <TextBox Grid.Column="2"
                                                 Style="{StaticResource ModsOrderTextBox}"
                                                 Text="{Binding LoadOrder, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="24,8,20,8">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource ModsLinkButton}"
                                                        Command="{Binding DataContext.OpenModDetailsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="{Binding Name}"
                                                               Style="{StaticResource ModsBodyText}"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                               FontSize="18"
                                                               FontWeight="Bold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Button>
                                                <TextBlock Text="{Binding VersionText}"
                                                           Style="{StaticResource ModsBodyText}"
                                                           Foreground="{DynamicResource Brush.Muted}"
                                                           Margin="10,2,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <!-- Warning indicator — visible when mod has validation issues -->
                                                <TextBlock Text="&#x26A0;"
                                                           FontFamily="Segoe UI Symbol"
                                                           FontSize="16"
                                                           Foreground="#FFCC00"
                                                           Margin="10,1,0,0"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock.ToolTip>
                                                        <ToolTip>
                                                            <TextBlock Text="{Binding WarningText}" MaxWidth="380" TextWrapping="Wrap"/>
                                                        </ToolTip>
                                                    </TextBlock.ToolTip>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Text="{Binding AuthorText}"
                                                       Style="{StaticResource ModsBodyText}"
                                                       Foreground="{DynamicResource Brush.Muted}"
                                                       FontSize="14"
                                                       Margin="0,4,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Description}"
                                                       Style="{StaticResource ModsBodyText}"
                                                       FontSize="14"
                                                       Margin="0,4,0,0"
                                                       MaxHeight="38"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <Border Grid.Column="4"
                                                MinWidth="96"
                                                Height="34"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource Brush.PanelDark}"
                                                BorderBrush="{DynamicResource Brush.Gold}"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                            <TextBlock Text="{Binding TypeLabel}"
                                                       Style="{StaticResource ModsBodyText}"
                                                       Foreground="{DynamicResource Brush.GoldSoft}"
                                                       FontSize="14"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Center"/>
                                        </Border>

                                        <CheckBox Grid.Column="5"
                                                  Style="{StaticResource ModsActiveSwitch}"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanToggle}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ActiveLabel}" TextAlignment="Center"/>
                                        </CheckBox>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <TextBlock Grid.Row="3" Grid.Column="0"
                       Text="{Binding StatusText}"
                       Style="{StaticResource ModsBodyText}"
                       Foreground="{DynamicResource Brush.Muted}"
                       HorizontalAlignment="Right"
                       Margin="0,10,0,0"/>

            <!-- ── Mod settings detail panel ────────────────────────────────── -->
            <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="4"
                    Width="360"
                    Margin="18,0,0,0"
                    DataContext="{Binding SelectedDetails}"
                    Background="{DynamicResource Brush.MainPanelGradient}"
                    BorderBrush="{DynamicResource Brush.Gold}"
                    BorderThickness="1"
                    Visibility="{Binding DataContext.HasSelectedDetails,
                                         RelativeSource={RelativeSource AncestorType=Page},
                                         Converter={StaticResource BoolToVisibilityConverter}}">

                <DockPanel LastChildFill="True">

                    <!-- ── Footer buttons ─────────────────────────────────────── -->
                    <Border DockPanel.Dock="Bottom"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="0,1,0,0"
                            Padding="18,14">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{Binding DataContext.TblReset,
                                                      RelativeSource={RelativeSource AncestorType=Page},
                                                      FallbackValue='Reset'}"
                                    Style="{StaticResource ModsActionButton}"
                                    Background="Transparent"
                                    Command="{Binding ResetCommand}"
                                    Margin="0,0,10,0"/>
                            <Button Content="{Binding DataContext.TblSave,
                                                      RelativeSource={RelativeSource AncestorType=Page},
                                                      FallbackValue='Save'}"
                                    Style="{StaticResource ModsActionButton}"
                                    Command="{Binding SaveCommand}"/>
                        </StackPanel>
                    </Border>

                    <!-- ── Header + settings list ─────────────────────────────── -->
                    <ScrollViewer DockPanel.Dock="Top"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="20,20,20,10">
                        <StackPanel>

                            <!-- close button -->
                            <Button HorizontalAlignment="Right"
                                    Content="&#x2715;"
                                    Style="{StaticResource ModsIconButton}"
                                    Command="{Binding CloseCommand}"
                                    ToolTip="Close"/>

                            <!-- mod name + badges -->
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding ModName}"
                                           Style="{StaticResource ModsHeaderText}"
                                           FontSize="22"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ModVersion, StringFormat=' v{0}'}"
                                           Style="{StaticResource ModsBodyText}"
                                           Foreground="{DynamicResource Brush.Muted}"
                                           VerticalAlignment="Bottom"
                                           Margin="6,0,0,3"
                                           FontSize="13"/>
                            </StackPanel>

                            <!-- plugin badge -->
                            <Border Background="{DynamicResource Brush.BlueActive}"
                                    BorderBrush="{DynamicResource Brush.Gold}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="7,2"
                                    HorizontalAlignment="Left"
                                    Margin="0,6,0,0"
                                    Visibility="{Binding HasPlugin,
                                                         Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="&#x1F9E9; Plugin"
                                           Foreground="{DynamicResource Brush.GoldSoft}"
                                           FontFamily="Georgia"
                                           FontSize="12"/>
                            </Border>

                            <!-- description -->
                            <TextBlock Text="{Binding ModDescription}"
                                       Style="{StaticResource ModsBodyText}"
                                       FontSize="13"
                                       Foreground="{DynamicResource Brush.Muted}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"/>

                            <!-- divider -->
                            <Grid Margin="0,14,0,16">
                                <Rectangle Height="1" Fill="{DynamicResource Brush.Gold}" Opacity="0.5"/>
                                <TextBlock Text="&#x25C7;"
                                           Foreground="{DynamicResource Brush.GoldSoft}"
                                           FontFamily="Segoe UI Symbol"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,-10,0,0"/>
                            </Grid>

                            <!-- settings entries -->
                            <ItemsControl ItemsSource="{Binding Settings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,10,0,12"
                                                Margin="0,0,0,2">
                                            <StackPanel>

                                                <!-- label -->
                                                <TextBlock Text="{Binding Label}"
                                                           Foreground="{DynamicResource Brush.GoldSoft}"
                                                           FontFamily="Georgia"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"/>

                                                <!-- description -->
                                                <TextBlock Text="{Binding Description}"
                                                           Foreground="{DynamicResource Brush.Muted}"
                                                           FontFamily="Georgia"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           Margin="0,2,0,0"
                                                           Visibility="{Binding HasDescription,
                                                                                 Converter={StaticResource BoolToVisibilityConverter}}"/>

                                                <!-- ── bool toggle ─────────────────── -->
                                                <CheckBox IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                                          Style="{StaticResource ModsActiveSwitch}"
                                                          HorizontalAlignment="Left"
                                                          Margin="0,8,0,0"
                                                          Visibility="{Binding BoolVisibility}"/>

                                                <!-- ── numeric slider ──────────────── -->
                                                <StackPanel Margin="0,8,0,0"
                                                            Visibility="{Binding SliderVisibility}">
                                                    <DockPanel LastChildFill="True">
                                                        <TextBlock DockPanel.Dock="Right"
                                                                   Text="{Binding SliderValue, StringFormat='{}{0:0}'}"
                                                                   Foreground="{DynamicResource Brush.GoldSoft}"
                                                                   FontFamily="Georgia"
                                                                   FontSize="14"
                                                                   Width="46"
                                                                   TextAlignment="Right"
                                                                   VerticalAlignment="Center"
                                                                   Margin="8,0,0,0"/>
                                                        <Slider Value="{Binding SliderValue, Mode=TwoWay}"
                                                                Minimum="{Binding Min}"
                                                                Maximum="{Binding Max}"
                                                                TickFrequency="{Binding Step}"
                                                                IsSnapToTickEnabled="True"
                                                                Foreground="{DynamicResource Brush.GoldSoft}"
                                                                Background="{DynamicResource Brush.PanelDark}"/>
                                                    </DockPanel>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Left"
                                                                   Text="{Binding Min, StringFormat='{}{0:0}'}"
                                                                   Foreground="{DynamicResource Brush.Muted}"
                                                                   FontSize="11"/>
                                                        <TextBlock DockPanel.Dock="Right"
                                                                   Text="{Binding Max, StringFormat='{}{0:0}'}"
                                                                   Foreground="{DynamicResource Brush.Muted}"
                                                                   FontSize="11"
                                                                   HorizontalAlignment="Right"/>
                                                    </DockPanel>
                                                </StackPanel>

                                                <!-- ── colorSlider: hex text input only ─────── -->
                                                <StackPanel Margin="0,8,0,0"
                                                            Visibility="{Binding ColorVisibility}">
                                                    <DockPanel LastChildFill="True">
                                                        <Border DockPanel.Dock="Left"
                                                                Width="34" Height="34"
                                                                CornerRadius="3"
                                                                BorderBrush="{DynamicResource Brush.Gold}"
                                                                BorderThickness="1"
                                                                Background="{Binding ColorPreview}"
                                                                Margin="0,0,8,0"/>
                                                        <TextBox Text="{Binding CurrentValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource ModsOrderTextBox}"
                                                                 Width="Auto" Height="34"
                                                                 HorizontalAlignment="Stretch"
                                                                 TextAlignment="Left"
                                                                 FontFamily="Consolas"
                                                                 Padding="8,0"/>
                                                    </DockPanel>
                                                    <TextBlock Text="Enter a CSS hex colour, e.g. #C83232"
                                                               Foreground="{DynamicResource Brush.Muted}"
                                                               FontSize="11"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>

                                                <!-- ── colorPicker: HSV sliders + hex input ─── -->
                                                <StackPanel Margin="0,8,0,0"
                                                            Visibility="{Binding ColorPickerVisibility}">

                                                    <!-- preview swatch + hex input -->
                                                    <DockPanel LastChildFill="True" Margin="0,0,0,10">
                                                        <Border DockPanel.Dock="Left"
                                                                Width="42" Height="42"
                                                                CornerRadius="4"
                                                                BorderBrush="{DynamicResource Brush.Gold}"
                                                                BorderThickness="1"
                                                                Background="{Binding ColorPreview}"
                                                                Margin="0,0,10,0"/>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="Hex"
                                                                       Foreground="{DynamicResource Brush.Muted}"
                                                                       FontFamily="Georgia"
                                                                       FontSize="11"
                                                                       Margin="0,0,0,3"/>
                                                            <TextBox Text="{Binding CurrentValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource ModsOrderTextBox}"
                                                                     Height="32" Width="Auto"
                                                                     HorizontalAlignment="Stretch"
                                                                     TextAlignment="Left"
                                                                     FontFamily="Consolas"
                                                                     Padding="8,0"/>
                                                        </StackPanel>
                                                    </DockPanel>

                                                    <!-- H slider -->
                                                    <DockPanel Margin="0,0,0,6">
                                                        <TextBlock DockPanel.Dock="Left"
                                                                   Text="H"
                                                                   Foreground="{DynamicResource Brush.Muted}"
                                                                   FontFamily="Georgia" FontSize="12"
                                                                   Width="14" VerticalAlignment="Center"/>
                                                        <TextBlock DockPanel.Dock="Right"
                                                                   Text="{Binding HueValue, StringFormat='{}{0:0}°'}"
                                                                   Foreground="{DynamicResource Brush.GoldSoft}"
                                                                   FontFamily="Georgia" FontSize="12"
                                                                   Width="40" TextAlignment="Right"
                                                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                        <Slider Value="{Binding HueValue, Mode=TwoWay}"
                                                                Minimum="0" Maximum="360"
                                                                Style="{StaticResource GradientSlider}"
                                                                Background="{Binding HueGradient}"/>
                                                    </DockPanel>

                                                    <!-- S slider -->
                                                    <DockPanel Margin="0,0,0,6">
                                                        <TextBlock DockPanel.Dock="Left"
                                                                   Text="S"
                                                                   Foreground="{DynamicResource Brush.Muted}"
                                                                   FontFamily="Georgia" FontSize="12"
                                                                   Width="14" VerticalAlignment="Center"/>
                                                        <TextBlock DockPanel.Dock="Right"
                                                                   Text="{Binding SaturationValue, StringFormat='{}{0:0}%'}"
                                                                   Foreground="{DynamicResource Brush.GoldSoft}"
                                                                   FontFamily="Georgia" FontSize="12"
                                                                   Width="40" TextAlignment="Right"
                                                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                        <Slider Value="{Binding SaturationValue, Mode=TwoWay}"
                                                                Minimum="0" Maximum="100"
                                                                Style="{StaticResource GradientSlider}"
                                                                Background="{Binding SaturationGradient}"/>
                                                    </DockPanel>

                                                    <!-- B slider -->
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Left"
                                                                   Text="B"
                                                                   Foreground="{DynamicResource Brush.Muted}"
                                                                   FontFamily="Georgia" FontSize="12"
                                                                   Width="14" VerticalAlignment="Center"/>
                                                        <TextBlock DockPanel.Dock="Right"
                                                                   Text="{Binding BrightnessValue, StringFormat='{}{0:0}%'}"
                                                                   Foreground="{DynamicResource Brush.GoldSoft}"
                                                                   FontFamily="Georgia" FontSize="12"
                                                                   Width="40" TextAlignment="Right"
                                                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                        <Slider Value="{Binding BrightnessValue, Mode=TwoWay}"
                                                                Minimum="0" Maximum="100"
                                                                Style="{StaticResource GradientSlider}"
                                                                Background="{Binding BrightnessGradient}"/>
                                                    </DockPanel>

                                                </StackPanel>

                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

        </Grid>
    </Border>
</Page>
