<Page x:Class="Myria.Wpf.View.Pages.Page_Account"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="520"
      Title="Page_Account">

    <!-- Page-local AccPanel/AccSectionTitle/AccLabelText/AccMessageText/AccWarningText/
         AccTextBox/AccPasswordBox/AccButton were near-duplicates of shared Layout.xaml styles
         (GoldBorder/SectionTitle/BodyText/ErrorText/MutedText/GoldTextBox/GoldPasswordBox/
         GoldButtonBase) - removed as part of the AR4 consolidation, usages below now reuse those.
         AccDeleteButton kept (it's a real one-line variant, not a duplicate). -->
    <Page.Resources>
        <Style x:Key="AccDeleteButton" TargetType="Button" BasedOn="{StaticResource GoldButtonBase}">
            <Setter Property="Height"         Value="38"/>
            <Setter Property="Foreground"     Value="{DynamicResource Brush.Error}"/>
            <Setter Property="Background"     Value="{DynamicResource Brush.PanelDark}"/>
            <Setter Property="BorderBrush"    Value="{DynamicResource Brush.Error}"/>
            <Setter Property="FontSize"       Value="13"/>
            <Setter Property="FontWeight"     Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.NavHover}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AccButton" TargetType="Button" BasedOn="{StaticResource GoldButtonBase}">
            <Setter Property="Height"      Value="38"/>
            <Setter Property="Foreground"  Value="{DynamicResource Brush.GoldSoft}"/>
            <Setter Property="Background"  Value="{DynamicResource Brush.PanelDark}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.NavHover}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4">
            <TextBlock Text="{Binding TblTitle}"
                       Style="{StaticResource HeaderText}"
                       FontSize="22"
                       Margin="0,0,0,16"/>

            <!-- Change username -->
            <ContentControl Style="{StaticResource OrnateGoldFrame}" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding TblUsernameSection}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>

                    <TextBlock Text="{Binding TblNewUsername}" Style="{StaticResource BodyText}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource GoldTextBox}"/>

                    <TextBlock Text="{Binding TblCurrentPassword}" Style="{StaticResource BodyText}" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="pbx_CurrentPasswordForUsername" Style="{StaticResource GoldPasswordBox}"/>

                    <TextBlock Text="{Binding tblUsernameMsg}" Style="{StaticResource ErrorText}" MinHeight="16" Margin="0,4,0,0"/>

                    <Button Content="{Binding TblChangeUsernameBtn}"
                            Command="{Binding ChangeUsername}"
                            Style="{StaticResource AccButton}"
                            Margin="0,8,0,0"/>
                </StackPanel>
            </ContentControl>

            <!-- Change password -->
            <ContentControl Style="{StaticResource OrnateGoldFrame}" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding TblPasswordSection}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>

                    <TextBlock Text="{Binding TblOldPassword}" Style="{StaticResource BodyText}" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="pbx_OldPassword" Style="{StaticResource GoldPasswordBox}"/>

                    <TextBlock Text="{Binding TblNewPassword}" Style="{StaticResource BodyText}" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="pbx_NewPassword" Style="{StaticResource GoldPasswordBox}"/>

                    <TextBlock Text="{Binding TblConfirmNewPassword}" Style="{StaticResource BodyText}" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="pbx_ConfirmNewPassword" Style="{StaticResource GoldPasswordBox}"/>

                    <TextBlock Text="{Binding tblPasswordMsg}" Style="{StaticResource ErrorText}" MinHeight="16" Margin="0,4,0,0"/>

                    <Button Content="{Binding TblChangePasswordBtn}"
                            Command="{Binding ChangePassword}"
                            Style="{StaticResource AccButton}"
                            Margin="0,8,0,0"/>
                </StackPanel>
            </ContentControl>

            <!-- Delete account -->
            <ContentControl Style="{StaticResource OrnateGoldFrame}" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding TblDeleteSection}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding TblDeleteWarning}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <TextBlock Text="{Binding TblCurrentPassword}" Style="{StaticResource BodyText}" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="pbx_DeletePassword" Style="{StaticResource GoldPasswordBox}"/>

                    <TextBlock Text="{Binding tblDeleteMsg}" Style="{StaticResource ErrorText}" MinHeight="16" Margin="0,4,0,0"/>

                    <Button Content="{Binding TblDeleteAccountBtn}"
                            Command="{Binding DeleteAccount}"
                            Style="{StaticResource AccDeleteButton}"
                            Margin="0,8,0,0"/>
                </StackPanel>
            </ContentControl>
        </StackPanel>
    </ScrollViewer>
</Page>
