<Page x:Class="Myria.Wpf.View.Pages.Page_StartupMenu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Myria.Wpf.View.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page_StartupMenue">

    <Page.Background>
        <ImageBrush ImageSource="/Data/images/fantasy-group-adventurers.jpg"/>
    </Page.Background>
    
    <Page.Resources>
        <DropShadowEffect x:Key="StartupGlow" BlurRadius="18" ShadowDepth="0" Opacity="0.45" Color="{DynamicResource Color.Gold}"/>

        <Style x:Key="StartupTitleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.GoldSoft}"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="64"/>
            <Setter Property="Effect" Value="{StaticResource StartupGlow}"/>
        </Style>

        <Style x:Key="StartupPanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.MainPanelGradient}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Effect" Value="{StaticResource Effect.PanelShadow}"/>
        </Style>

    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.ColumnSpan="2"
              IsHitTestVisible="False"
              ClipToBounds="True">
            <Ellipse Width="520"
                     Height="520"
                     Stroke="{DynamicResource Brush.Gold}"
                     StrokeThickness="1"
                     Opacity="0.22"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Margin="0,-150,-90,0"/>
            <Ellipse Width="340"
                     Height="340"
                     Stroke="{DynamicResource Brush.Gold}"
                     StrokeThickness="1"
                     Opacity="0.17"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Margin="0,-72,-8,0"/>
        </Grid>

        <Border Grid.Column="1"
                Style="{StaticResource StartupPanel}"
                VerticalAlignment="Center"
                Margin="0,34,34,34">
            <StackPanel>
                <DockPanel Margin="0,0,0,18">
                    <TextBlock Text="&#x25CF;"
                               Foreground="{DynamicResource Brush.GoldSoft}"
                               FontFamily="Segoe UI Symbol"
                               FontSize="34"
                               DockPanel.Dock="Left"
                               Margin="0,0,18,0"/>
                    <TextBlock Text="Myria"
                               Foreground="{DynamicResource Brush.GoldSoft}"
                               FontFamily="Georgia"
                               FontSize="25"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <Grid Margin="0,0,0,20">
                    <Rectangle Height="1" Fill="{DynamicResource Brush.Gold}" Opacity="0.65" VerticalAlignment="Center"/>
                    <TextBlock Text="&#x25C7;"
                               Foreground="{DynamicResource Brush.GoldSoft}"
                               FontFamily="Segoe UI Symbol"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,-13,0,0"/>
                </Grid>

                <Button x:Name="btn_singleCharacter"
                        Content="{Binding btnSingle}"
                        Command="{Binding SingleCharacter}"
                        Style="{StaticResource StartupMenuButton}"/>

                <Grid Margin="0,6,0,16">
                    <Rectangle Height="1" Fill="{DynamicResource Brush.Gold}" Opacity="0.35"/>
                </Grid>

                <Button x:Name="btn_multiplayer"
                        Content="{Binding btnMultiplayer}"
                        Command="{Binding Multiplayer}"
                        Style="{StaticResource StartupMenuButton}"/>

                <Grid Margin="0,6,0,16">
                    <Rectangle Height="1" Fill="{DynamicResource Brush.Gold}" Opacity="0.35"/>
                </Grid>

                <Button x:Name="btn_settings"
                        Content="{Binding btnSettings}"
                        Command="{Binding Settings}"
                        Style="{StaticResource StartupMenuButton}"/>
                <Button x:Name="btn_quit"
                        Content="{Binding btnQuit}"
                        Command="{Binding Quit}"
                        Margin="0"
                        Style="{StaticResource StartupMenuButton}"/>
            </StackPanel>
        </Border>

        <Frame Grid.Column="0"
               Name="Frame"
               Margin="34"
               NavigationUIVisibility="Hidden"/>
    </Grid>
</Page>
