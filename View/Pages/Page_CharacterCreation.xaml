<Page x:Class="Myria.Wpf.View.Pages.Page_CharacterCreation"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Myria.Wpf.View.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page_CharacterCreation">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Secondary/ghost button — Back -->
        <Style x:Key="FooterBackBtn" TargetType="Button">
            <Setter Property="MinWidth"         Value="90"/>
            <Setter Property="Padding"          Value="18,8"/>
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Foreground"       Value="{DynamicResource Brush.Muted}"/>
            <Setter Property="BorderBrush"      Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="FontFamily"       Value="Georgia"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.GoldSoft}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary action button — Create -->
        <Style x:Key="FooterCreateBtn" TargetType="Button">
            <Setter Property="MinWidth"         Value="110"/>
            <Setter Property="Padding"          Value="20,8"/>
            <Setter Property="Background"       Value="{DynamicResource Brush.BlueActive}"/>
            <Setter Property="Foreground"       Value="{DynamicResource Brush.GoldSoft}"/>
            <Setter Property="BorderBrush"      Value="{DynamicResource Brush.Gold}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="FontFamily"       Value="Georgia"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="FontWeight"       Value="Bold"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Character name input — gold focus ring, Georgia font -->
        <Style x:Key="CharNameTextBox" TargetType="TextBox">
            <Setter Property="Background"      Value="{DynamicResource Brush.PanelDark}"/>
            <Setter Property="Foreground"      Value="{DynamicResource Brush.Foreground}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="10,7"/>
            <Setter Property="FontFamily"      Value="Georgia"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="CaretBrush"      Value="{DynamicResource Brush.GoldSoft}"/>
            <Setter Property="SelectionBrush"  Value="{DynamicResource Brush.BlueActive}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.GoldSoft}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
                                <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource Brush.Panel}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Select button inside race/class cards -->
        <Style x:Key="RaceSelectBtn" TargetType="Button">
            <Setter Property="Padding"    Value="8,3"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{DynamicResource Brush.Panel}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource Brush.BlueActive}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource Brush.BlueActive}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.GoldSoft}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="{DynamicResource Brush.WindowBackgroundGradient}">

        <!-- Decorative ring -->
        <Grid IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="460" Height="460"
                     Stroke="{DynamicResource Brush.Gold}" StrokeThickness="1" Opacity="0.09"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-90,0"/>
        </Grid>

        <Border Margin="20"
                BorderBrush="{DynamicResource Brush.Gold}"
                BorderThickness="1"
                Padding="18,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── Header ── -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding TblTitle}"
                                   Style="{StaticResource HeaderText}"
                                   FontSize="26"/>
                        <TextBlock Foreground="{DynamicResource Brush.Muted}"
                                   FontFamily="Georgia" FontSize="13" Margin="0,3,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding TblSubtitle}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMultiplayer}" Value="True">
                                            <Setter Property="Text" Value="Choose a name, race and class for your character."/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <Rectangle Grid.Column="1"
                               Height="1"
                               Fill="{DynamicResource Brush.Gold}"
                               Opacity="0.4"
                               VerticalAlignment="Bottom"
                               Margin="18,0,0,4"/>
                </Grid>

                <!-- ── Form ── -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: name + preview summary -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource Brush.HudBodyGradient}"
                            BorderBrush="{DynamicResource Brush.Gold}"
                            BorderThickness="1"
                            CornerRadius="2"
                            Padding="14,12"
                            Effect="{StaticResource Effect.PanelShadow}">
                        <StackPanel>

                            <!-- Name section -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding TblName}"
                                           Style="{StaticResource SectionTitle}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Rectangle Grid.Column="1" Height="1"
                                           Fill="{DynamicResource Brush.Gold}"
                                           Opacity="0.3" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBox Text="{Binding CharacterName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CharNameTextBox}"
                                     MaxLength="16"
                                     Margin="0,0,0,16"/>

                            <!-- Validation -->
                            <TextBlock Text="{Binding ValidationText}"
                                       Foreground="{DynamicResource Brush.Error}"
                                       FontFamily="Georgia" FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,16"/>

                            <!-- Preview section -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding TblPreview}"
                                           Style="{StaticResource SectionTitle}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Rectangle Grid.Column="1" Height="1"
                                           Fill="{DynamicResource Brush.Gold}"
                                           Opacity="0.3" VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel Margin="2,0,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="{Binding TblShowName}"
                                               Foreground="{DynamicResource Brush.Muted}"
                                               FontFamily="Georgia" FontSize="12"/>
                                    <TextBlock Text="{Binding CharacterName}"
                                               Foreground="{DynamicResource Brush.GoldSoft}"
                                               FontFamily="Georgia" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="{Binding TblShowRace}"
                                               Foreground="{DynamicResource Brush.Muted}"
                                               FontFamily="Georgia" FontSize="12"/>
                                    <TextBlock Text="{Binding PreviewRaceName}"
                                               Foreground="{DynamicResource Brush.GoldSoft}"
                                               FontFamily="Georgia" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="{Binding TblShowClass}"
                                               Foreground="{DynamicResource Brush.Muted}"
                                               FontFamily="Georgia" FontSize="12"/>
                                    <TextBlock Text="{Binding PreviewClassName}"
                                               Foreground="{DynamicResource Brush.GoldSoft}"
                                               FontFamily="Georgia" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>

                            </StackPanel>

                        </StackPanel>
                    </Border>

                    <!-- Right: race picker (MP) + class picker -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource Brush.HudBodyGradient}"
                            BorderBrush="{DynamicResource Brush.Gold}"
                            BorderThickness="1"
                            CornerRadius="2"
                            Padding="14,12"
                            Effect="{StaticResource Effect.PanelShadow}">
                        <StackPanel>

                            <!-- Race picker — multiplayer only -->
                            <StackPanel Visibility="{Binding IsMultiplayer, Converter={StaticResource BoolToVis}}"
                                        Margin="0,0,0,14">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding TblRace}"
                                               Style="{StaticResource SectionTitle}" FontSize="11"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Rectangle Grid.Column="1" Height="1"
                                               Fill="{DynamicResource Brush.Gold}"
                                               Opacity="0.3" VerticalAlignment="Center"/>
                                </Grid>
                                <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Races}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,6,6" CornerRadius="2" Padding="10,8" Cursor="Hand">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background"      Value="{DynamicResource Brush.PanelDark}"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Border}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Background"  Value="{DynamicResource Brush.BlueActive}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="5"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="6"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="8"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid Grid.Row="0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                                       FontFamily="Georgia" FontSize="13" FontWeight="Bold"
                                                                       Foreground="{DynamicResource Brush.GoldSoft}"
                                                                       VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1" Command="{Binding SelectCommand}"
                                                                    Style="{StaticResource RaceSelectBtn}">
                                                                <TextBlock Text="{Binding ButtonLabel}" FontSize="10"
                                                                           Foreground="{DynamicResource Brush.Foreground}"/>
                                                            </Button>
                                                        </Grid>
                                                        <Rectangle Grid.Row="2" Height="1"
                                                                   Fill="{DynamicResource Brush.Gold}" Opacity="0.2"/>
                                                        <TextBlock Grid.Row="4" Text="{Binding Description}"
                                                                   FontFamily="Georgia" FontSize="11" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource Brush.Muted}"/>
                                                        <Border Grid.Row="6"
                                                                Background="{DynamicResource Brush.Panel}"
                                                                BorderBrush="{DynamicResource Brush.Border}"
                                                                BorderThickness="1"
                                                                CornerRadius="2" Padding="6,3">
                                                            <TextBlock Text="{Binding StatGrowthLabel}"
                                                                       FontFamily="Georgia" FontSize="9"
                                                                       Foreground="{DynamicResource Brush.SecondaryText}"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Rectangle Height="1" Fill="{DynamicResource Brush.Gold}"
                                           Opacity="0.25" Margin="0,12,0,0"/>
                            </StackPanel>

                            <!-- Class picker -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding TblClass}"
                                           Style="{StaticResource SectionTitle}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Rectangle Grid.Column="1" Height="1"
                                           Fill="{DynamicResource Brush.Gold}"
                                           Opacity="0.3" VerticalAlignment="Center"/>
                            </Grid>
                            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Classes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,6,6" CornerRadius="2" Padding="8,6" Cursor="Hand"
                                                    ToolTip="{Binding UnavailableHint}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background"      Value="{DynamicResource Brush.PanelDark}"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Border}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background"  Value="{DynamicResource Brush.BlueActive}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                                <Setter Property="Opacity" Value="0.4"/>
                                                                <Setter Property="Cursor" Value="Arrow"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="4"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="6"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                                   FontFamily="Georgia" FontSize="12" FontWeight="Bold"
                                                                   Foreground="{DynamicResource Brush.GoldSoft}"
                                                                   VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1" Command="{Binding SelectCommand}"
                                                                IsEnabled="{Binding IsAvailable}"
                                                                Style="{StaticResource RaceSelectBtn}">
                                                            <TextBlock Text="{Binding ButtonLabel}" FontSize="10"
                                                                       Foreground="{DynamicResource Brush.Foreground}"/>
                                                        </Button>
                                                    </Grid>
                                                    <Rectangle Grid.Row="2" Height="1"
                                                               Fill="{DynamicResource Brush.Gold}" Opacity="0.2"/>
                                                    <Border Grid.Row="4"
                                                            Background="{DynamicResource Brush.Panel}"
                                                            BorderBrush="{DynamicResource Brush.Border}"
                                                            BorderThickness="1"
                                                            CornerRadius="2" Padding="4,2">
                                                        <TextBlock Text="{Binding StatGrowthLabel}"
                                                                   FontFamily="Georgia" FontSize="9" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource Brush.SecondaryText}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                        </StackPanel>
                    </Border>

                </Grid>

                <!-- ── Footer buttons ── -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding BtnBack}"   Command="{Binding BackCommand}"
                            Style="{StaticResource FooterBackBtn}" Margin="0,0,10,0"/>
                    <Button Content="{Binding BtnCreate}" Command="{Binding CreateCommand}"
                            Style="{StaticResource FooterCreateBtn}" IsEnabled="{Binding CanCreate}"/>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Page>
