<Page x:Class="MyriaRPG.View.Pages.Page_CharacterCreation"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:MyriaRPG.View.Pages"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page_CharacterCreation">
    <Grid Margin="20,20,20,70">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding TblTitle}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Foreground}"/>
            <TextBlock Text="Choose a name for your save." Opacity="0.75" Margin="0,4,0,0" Foreground="{DynamicResource Brush.Foreground}"/>
        </StackPanel>

        <!-- Form -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: name input -->
            <Border Grid.Column="0" Padding="12" CornerRadius="10" Background="{DynamicResource Brush.Background}">
                <StackPanel>
                    <TextBlock Text="{Binding TblName}" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource Brush.Foreground}"/>
                    <TextBox Text="{Binding CharacterName, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="16"
                             Background="{DynamicResource Brush.Border}"
                             Foreground="{DynamicResource Brush.Foreground}"
                             Padding="8"
                             Margin="0,0,0,16"/>

                    <TextBlock Text="{Binding TblRace}" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource Brush.Foreground}"/>
                    <TextBlock Text="Myralu" FontSize="15" Padding="8,6" Foreground="{DynamicResource Brush.Foreground}" Opacity="0.85"/>

                    <TextBlock Text="{Binding ValidationText}"
                               Foreground="Salmon"
                               Margin="0,16,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Right: preview -->
            <Border Grid.Column="2" Padding="12" CornerRadius="10" Background="{DynamicResource Brush.Background}">
                <StackPanel>
                    <TextBlock Text="{Binding TblPreview}" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="{DynamicResource Brush.Foreground}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{Binding TblShowName}" Opacity="0.7" Foreground="{DynamicResource Brush.Foreground}"/>
                        <TextBlock Text="{Binding CharacterName}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Foreground}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{Binding TblShowRace}" Opacity="0.7" Foreground="{DynamicResource Brush.Foreground}"/>
                        <TextBlock Text="Myralu" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Foreground}"/>
                    </StackPanel>

                    <Separator Margin="0,10,0,10"/>

                    <TextBlock Text="Starting Stats" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource Brush.Foreground}"/>
                    <TextBlock Text="STR: 13  DEX: 11  END: 14" Opacity="0.85" Foreground="{DynamicResource Brush.Foreground}"/>
                    <TextBlock Text="INT: 13  SPR: 13" Opacity="0.85" Foreground="{DynamicResource Brush.Foreground}"/>
                    <TextBlock Text="HP: 120  MP: 115" Opacity="0.85" Margin="0,4,0,0" Foreground="{DynamicResource Brush.Foreground}"/>
                    <TextBlock Text="Level: 1" Opacity="0.85" Margin="0,4,0,0" Foreground="{DynamicResource Brush.Foreground}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{Binding BtnBack}" Command="{Binding BackCommand}" Padding="14,6" Margin="0,0,8,0"/>
            <Button Content="{Binding BtnCreate}" Command="{Binding CreateCommand}" Padding="14,6" IsEnabled="{Binding CanCreate}"/>
        </StackPanel>
    </Grid>
</Page>
