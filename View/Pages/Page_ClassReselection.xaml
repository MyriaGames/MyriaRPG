<Page x:Class="Myria.Wpf.View.Pages.Page_ClassReselection"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="900"
      Background="{DynamicResource Brush.Background}">

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="{Binding Title}"
                   FontSize="24" FontWeight="Bold"
                   Foreground="{DynamicResource Brush.Foreground}"/>

        <!-- Subtitle -->
        <TextBlock Grid.Row="2" Text="{Binding Subtitle}"
                   FontSize="13" Foreground="{DynamicResource Brush.Muted}"
                   TextWrapping="Wrap"/>

        <!-- Class cards grid -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Classes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,8,8" CornerRadius="8" Padding="14,12" Cursor="Hand">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Class name + select button -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Foreground}"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Command="{Binding SelectCommand}"
                                            Cursor="Hand" Padding="10,4" FontSize="12">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Border}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock Text="{Binding ButtonLabel}" FontSize="11"
                                                   Foreground="{DynamicResource Brush.Foreground}"/>
                                    </Button>
                                </Grid>

                                <!-- Stat growth row -->
                                <Border Grid.Row="2" Background="{DynamicResource Brush.Border}"
                                        CornerRadius="4" Padding="8,4">
                                    <TextBlock Text="{Binding StatGrowthLabel}"
                                               FontSize="10"
                                               Foreground="{DynamicResource Brush.Muted}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer: validation + back + confirm -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="{Binding BtnBack}"
                    Command="{Binding BackCommand}"
                    Padding="16,8" FontSize="13" Cursor="Hand"/>

            <TextBlock Grid.Column="2" Text="{Binding ValidationText}"
                       Foreground="{DynamicResource Brush.Error}" FontSize="12"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="4" Content="{Binding BtnConfirm}"
                    Command="{Binding ConfirmCommand}"
                    Padding="20,8" FontSize="13" Cursor="Hand"/>
        </Grid>
    </Grid>
</Page>
