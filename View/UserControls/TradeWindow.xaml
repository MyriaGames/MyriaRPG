<UserControl x:Class="Myria.Wpf.View.UserControls.TradeWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:beh="clr-namespace:Myria.Wpf.Model.Behaviors"
             mc:Ignorable="d"
             d:DesignHeight="620"
             d:DesignWidth="760">

    <Grid Canvas.Left="{Binding Left}"
          Canvas.Top="{Binding Top}"
          Panel.ZIndex="{Binding ZIndex}"
          Width="{Binding Width}"
          Height="{Binding Height}"
          MinWidth="600"
          MinHeight="440">

        <Border Margin="10"
                BorderBrush="{DynamicResource Brush.Gold}"
                BorderThickness="1"
                Background="{DynamicResource Brush.WindowBackgroundGradient}"
                Effect="{DynamicResource Effect.WindowShadow}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        Background="{DynamicResource Brush.WindowPanelGradient}"
                        BorderBrush="{DynamicResource Brush.Gold}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Thumb x:Name="DragThumb" Opacity="0">
                            <i:Interaction.Behaviors>
                                <beh:DragThumbToCommandBehavior Command="{Binding DragDeltaCommand}"/>
                            </i:Interaction.Behaviors>
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Rectangle Fill="Transparent"/>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="52"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                        VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="&#x2194;"
                                           Foreground="{DynamicResource Brush.GoldSoft}"
                                           FontFamily="Segoe UI Symbol" FontSize="16"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Title}"
                                           Foreground="{DynamicResource Brush.GoldSoft}"
                                           FontFamily="Georgia" FontSize="15" FontStyle="Italic"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="&#x2715;"
                                    Command="{Binding CloseCommand}"
                                    Style="{StaticResource WindowCloseButtonSmall}"
                                    ToolTip="Cancel Trade"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Content frame -->
                <Frame Grid.Row="1"
                       Name="Frame"
                       NavigationUIVisibility="Hidden"
                       Background="Transparent"
                       ClipToBounds="True"/>
            </Grid>
        </Border>

        <i:Interaction.Triggers>
            <i:EventTrigger EventName="PreviewMouseDown">
                <i:InvokeCommandAction Command="{Binding FocusCommand}"/>
            </i:EventTrigger>
        </i:Interaction.Triggers>
    </Grid>
</UserControl>
