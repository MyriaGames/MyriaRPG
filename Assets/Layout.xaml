    <!-- Shop quantity text box — matches ShopQtyButton height and palette -->
    <Style x:Key="ShopQtyTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="Height"          Value="30"/>
        <Setter Property="Background"      Value="{DynamicResource Brush.PanelDark}"/>
        <Setter Property="Foreground"      Value="{DynamicResource Brush.GoldSoft}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Gold}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily"      Value="Georgia"/>
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="TextAlignment"   Value="Center"/>
        <Setter Property="CaretBrush"      Value="{DynamicResource Brush.GoldSoft}"/>
