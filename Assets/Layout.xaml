        <Setter Property="Margin"          Value="8"/>
        <Setter Property="Background"      Value="{DynamicResource Brush.PanelDark}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Gold}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground"      Value="{DynamicResource Brush.GoldSoft}"/>
        <Setter Property="FontFamily"      Value="Segoe UI Symbol"/>
        <Setter Property="FontSize"        Value="20"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#5A1D1D"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#7B2020"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- small Window close button -->
    <Style x:Key="WindowCloseButtonSmall" TargetType="Button">
        <Setter Property="Width"           Value="35"/>
        <Setter Property="Height"          Value="35"/>
        <Setter Property="Margin"          Value="8"/>
        <Setter Property="Background"      Value="{DynamicResource Brush.PanelDark}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Gold}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground"      Value="{DynamicResource Brush.GoldSoft}"/>
        <Setter Property="FontFamily"      Value="Segoe UI Symbol"/>
        <Setter Property="FontSize"        Value="20"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#5A1D1D"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#7B2020"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- ── RPG Game UI ──────────────────────────────────────────────────────── -->

    <!-- Shared effects (constant across themes) -->
    <DropShadowEffect x:Key="Effect.PanelShadow" BlurRadius="18" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
    <DropShadowEffect x:Key="Effect.HudShadow"   BlurRadius="24" ShadowDepth="0" Opacity="0.75" Color="#000000"/>

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <conv:NotFriendToVisibilityConverter x:Key="NotFriendToVis"/>

    <!-- Gold-bordered dark RPG panel -->
    <Style x:Key="GoldBorder" TargetType="Border">
        <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Gold}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="2"/>
        <Setter Property="Background"      Value="{DynamicResource Brush.Background}"/>
        <Setter Property="Effect"          Value="{StaticResource Effect.PanelShadow}"/>
    </Style>

    <!-- RPG Typography -->
    <Style x:Key="HeaderText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.GoldSoft}"/>
        <Setter Property="FontFamily" Value="Georgia"/>
        <Setter Property="FontSize"   Value="38"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.GoldSoft}"/>
        <Setter Property="FontFamily" Value="Georgia"/>
        <Setter Property="FontSize"   Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="Foreground"        Value="{DynamicResource Brush.Foreground}"/>
        <Setter Property="FontFamily"        Value="Georgia"/>
        <Setter Property="FontSize"          Value="14"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
        <Setter Property="FontSize"   Value="13"/>
    </Style>

    <!-- Sidebar nav button (Character page tabs) -->
    <Style x:Key="NavBtn" TargetType="Button">
        <Setter Property="Background"                 Value="Transparent"/>
        <Setter Property="BorderBrush"                Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness"            Value="0,0,0,1"/>
        <Setter Property="Foreground"                 Value="{DynamicResource Brush.GoldSoft}"/>
        <Setter Property="Cursor"                     Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding"                    Value="14,0"/>
        <Setter Property="Height"                     Value="46"/>
        <Setter Property="FontFamily"                 Value="Georgia"/>
        <Setter Property="FontSize"                   Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background"  Value="{DynamicResource Brush.NavHover}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Stat +/− button (Character page attribute editing) -->
    <Style x:Key="StatBtn" TargetType="Button">
        <Setter Property="Width"      Value="22"/>
        <Setter Property="Height"     Value="22"/>
        <Setter Property="Padding"    Value="0"/>
        <Setter Property="FontSize"   Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{DynamicResource Brush.PanelDark}"
                            BorderBrush="{DynamicResource Brush.Gold}"
                            BorderThickness="1" CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.BlueActive}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Gradient progress bar with rounded corners -->
    <Style x:Key="RoundBar" TargetType="ProgressBar">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border CornerRadius="4" Background="{TemplateBinding Background}">
                        <Border x:Name="PART_Track">
                            <Border x:Name="PART_Indicator"
                                    CornerRadius="4"
                                    Background="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Left"/>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Chat channel tab button -->
    <Style x:Key="ChatTabBtn" TargetType="Button">
        <Setter Property="Height"          Value="32"/>
        <Setter Property="Padding"         Value="14,0"/>
        <Setter Property="Margin"          Value="0,0,6,0"/>
        <Setter Property="Foreground"      Value="{DynamicResource Brush.GoldSoft}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Gold}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily"      Value="Georgia"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.GoldSoft}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Square icon button (game page top toolbar) -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width"           Value="36"/>
        <Setter Property="Height"          Value="36"/>
        <Setter Property="Padding"         Value="0"/>
        <Setter Property="Margin"          Value="3,0"/>
        <Setter Property="Foreground"      Value="{DynamicResource Brush.Foreground}"/>
        <Setter Property="Background"      Value="{DynamicResource Brush.PanelDark}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Gold}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
        <Setter Property="Effect"          Value="{StaticResource Effect.HudShadow}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource Brush.BlueActive}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small rounded button (party / invite panel) -->
    <Style x:Key="SmallBtn" TargetType="Button">
        <Setter Property="Padding"         Value="8,3"/>
        <Setter Property="FontSize"        Value="11"/>
        <Setter Property="Foreground"      Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Themed MenuItem -->
    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="Background"  Value="Transparent"/>
        <Setter Property="Foreground"  Value="{DynamicResource Brush.Foreground}"/>
        <Setter Property="FontFamily"  Value="Georgia"/>
        <Setter Property="FontSize"    Value="13"/>
        <Setter Property="Padding"     Value="14,7"/>
        <Setter Property="Cursor"      Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"/>
                            <!-- Submenu arrow, shown only when the item has children -->
                            <Path x:Name="Arrow" Grid.Column="1"
                                  Data="M 0 0 L 4 4 L 0 8 Z"
                                  Fill="{DynamicResource Brush.Muted}"
                                  VerticalAlignment="Center"
                                  Margin="10,0,0,0"
                                  Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.NavHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.GoldSoft}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.40"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Themed Separator (used inside ContextMenu and Menu) -->
    <Style TargetType="{x:Type Separator}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Rectangle Height="1"
                               Fill="{DynamicResource Brush.Gold}"
                               Opacity="0.35"
                               Margin="8,3"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
