<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Myria.Wpf.View.Converters">

    <!-- Typography / sizing knobs -->
    <Thickness x:Key="Spacing.ControlPadding">10,6</Thickness>
    <Thickness x:Key="Spacing.Generous">20</Thickness>
    <Thickness x:Key="Spacing.Moderate">12</Thickness>
    <Thickness x:Key="Spacing.Small">8</Thickness>
    <CornerRadius x:Key="Radius.Control">10</CornerRadius>
    <CornerRadius x:Key="Radius.Panel">12</CornerRadius>
    <CornerRadius x:Key="Radius.Slot">8</CornerRadius>
    <CornerRadius x:Key="Radius.Item">4</CornerRadius>
    <FontFamily x:Key="Font.Ui">Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Monospace">Consolas</FontFamily>
    <FontFamily x:Key="Font.Myriac">/Assets/Fonts/MyriacScript.ttf#MyriacScript</FontFamily>
    <!-- Fantasy display font (AR4) - Regular+Bold both sit in Assets/Fonts/, so this folder-form
         URI (no filename before the #) resolves "Cinzel" to two real embedded faces instead of a
         single file, meaning FontWeight="Bold" renders true Cinzel-Bold rather than a synthetic/
         faux-bold of Cinzel-Regular. Falls back to Georgia/Segoe UI for any glyph Cinzel lacks. -->
    <FontFamily x:Key="Font.Heading">/Assets/Fonts/#Cinzel, Georgia, Segoe UI</FontFamily>
    <!-- Georgia was already the app's de facto body font (333 hardcoded literals across 47 files
         before AR4) - this just gives the existing choice a name so it's centrally swappable. -->
    <FontFamily x:Key="Font.Body">Georgia, Segoe UI</FontFamily>

    <!-- Window baseline -->
    <Style TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{DynamicResource Brush.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
    </Style>

    <Style TargetType="{x:Type Page}">
        <Setter Property="Background" Value="{DynamicResource Brush.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
    </Style>

    <Style TargetType="{x:Type Frame}">
        <Setter Property="UseLayoutRounding"   Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    
    <!-- ── Shared gold-button templates (AR4) ──────────────────────────────────
         Two structural families used across the app's button styles, previously
         reimplemented near-identically ~10 times each with an inconsistent CornerRadius
         mix (2/4/6/10/0). TargetType is deliberately ButtonBase (not Button) so a
         RadioButton (CharacterSelectButton) can also derive from GoldBarButtonBase - Button
         and RadioButton are siblings under ButtonBase, not parent/child.
         Each derived style below keeps its own colors AND its own full IsMouseOver/IsPressed/
         IsEnabled Style.Triggers block, rather than inheriting shared trigger defaults - hover
         treatment varies too much in KIND (background swap vs borderbrush swap vs opacity fade
         vs no-op) across the original styles to safely default, and BasedOn concatenates
         Style.Triggers rather than replacing them, so an inherited default trigger can't be
         "cancelled" by a derived style that doesn't want it - only safely added to. -->
    <Style x:Key="GoldButtonBase" TargetType="{x:Type ButtonBase}">
        <Setter Property="BorderThickness"            Value="1"/>
        <Setter Property="FontFamily"                 Value="{StaticResource Font.Body}"/>
        <Setter Property="Cursor"                      Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ButtonBase}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Item}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bar-accent family: Grid with BarLeft/BarRight accent rectangles that fade in on hover -
         this fade behavior is identical across all 3 derived styles so it's safely baked into
         the shared template itself (unlike GoldButtonBase's hover colors, which vary by style). -->
    <Style x:Key="GoldBarButtonBase" TargetType="{x:Type ButtonBase}">
        <Setter Property="Cursor"                     Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ButtonBase}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="BarLeft" Fill="{DynamicResource Brush.Gold}"
                                       RadiusX="2" RadiusY="2" Opacity="0"/>
                            <ContentPresenter Grid.Column="1"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            <Rectangle x:Name="BarRight" Grid.Column="2" Fill="{DynamicResource Brush.Gold}"
                                       RadiusX="2" RadiusY="2" Opacity="0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BarLeft"  Property="Opacity" Value="1"/>
                            <Setter TargetName="BarRight" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NpcDialogButton" TargetType="Button" BasedOn="{StaticResource GoldButtonBase}">
        <Setter Property="Height"      Value="46"/>
        <Setter Property="Padding"     Value="5"/>
        <Setter Property="Foreground"  Value="{DynamicResource Brush.Muted}"/>
        <Setter Property="Background"  Value="{DynamicResource Brush.PanelDark}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
        <Setter Property="FontSize"    Value="13"/>
        <Setter Property="FontWeight"  Value="Bold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.NavHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Rounded Button (layout-only; colors via DynamicResource brushes) -->
    <Style TargetType="{x:Type Button}">
        <Setter Property="Padding" Value="{StaticResource Spacing.ControlPadding}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Control}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
                            <Setter Property="Foreground" Value="Black"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.9"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menu item button: transparent, full-width, accent bars on hover -->
    <Style x:Key="IngameMenuItem" TargetType="Button" BasedOn="{StaticResource GoldBarButtonBase}">
        <Setter Property="Background"          Value="Transparent"/>
        <Setter Property="Foreground"          Value="{DynamicResource Brush.Foreground}"/>
        <Setter Property="BorderThickness"     Value="0"/>
        <Setter Property="FontSize"            Value="15"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Padding"             Value="0,11"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.TileBackground}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.75"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Startup menu button -->
    <Style x:Key="StartupMenuButton" TargetType="Button" BasedOn="{StaticResource GoldBarButtonBase}">
        <Setter Property="MinHeight"       Value="54"/>
        <Setter Property="Foreground"      Value="{DynamicResource Brush.GoldSoft}"/>
        <Setter Property="Background"      Value="{DynamicResource Brush.PanelDark}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Gold}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily"      Value="{StaticResource Font.Body}"/>
        <Setter Property="FontSize"        Value="18"/>
        <Setter Property="Padding"         Value="14,0"/>
        <Setter Property="Margin"          Value="0,0,0,10"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.NavHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.BlueActive}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Character selection toggle: same look as IngameMenuItem, stays highlighted when checked -->
    <Style x:Key="CharacterSelectButton" TargetType="RadioButton" BasedOn="{StaticResource GoldBarButtonBase}">
        <Setter Property="Background"      Value="{DynamicResource Brush.PanelDark}"/>
        <Setter Property="Foreground"      Value="{DynamicResource Brush.GoldSoft}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Gold}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily"      Value="{StaticResource Font.Body}"/>
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="Padding"         Value="10,10"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.NavHover}"/>
            </Trigger>
            <!-- IsChecked comes after IsMouseOver so the selected state always wins -->
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background"  Value="{DynamicResource Brush.BlueActive}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.75"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Optional: simple panel look -->
    <Style x:Key="PanelCard" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Panel}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.TileBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10"/>
    </Style>

    <!-- Inventory Panel Style -->
    <Style x:Key="InventoryPanel" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Panel}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.TileBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="{StaticResource Spacing.Generous}"/>
        <Setter Property="Margin" Value="0,0,0,20"/>
    </Style>

    <!-- Inventory Slot Style -->
    <Style x:Key="InventorySlot" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource Brush.TileBackground}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="Padding" Value="{StaticResource Spacing.Small}"/>
        <Setter Property="AllowDrop" Value="True"/>
    </Style>

    <!-- Equipment Slot Style -->
    <Style x:Key="EquipmentSlot" TargetType="{x:Type ContentControl}">
        <Setter Property="Width" Value="120"/>
        <Setter Property="Height" Value="120"/>
        <Setter Property="Margin" Value="{StaticResource Spacing.Small}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">
                    <Border Background="{DynamicResource Brush.TileBackground}" 
                            BorderBrush="{DynamicResource Brush.Border}" 
                            BorderThickness="2" 
                            CornerRadius="{StaticResource Radius.Slot}"
                            AllowDrop="True">
                        <Grid>
                            <TextBlock Text="{TemplateBinding Tag}" 
                                      Foreground="{DynamicResource Brush.SecondaryText}" 
                                      FontSize="11" 
                                      HorizontalAlignment="Center" 
                                      VerticalAlignment="Center"
                                      FontWeight="Bold"/>
                            <ContentPresenter/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text Styles for Inventory -->
    <Style x:Key="InventoryTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
        <Setter Property="Margin" Value="0,0,0,20"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
    </Style>

    <Style x:Key="InventoryHeader" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.SecondaryText}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
    </Style>

    <Style x:Key="InventoryLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.SecondaryText}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
    </Style>

    <Style x:Key="InventoryValue" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Gold}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Monospace}"/>
    </Style>

    <Style x:Key="TooltipContent" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Tooltip Panel Style -->
    <Style x:Key="TooltipPanel" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource Brush.TileBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Item}"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="MaxWidth" Value="300"/>
    </Style>

    <!-- Themed TextBox -->
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{DynamicResource Brush.TileBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Foreground}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Themed PasswordBox (mirrors TextBox style) -->
    <Style TargetType="{x:Type PasswordBox}">
        <Setter Property="Background" Value="{DynamicResource Brush.TileBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Foreground}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type PasswordBox}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Themed ComboBox -->
    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Background" Value="{DynamicResource Brush.TileBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <Border x:Name="MainBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.ColumnSpan="2"
                                              Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter Grid.Column="0"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  IsHitTestVisible="False"/>
                                <Path Grid.Column="1"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                      Fill="{DynamicResource Brush.Foreground}"
                                      IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Border MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource Brush.TileBackground}"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="4"
                                    Margin="0,4,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.2" Color="#000000"/>
                                </Border.Effect>
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Themed ComboBoxItem -->
    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="4">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Themed CheckBox -->
    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground"  Value="{DynamicResource Brush.Foreground}"/>
        <Setter Property="FontFamily"  Value="{StaticResource Font.Ui}"/>
        <Setter Property="Cursor"      Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="Box"
                                Width="16" Height="16"
                                Background="{DynamicResource Brush.PanelDark}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="3">
                            <TextBlock x:Name="Check"
                                       Text="✓"
                                       Foreground="{DynamicResource Brush.GoldSoft}"
                                       FontSize="10" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="7,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box"   Property="Background"  Value="{DynamicResource Brush.BlueActive}"/>
                            <Setter TargetName="Box"   Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
                            <Setter TargetName="Check" Property="Visibility"  Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Themed Slider -->
    <Style TargetType="{x:Type Slider}">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid>
                        <Border Height="4"
                                Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="2"
                                VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4"
                                                    Background="{DynamicResource Brush.Accent}"
                                                    CornerRadius="2"
                                                    VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" Height="4" VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Bd"
                                                    Width="14" Height="14"
                                                    Background="{DynamicResource Brush.Gold}"
                                                    BorderBrush="{DynamicResource Brush.PanelDark}"
                                                    BorderThickness="2"
                                                    CornerRadius="7"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.GoldSoft}"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Scrollbar ───────────────────────────────────────────────────────── -->

    <!-- Transparent hit-target for the track area (replaces the line-up/down repeat buttons) -->
    <Style x:Key="ScrollBar.TrackButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background"            Value="Transparent"/>
        <Setter Property="Focusable"             Value="False"/>
        <Setter Property="IsTabStop"             Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rounded thumb — neutral by default, accent on hover / drag -->
    <Style x:Key="ScrollBar.ThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop"             Value="False"/>
        <Setter Property="MinHeight"             Value="20"/>
        <Setter Property="MinWidth"              Value="20"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="Bd"
                            Background="{DynamicResource Brush.Border}"
                            CornerRadius="3"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Global ScrollBar — 6 px wide/tall, no arrow buttons, subtle rail -->
    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Width"                 Value="6"/>
        <Setter Property="MinWidth"              Value="6"/>
        <Setter Property="Background"            Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <!-- Vertical (default) -->
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid Width="6" Background="Transparent">
                        <!-- Rail -->
                        <Border CornerRadius="3"
                                Background="{DynamicResource Brush.Surface}"
                                Margin="2,4"/>
                        <!-- Track + thumb -->
                        <Track x:Name="PART_Track"
                               IsDirectionReversed="True"
                               Margin="0,4">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand"
                                              Style="{StaticResource ScrollBar.TrackButton}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand"
                                              Style="{StaticResource ScrollBar.TrackButton}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBar.ThumbStyle}" Margin="1,0"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <!-- Horizontal orientation -->
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height"    Value="6"/>
                <Setter Property="MinHeight" Value="6"/>
                <Setter Property="Width"     Value="Auto"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Height="6" Background="Transparent">
                                <!-- Rail -->
                                <Border CornerRadius="3"
                                        Background="{DynamicResource Brush.Surface}"
                                        Margin="4,2"/>
                                <!-- Track + thumb -->
                                <Track x:Name="PART_Track"
                                       IsDirectionReversed="False"
                                       Margin="4,0">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand"
                                                      Style="{StaticResource ScrollBar.TrackButton}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand"
                                                      Style="{StaticResource ScrollBar.TrackButton}"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollBar.ThumbStyle}" Margin="0,1"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Themed ContextMenu -->
    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="Background"      Value="{DynamicResource Brush.PanelDark}"/>
        <Setter Property="Foreground"      Value="{DynamicResource Brush.Foreground}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Gold}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="0,4"/>
        <Setter Property="MinWidth"        Value="150"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            MinWidth="{TemplateBinding MinWidth}"
                            Effect="{DynamicResource Effect.PanelShadow}">
                        <StackPanel IsItemsHost="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Shop filter tab button — icon above label, gold underline when active -->
    <Style x:Key="ShopFilterTabButton" TargetType="Button">
        <Setter Property="Height"          Value="52"/>
        <Setter Property="Foreground"      Value="{DynamicResource Brush.GoldSoft}"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderBrush"     Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="FontFamily"      Value="Georgia"/>
        <Setter Property="FontSize"        Value="11"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8,4">
                            <TextBlock Text="{TemplateBinding Tag}"
                                       FontFamily="Segoe UI Symbol"
                                       FontSize="17"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,2"/>
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.NavHover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Shop secondary button (−, +, Max, Back) -->
    <Style x:Key="ShopQtyButton" TargetType="Button" BasedOn="{StaticResource GoldButtonBase}">
        <Setter Property="Height"      Value="30"/>
        <Setter Property="Padding"     Value="8,0"/>
        <Setter Property="Background"  Value="{DynamicResource Brush.PanelDark}"/>
        <Setter Property="Foreground"  Value="{DynamicResource Brush.GoldSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
        <Setter Property="FontSize"    Value="14"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.BlueActive}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.7"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Shop quantity text box — matches ShopQtyButton height and palette -->
    <Style x:Key="ShopQtyTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="Height"          Value="30"/>
        <Setter Property="Background"      Value="{DynamicResource Brush.PanelDark}"/>
        <Setter Property="Foreground"      Value="{DynamicResource Brush.GoldSoft}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Gold}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily"      Value="Georgia"/>
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="TextAlignment"   Value="Center"/>
        <Setter Property="CaretBrush"      Value="{DynamicResource Brush.GoldSoft}"/>
        <Setter Property="SelectionBrush"  Value="{DynamicResource Brush.BlueActive}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="6,0"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource Brush.BlueActive}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.GoldSoft}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Flush gold-bordered form inputs - promoted from Page_Account.xaml's page-local
         AccTextBox/AccPasswordBox (AR4 consolidation), echoing the same look ShopQtyTextBox
         already used ad hoc, as a first-class shared "form input" pair. -->
    <Style x:Key="GoldTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="Height"          Value="36"/>
        <Setter Property="Background"      Value="{DynamicResource Brush.PanelDark}"/>
        <Setter Property="Foreground"      Value="{DynamicResource Brush.Foreground}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Gold}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily"      Value="{StaticResource Font.Body}"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="Padding"         Value="10,0"/>
        <Setter Property="Margin"          Value="0,0,0,8"/>
        <Setter Property="CaretBrush"      Value="{DynamicResource Brush.Foreground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
