    <Style x:Key="SideNavVisualsButton"     TargetType="Button" BasedOn="{StaticResource SideNavButton}">
        <Style.Triggers><DataTrigger Binding="{Binding ActiveSideSection}" Value="Visuals">
            <Setter Property="Background"  Value="{DynamicResource Brush.BlueActive}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
        </DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="SideNavKeybindingsButton" TargetType="Button" BasedOn="{StaticResource SideNavButton}">
        <Style.Triggers><DataTrigger Binding="{Binding ActiveSideSection}" Value="Keybindings">
            <Setter Property="Background"  Value="{DynamicResource Brush.BlueActive}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
        </DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="SideNavModsButton" TargetType="Button" BasedOn="{StaticResource SideNavButton}">
        <Style.Triggers><DataTrigger Binding="{Binding ActiveSideSection}" Value="Mods">
            <Setter Property="Background"  Value="{DynamicResource Brush.BlueActive}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
        </DataTrigger></Style.Triggers>
    </Style>

    <!-- Window close button -->
    <Style x:Key="WindowCloseButton" TargetType="Button">
        <Setter Property="Width"           Value="50"/>
        <Setter Property="Height"          Value="50"/>
        <Setter Property="Margin"          Value="8"/>
        <Setter Property="Background"      Value="{DynamicResource Brush.PanelDark}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Gold}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground"      Value="{DynamicResource Brush.GoldSoft}"/>
        <Setter Property="FontFamily"      Value="Segoe UI Symbol"/>
        <Setter Property="FontSize"        Value="20"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#5A1D1D"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#7B2020"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- small Window close button - identical to WindowCloseButton except size -->
    <Style x:Key="WindowCloseButtonSmall" TargetType="Button" BasedOn="{StaticResource WindowCloseButton}">
        <Setter Property="Width"  Value="35"/>
        <Setter Property="Height" Value="35"/>
    </Style>
    <!-- ── RPG Game UI ──────────────────────────────────────────────────────── -->

    <!-- Shared effects (constant across themes) -->
    <DropShadowEffect x:Key="Effect.PanelShadow" BlurRadius="18" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
    <DropShadowEffect x:Key="Effect.HudShadow"   BlurRadius="24" ShadowDepth="0" Opacity="0.75" Color="#000000"/>

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <conv:NotFriendToVisibilityConverter x:Key="NotFriendToVis"/>

    <!-- Gold-bordered dark RPG panel -->
    <Style x:Key="GoldBorder" TargetType="Border">
        <Setter Property="BorderBrush"     Value="{DynamicResource Brush.Gold}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="2"/>
        <Setter Property="Background"      Value="{DynamicResource Brush.Background}"/>
        <Setter Property="Effect"          Value="{StaticResource Effect.PanelShadow}"/>
    </Style>

    <!-- ── Decorative ornaments (AR4) ───────────────────────────────────────────
         Pure vector Path/Geometry inside a Viewbox, same technique Icons.xaml's 96 item icons
         already use - no bitmap art. First applied to Window_InitError.xaml and a few
         Page_Account.xaml panels only (see TODO.md AR4) - not a global GoldBorder replacement. -->

    <!-- One small "rune stone + tendril" motif, drawn once for the top-left corner and reused at
         the other three corners via RotateTransform in OrnateGoldFrame below - keeps this DRY
         instead of drawing four near-duplicate geometries. -->
    <DataTemplate x:Key="Ornament.CornerFlourish">
        <Viewbox Width="20" Height="20" Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <!-- Tendrils radiate from the stone along both edges -->
                <Path Data="M 11,6 Q 18,4 24,2" Stroke="{DynamicResource Brush.Gold}" StrokeThickness="1.4" Fill="{x:Null}"/>
                <Path Data="M 6,11 Q 4,18 2,24"  Stroke="{DynamicResource Brush.Gold}" StrokeThickness="1.4" Fill="{x:Null}"/>
                <!-- Diamond "rune stone" at the corner apex -->
                <Path Data="M 6,1 L 11,6 L 6,11 L 1,6 Z"
                      Fill="{DynamicResource Brush.Gold}"
                      Stroke="{DynamicResource Brush.GoldSoft}"
                      StrokeThickness="0.6"/>
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <!-- Drop-in replacement for <Border Style="{StaticResource GoldBorder}"> that adds the corner
         flourish above at all four corners. Uses a plain ContentControl (same technique the
         existing EquipmentSlot style already uses) - no new C# class needed. -->
    <Style x:Key="OrnateGoldFrame" TargetType="{x:Type ContentControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">
                    <Grid>
                        <Border BorderBrush="{DynamicResource Brush.Gold}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Background="{DynamicResource Brush.Background}"
                                Effect="{StaticResource Effect.PanelShadow}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ContentControl ContentTemplate="{StaticResource Ornament.CornerFlourish}"
                                         HorizontalAlignment="Left" VerticalAlignment="Top"
                                         Margin="-2,-2,0,0" IsHitTestVisible="False"/>
                        <ContentControl ContentTemplate="{StaticResource Ornament.CornerFlourish}"
                                         HorizontalAlignment="Right" VerticalAlignment="Top"
                                         Margin="0,-2,-2,0" IsHitTestVisible="False"
                                         RenderTransformOrigin="0.5,0.5">
                            <ContentControl.RenderTransform>
                                <RotateTransform Angle="90"/>
                            </ContentControl.RenderTransform>
                        </ContentControl>
                        <ContentControl ContentTemplate="{StaticResource Ornament.CornerFlourish}"
                                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                         Margin="0,0,-2,-2" IsHitTestVisible="False"
                                         RenderTransformOrigin="0.5,0.5">
                            <ContentControl.RenderTransform>
                                <RotateTransform Angle="180"/>
                            </ContentControl.RenderTransform>
                        </ContentControl>
                        <ContentControl ContentTemplate="{StaticResource Ornament.CornerFlourish}"
                                         HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                         Margin="-2,0,0,-2" IsHitTestVisible="False"
                                         RenderTransformOrigin="0.5,0.5">
                            <ContentControl.RenderTransform>
                                <RotateTransform Angle="270"/>
                            </ContentControl.RenderTransform>
                        </ContentControl>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RPG Typography -->
    <Style x:Key="HeaderText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.GoldSoft}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Heading}"/>
        <Setter Property="FontSize"   Value="38"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.GoldSoft}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Heading}"/>
        <Setter Property="FontSize"   Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="Foreground"        Value="{DynamicResource Brush.Foreground}"/>
        <Setter Property="FontFamily"        Value="{StaticResource Font.Body}"/>
        <Setter Property="FontSize"          Value="14"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
        <Setter Property="FontSize"   Value="13"/>
    </Style>

    <!-- Error/validation text - promoted from Page_Account.xaml's page-local AccMessageText,
         since form-validation text is a generically reusable pattern (AR4 consolidation). -->
    <Style x:Key="ErrorText" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
        <Setter Property="Foreground"    Value="{DynamicResource Brush.Error}"/>
        <Setter Property="TextWrapping"  Value="Wrap"/>
    </Style>

    <!-- Sidebar nav button (Character page tabs) -->
    <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource GoldButtonBase}">
        <Setter Property="Background"                 Value="Transparent"/>
        <Setter Property="BorderBrush"                Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness"            Value="0,0,0,1"/>
        <Setter Property="Foreground"                 Value="{DynamicResource Brush.GoldSoft}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding"                    Value="14,0"/>
        <Setter Property="Height"                     Value="46"/>
        <Setter Property="FontSize"                   Value="13"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background"  Value="{DynamicResource Brush.NavHover}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Stat +/− button (Character page attribute editing) -->
    <Style x:Key="StatBtn" TargetType="Button" BasedOn="{StaticResource GoldButtonBase}">
        <Setter Property="Width"       Value="22"/>
        <Setter Property="Height"      Value="22"/>
        <Setter Property="Padding"     Value="0"/>
        <Setter Property="FontSize"    Value="13"/>
        <Setter Property="Foreground"  Value="{DynamicResource Brush.Foreground}"/>
        <Setter Property="Background"  Value="{DynamicResource Brush.PanelDark}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.BlueActive}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.7"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Gradient progress bar with rounded corners -->
    <Style x:Key="RoundBar" TargetType="ProgressBar">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border CornerRadius="4" Background="{TemplateBinding Background}">
                        <Border x:Name="PART_Track">
                            <Border x:Name="PART_Indicator"
                                    CornerRadius="4"
                                    Background="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Left"/>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Chat channel tab button -->
    <Style x:Key="ChatTabBtn" TargetType="Button" BasedOn="{StaticResource GoldButtonBase}">
        <Setter Property="Height"      Value="32"/>
        <Setter Property="Padding"     Value="14,0"/>
        <Setter Property="Margin"      Value="0,0,6,0"/>
        <Setter Property="Foreground"  Value="{DynamicResource Brush.GoldSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
        <Setter Property="FontSize"    Value="13"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.GoldSoft}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Square icon button (game page top toolbar) -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GoldButtonBase}">
        <Setter Property="Width"       Value="36"/>
        <Setter Property="Height"      Value="36"/>
        <Setter Property="Padding"     Value="0"/>
        <Setter Property="Margin"      Value="3,0"/>
        <Setter Property="Foreground"  Value="{DynamicResource Brush.Foreground}"/>
        <Setter Property="Background"  Value="{DynamicResource Brush.PanelDark}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
        <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
        <Setter Property="Effect"      Value="{StaticResource Effect.HudShadow}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background"  Value="{DynamicResource Brush.BlueActive}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Gold}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.7"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Small rounded button (party / invite panel) -->
    <Style x:Key="SmallBtn" TargetType="Button">
        <Setter Property="Padding"         Value="8,3"/>
        <Setter Property="FontSize"        Value="11"/>
        <Setter Property="Foreground"      Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Themed MenuItem -->
    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="Background"  Value="Transparent"/>
        <Setter Property="Foreground"  Value="{DynamicResource Brush.Foreground}"/>
        <Setter Property="FontFamily"  Value="Georgia"/>
        <Setter Property="FontSize"    Value="13"/>
        <Setter Property="Padding"     Value="14,7"/>
        <Setter Property="Cursor"      Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"/>
                            <!-- Submenu arrow, shown only when the item has children -->
                            <Path x:Name="Arrow" Grid.Column="1"
                                  Data="M 0 0 L 4 4 L 0 8 Z"
                                  Fill="{DynamicResource Brush.Muted}"
                                  VerticalAlignment="Center"
                                  Margin="10,0,0,0"
                                  Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.NavHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.GoldSoft}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.40"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Themed Separator (used inside ContextMenu and Menu) -->
    <Style TargetType="{x:Type Separator}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Rectangle Height="1"
                               Fill="{DynamicResource Brush.Gold}"
                               Opacity="0.35"
                               Margin="8,3"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
