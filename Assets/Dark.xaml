<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base Colors -->
    <Color x:Key="Color.Background">#070B0F</Color>
    <Color x:Key="Color.Foreground">#E8D8B3</Color>
    <Color x:Key="Color.Surface">#FF1A1929</Color>
    <Color x:Key="Color.Border">#FF3A3A4A</Color>
    <Color x:Key="Color.Accent">#FF7AB4FF</Color>
    <Color x:Key="Color.Error">#FFCF6679</Color>
    <Color x:Key="Color.Success">#77B85A</Color>
    <Color x:Key="Color.TileBackground">#FF2A2935</Color>
    <Color x:Key="Color.TitleBackground">#FF222222</Color>
    
    <!-- Secondary Text Color -->
    <Color x:Key="Color.SecondaryText">#FF7A7A8A</Color>
    <Color x:Key="Color.Gold">#C99A4A</Color>

    <!-- Inventory Rarity Colors -->
    <Color x:Key="Color.Rarity.Common">#FFA0A0A0</Color>
    <Color x:Key="Color.Rarity.Uncommon">#FF1EFF00</Color>
    <Color x:Key="Color.Rarity.Rare">#FF0070DD</Color>
    <Color x:Key="Color.Rarity.Epic">#FFA335EE</Color>
    <Color x:Key="Color.Rarity.Legendary">#FFFF8000</Color>
    <Color x:Key="Color.Rarity.Mythic">#FFFF0000</Color>

    <!-- Equipment Slot Colors -->
    <Color x:Key="Color.Equipment.Weapon">#FFFFB700</Color>
    <Color x:Key="Color.Equipment.Armor">#FF1EFF00</Color>
    <Color x:Key="Color.Equipment.Accessory">#FF0070DD</Color>

    <!-- Brushes - Base -->
    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}"/>
    <SolidColorBrush x:Key="Brush.Foreground" Color="{StaticResource Color.Foreground}"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}"/>
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}"/>
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/>
    <SolidColorBrush x:Key="Brush.TileBackground" Color="{StaticResource Color.TileBackground}"/>
    <SolidColorBrush x:Key="Brush.TitleBackground" Color="{StaticResource Color.TitleBackground}"/>

    <SolidColorBrush x:Key="Brush.Panel"       Color="#101820"/>
    <SolidColorBrush x:Key="Brush.PanelDark"   Color="#0B1117"/>
    <SolidColorBrush x:Key="Brush.Gold"        Color="{StaticResource Color.Gold}"/>
    <SolidColorBrush x:Key="Brush.TextOnGold"  Color="#101820"/>
    <SolidColorBrush x:Key="Brush.GoldSoft"    Color="#E1C481"/>
    <SolidColorBrush x:Key="Brush.Muted"       Color="#9A8A68"/>
    <SolidColorBrush x:Key="Brush.TextMuted"   Color="#9A8A68"/>
    <SolidColorBrush x:Key="Brush.BlueActive"  Color="#0F314D"/>

    <!-- Brushes - Secondary -->
    <SolidColorBrush x:Key="Brush.SecondaryText" Color="{StaticResource Color.SecondaryText}"/>

    <!-- Brushes - Rarity -->
    <SolidColorBrush x:Key="Brush.Rarity.Common" Color="{StaticResource Color.Rarity.Common}"/>
    <SolidColorBrush x:Key="Brush.Rarity.Uncommon" Color="{StaticResource Color.Rarity.Uncommon}"/>
    <SolidColorBrush x:Key="Brush.Rarity.Rare" Color="{StaticResource Color.Rarity.Rare}"/>
    <SolidColorBrush x:Key="Brush.Rarity.Epic" Color="{StaticResource Color.Rarity.Epic}"/>
    <SolidColorBrush x:Key="Brush.Rarity.Legendary" Color="{StaticResource Color.Rarity.Legendary}"/>
    <SolidColorBrush x:Key="Brush.Rarity.Mythic" Color="{StaticResource Color.Rarity.Mythic}"/>

    <!-- Brushes - Equipment -->
    <SolidColorBrush x:Key="Brush.Equipment.Weapon" Color="{StaticResource Color.Equipment.Weapon}"/>
    <SolidColorBrush x:Key="Brush.Equipment.Armor" Color="{StaticResource Color.Equipment.Armor}"/>
    <SolidColorBrush x:Key="Brush.Equipment.Accessory" Color="{StaticResource Color.Equipment.Accessory}"/>

    <!-- RPG Solid Brushes (nav interaction) -->
    <SolidColorBrush x:Key="Brush.NavHover" Color="#11202D"/>

    <!-- RPG Gradient Brushes -->
    <LinearGradientBrush x:Key="Brush.MainPanelGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#121D25" Offset="0"/>
        <GradientStop Color="#071016" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.PortraitGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1A242B" Offset="0"/>
        <GradientStop Color="#081014" Offset="0.65"/>
        <GradientStop Color="#030506" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.HudBodyGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#141C22" Offset="0"/>
        <GradientStop Color="#090D11" Offset="0.62"/>
        <GradientStop Color="#050607" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.HudCrestGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#13283B" Offset="0"/>
        <GradientStop Color="#071017" Offset="1"/>
    </LinearGradientBrush>

    <!-- Window Gradient Brushes -->
    <LinearGradientBrush x:Key="Brush.WindowPanelGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#141C22" Offset="0"/>
        <GradientStop Color="#090D11" Offset="0.65"/>
        <GradientStop Color="#050607" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.WindowBackgroundGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#070B0F" Offset="0"/>
        <GradientStop Color="#0D141B" Offset="0.5"/>
        <GradientStop Color="#040607" Offset="1"/>
    </LinearGradientBrush>

    <!-- Map Colors -->
    <Color x:Key="Color.MapBackground">#FF101820</Color>
    <Color x:Key="Color.Map.Node.City">#FFC99A4A</Color>
    <Color x:Key="Color.Map.Node.Dungeon">#FF6F2424</Color>
    <Color x:Key="Color.Map.Node.Boss">#FF9E1F2B</Color>
    <Color x:Key="Color.Map.Node.Cave">#FF405060</Color>
    <Color x:Key="Color.Map.Node.Forest">#FF275B35</Color>
    <Color x:Key="Color.Map.Node.World">#FF1A2430</Color>
    <SolidColorBrush x:Key="Brush.MapBackground" Color="{StaticResource Color.MapBackground}"/>

    <!-- Map Structural Colors -->
    <Color x:Key="Color.Map.Border.Normal">#FF3A3A4A</Color>
    <Color x:Key="Color.Map.Border.Current">#FF7AB4FF</Color>
    <Color x:Key="Color.Map.Border.Group">#FFC99A4A</Color>
    <Color x:Key="Color.Map.Edge">#FF9A8A68</Color>
    <Color x:Key="Color.Map.Label.Normal">#FFE8D8B3</Color>
    <Color x:Key="Color.Map.Label.Group">#FFE1C481</Color>
    <Color x:Key="Color.Map.Marker">#FF7AB4FF</Color>

</ResourceDictionary>
