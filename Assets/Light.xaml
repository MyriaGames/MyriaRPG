<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base Colors — Dark theme coloration inverted: Dark BG ↔ Dark FG -->
    <Color x:Key="Color.Background">#E8D8B3</Color>
    <Color x:Key="Color.Foreground">#070B0F</Color>
    <Color x:Key="Color.Surface">#DDD0A0</Color>
    <Color x:Key="Color.Border">#7A6840</Color>
    <Color x:Key="Color.Accent">#3A5F8A</Color>
    <Color x:Key="Color.Error">#CF6679</Color>
    <Color x:Key="Color.Success">#4A8830</Color>
    <Color x:Key="Color.TileBackground">#D0C090</Color>
    <Color x:Key="Color.TitleBackground">#D8C8A0</Color>

    <!-- Secondary Text Color -->
    <Color x:Key="Color.SecondaryText">#0F314D</Color>
    <Color x:Key="Color.Gold">#101820</Color>

    <!-- Inventory Rarity Colors -->
    <Color x:Key="Color.Rarity.Common">#FFA0A0A0</Color>
    <Color x:Key="Color.Rarity.Uncommon">#FF1EFF00</Color>
    <Color x:Key="Color.Rarity.Rare">#FF0070DD</Color>
    <Color x:Key="Color.Rarity.Epic">#FFA335EE</Color>
    <Color x:Key="Color.Rarity.Legendary">#FFFF8000</Color>
    <Color x:Key="Color.Rarity.Mythic">#FFFF0000</Color>

    <!-- Equipment Slot Colors -->
    <Color x:Key="Color.Equipment.Weapon">#FFFFB700</Color>
    <Color x:Key="Color.Equipment.Armor">#FF1EFF00</Color>
    <Color x:Key="Color.Equipment.Accessory">#FF0070DD</Color>

    <!-- Brushes - Base -->
    <SolidColorBrush x:Key="Brush.Background"       Color="{StaticResource Color.Background}"/>
    <SolidColorBrush x:Key="Brush.Foreground"       Color="{StaticResource Color.Foreground}"/>
    <SolidColorBrush x:Key="Brush.Surface"          Color="{StaticResource Color.Surface}"/>
    <SolidColorBrush x:Key="Brush.Border"           Color="{StaticResource Color.Border}"/>
    <SolidColorBrush x:Key="Brush.Accent"           Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.Error"            Color="{StaticResource Color.Error}"/>
    <SolidColorBrush x:Key="Brush.Success"          Color="{StaticResource Color.Success}"/>
    <SolidColorBrush x:Key="Brush.TileBackground"   Color="{StaticResource Color.TileBackground}"/>
    <SolidColorBrush x:Key="Brush.TitleBackground"  Color="{StaticResource Color.TitleBackground}"/>

    <!-- Brushes - Secondary -->
    <SolidColorBrush x:Key="Brush.SecondaryText"    Color="{StaticResource Color.SecondaryText}"/>
    <SolidColorBrush x:Key="Brush.Gold"             Color="{StaticResource Color.Gold}"/>
    <SolidColorBrush x:Key="Brush.TextOnGold"       Color="#101820"/>

    <!-- Brushes - Rarity -->
    <SolidColorBrush x:Key="Brush.Rarity.Common"    Color="{StaticResource Color.Rarity.Common}"/>
    <SolidColorBrush x:Key="Brush.Rarity.Uncommon"  Color="{StaticResource Color.Rarity.Uncommon}"/>
    <SolidColorBrush x:Key="Brush.Rarity.Rare"      Color="{StaticResource Color.Rarity.Rare}"/>
    <SolidColorBrush x:Key="Brush.Rarity.Epic"      Color="{StaticResource Color.Rarity.Epic}"/>
    <SolidColorBrush x:Key="Brush.Rarity.Legendary" Color="{StaticResource Color.Rarity.Legendary}"/>
    <SolidColorBrush x:Key="Brush.Rarity.Mythic"    Color="{StaticResource Color.Rarity.Mythic}"/>

    <!-- Brushes - Equipment -->
    <SolidColorBrush x:Key="Brush.Equipment.Weapon"    Color="{StaticResource Color.Equipment.Weapon}"/>
    <SolidColorBrush x:Key="Brush.Equipment.Armor"     Color="{StaticResource Color.Equipment.Armor}"/>
    <SolidColorBrush x:Key="Brush.Equipment.Accessory" Color="{StaticResource Color.Equipment.Accessory}"/>

    <!-- RPG Palette (inverted from Dark) -->
    <SolidColorBrush x:Key="Brush.Panel"       Color="#F5ECDA"/>
    <SolidColorBrush x:Key="Brush.PanelDark"   Color="#EAE0CA"/>
    <SolidColorBrush x:Key="Brush.GoldSoft"    Color="#070B0F"/> 
    <SolidColorBrush x:Key="Brush.Muted"       Color="#5A7085"/>
    <SolidColorBrush x:Key="Brush.TextMuted"   Color="#0F314D"/>
    <SolidColorBrush x:Key="Brush.BlueActive"  Color="#C99A4A"/>
    <SolidColorBrush x:Key="Brush.NavHover"    Color="#DDD0B0"/>

    <!-- RPG Gradient Brushes (light warm variants of Dark's near-black gradients) -->
    <LinearGradientBrush x:Key="Brush.MainPanelGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E3DAB8" Offset="0"/>
        <GradientStop Color="#DACAA0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.PortraitGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#DDD4B8" Offset="0"/>
        <GradientStop Color="#CCBC90" Offset="0.65"/>
        <GradientStop Color="#BFA878" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.HudBodyGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E0D4B4" Offset="0"/>
        <GradientStop Color="#D4C8A0" Offset="0.62"/>
        <GradientStop Color="#C8BC90" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.HudCrestGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E8D8B8" Offset="0"/>
        <GradientStop Color="#D8C8A0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.WindowPanelGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E0D4B0" Offset="0"/>
        <GradientStop Color="#D4C8A0" Offset="0.65"/>
        <GradientStop Color="#CCC090" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.WindowBackgroundGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EDE2C4" Offset="0"/>
        <GradientStop Color="#E8D8B3" Offset="0.5"/>
        <GradientStop Color="#E2D0A8" Offset="1"/>
    </LinearGradientBrush>

    <!-- Map Colors -->
    <Color x:Key="Color.MapBackground">#FFF5ECDA</Color>
    <Color x:Key="Color.Map.Node.City">#FFC99A4A</Color>
    <Color x:Key="Color.Map.Node.Dungeon">#FF8C2F2F</Color>
    <Color x:Key="Color.Map.Node.Boss">#FFB02635</Color>
    <Color x:Key="Color.Map.Node.Cave">#FF617182</Color>
    <Color x:Key="Color.Map.Node.Forest">#FF3F7A44</Color>
    <Color x:Key="Color.Map.Node.World">#FF5A7085</Color>
    <SolidColorBrush x:Key="Brush.MapBackground" Color="{StaticResource Color.MapBackground}"/>

    <!-- Map Structural Colors -->
    <Color x:Key="Color.Map.Border.Normal">#FF7A6840</Color>
    <Color x:Key="Color.Map.Border.Current">#FF3A5F8A</Color>
    <Color x:Key="Color.Map.Border.Group">#FFC99A4A</Color>
    <Color x:Key="Color.Map.Edge">#FF7A6840</Color>
    <Color x:Key="Color.Map.Label.Normal">#FFF5ECDA</Color>
    <Color x:Key="Color.Map.Label.Group">#FFE1C481</Color>
    <Color x:Key="Color.Map.Marker">#FF3A5F8A</Color>

</ResourceDictionary>
