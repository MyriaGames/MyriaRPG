<UserControl x:Class="RpgClient.Views.ChatPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="1180"
             Height="720"
             Background="Transparent">

	<UserControl.Resources>
		<SolidColorBrush x:Key="Gold" Color="#C99A4A"/>
		<SolidColorBrush x:Key="GoldSoft" Color="#E1C481"/>
		<SolidColorBrush x:Key="Text" Color="#E8D8B3"/>
		<SolidColorBrush x:Key="Muted" Color="#7A6A4A"/>
		<SolidColorBrush x:Key="Blue" Color="#0F314D"/>
		<SolidColorBrush x:Key="PanelDark" Color="#070B0F"/>

		<LinearGradientBrush x:Key="PanelBg" StartPoint="0,0" EndPoint="1,1">
			<GradientStop Color="#111A21" Offset="0"/>
			<GradientStop Color="#05080B" Offset="1"/>
		</LinearGradientBrush>

		<DropShadowEffect x:Key="Shadow"
                          BlurRadius="20"
                          ShadowDepth="0"
                          Opacity="0.65"
                          Color="#000000"/>

		<Style x:Key="TabButton" TargetType="ToggleButton">
			<Setter Property="Height" Value="64"/>
			<Setter Property="MinWidth" Value="165"/>
			<Setter Property="Margin" Value="0,0,10,0"/>
			<Setter Property="Foreground" Value="{StaticResource GoldSoft}"/>
			<Setter Property="Background" Value="#080D10"/>
			<Setter Property="BorderBrush" Value="{StaticResource Gold}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="FontFamily" Value="Georgia"/>
			<Setter Property="FontSize" Value="24"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ToggleButton">
						<Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
							<ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<Trigger Property="IsChecked" Value="True">
					<Setter Property="Background" Value="{StaticResource Blue}"/>
					<Setter Property="Foreground" Value="#FFF4C8"/>
				</Trigger>
			</Style.Triggers>
		</Style>
	</UserControl.Resources>

	<Border Background="{StaticResource PanelBg}"
            BorderBrush="{StaticResource Gold}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="24"
            Effect="{StaticResource Shadow}">

		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="78"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="72"/>
			</Grid.RowDefinitions>

			<!-- Chat tabs -->
			<StackPanel Orientation="Horizontal">
				<ToggleButton Style="{StaticResource TabButton}" IsChecked="True" Content="◎  All"/>
				<ToggleButton Style="{StaticResource TabButton}" Content="💬  Room"/>
				<ToggleButton Style="{StaticResource TabButton}" Content="◎  Global"/>
				<ToggleButton Style="{StaticResource TabButton}" Content="⚑  Party"/>
				<ToggleButton Style="{StaticResource TabButton}" Content="☽  Whisper"/>

				<Button Content="⚙"
                        Width="54"
                        Height="54"
                        Margin="30,5,8,0"
                        Background="#080D10"
                        BorderBrush="{StaticResource Gold}"
                        Foreground="{StaticResource GoldSoft}"
                        FontSize="24"/>

				<Button Content="⌵"
                        Width="54"
                        Height="54"
                        Margin="0,5,0,0"
                        Background="#080D10"
                        BorderBrush="{StaticResource Gold}"
                        Foreground="{StaticResource GoldSoft}"
                        FontSize="24"/>
			</StackPanel>

			<!-- Chat messages -->
			<Border Grid.Row="1"
                    BorderBrush="{StaticResource Gold}"
                    BorderThickness="1"
                    Background="#AA05080B"
                    Padding="22">

				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<StackPanel>

						<Grid Margin="0,0,0,26">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="70"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="110"/>
							</Grid.ColumnDefinitions>

							<TextBlock Text="♛" Foreground="{StaticResource GoldSoft}" FontSize="28"/>
							<TextBlock Grid.Column="1" FontFamily="Georgia" FontSize="21">
								<Run Text="[System] " Foreground="#3D9AD6"/>
								<Run Text="Welcome to Myria." Foreground="{StaticResource Text}"/>
							</TextBlock>
							<TextBlock Grid.Column="2" Text="14:22:31" Foreground="#84909A" FontFamily="Georgia" FontSize="18"/>
						</Grid>

						<Grid Margin="0,0,0,26">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="70"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="110"/>
							</Grid.ColumnDefinitions>

							<TextBlock Text="◎" Foreground="{StaticResource GoldSoft}" FontSize="28"/>
							<TextBlock Grid.Column="1" FontFamily="Georgia" FontSize="21">
								<Run Text="[Global] " Foreground="#B778E8"/>
								<Run Text="Arcanist: Anyone up for the World Boss in 10 minutes?" Foreground="{StaticResource Text}"/>
							</TextBlock>
							<TextBlock Grid.Column="2" Text="14:22:45" Foreground="#84909A" FontFamily="Georgia" FontSize="18"/>
						</Grid>

						<Grid Margin="0,0,0,26">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="70"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="110"/>
							</Grid.ColumnDefinitions>

							<TextBlock Text="💬" Foreground="{StaticResource GoldSoft}" FontSize="26"/>
							<TextBlock Grid.Column="1" FontFamily="Georgia" FontSize="21">
								<Run Text="[Room] " Foreground="#77B85A"/>
								<Run Text="You have entered the room: Trade - City of Velmor" Foreground="{StaticResource Text}"/>
							</TextBlock>
							<TextBlock Grid.Column="2" Text="14:23:02" Foreground="#84909A" FontFamily="Georgia" FontSize="18"/>
						</Grid>

						<Grid Margin="0,0,0,26">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="70"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="110"/>
							</Grid.ColumnDefinitions>

							<TextBlock Text="⚔" Foreground="{StaticResource GoldSoft}" FontSize="28"/>
							<TextBlock Grid.Column="1" FontFamily="Georgia" FontSize="21">
								<Run Text="[Party] " Foreground="#D99A58"/>
								<Run Text="Valeria: I’ll tank, you guys focus the adds." Foreground="{StaticResource Text}"/>
							</TextBlock>
							<TextBlock Grid.Column="2" Text="14:23:18" Foreground="#84909A" FontFamily="Georgia" FontSize="18"/>
						</Grid>

						<Grid Margin="0,0,0,26">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="70"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="110"/>
							</Grid.ColumnDefinitions>

							<TextBlock Text="☽" Foreground="#A77CFF" FontSize="28"/>
							<TextBlock Grid.Column="1" FontFamily="Georgia" FontSize="21">
								<Run Text="[Whisper] To [Zypher]: " Foreground="#A77CFF"/>
								<Run Text="Hey! Are you available to help with the dungeon?" Foreground="{StaticResource Text}"/>
							</TextBlock>
							<TextBlock Grid.Column="2" Text="14:23:34" Foreground="#84909A" FontFamily="Georgia" FontSize="18"/>
						</Grid>

					</StackPanel>
				</ScrollViewer>
			</Border>

			<!-- Input -->
			<Grid Grid.Row="2" Margin="0,14,0,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="62"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="62"/>
					<ColumnDefinition Width="140"/>
				</Grid.ColumnDefinitions>

				<Button Content="+"
                        Background="#080D10"
                        BorderBrush="{StaticResource Gold}"
                        Foreground="{StaticResource GoldSoft}"
                        FontSize="32"/>

				<TextBox Grid.Column="1"
                         Margin="12,0"
                         Background="#080D10"
                         BorderBrush="{StaticResource Gold}"
                         Foreground="{StaticResource Text}"
                         FontFamily="Georgia"
                         FontSize="20"
                         Padding="18,0"
                         VerticalContentAlignment="Center"
                         Text="Type your message..."/>

				<Button Grid.Column="2"
                        Content="☺"
                        Background="#080D10"
                        BorderBrush="{StaticResource Gold}"
                        Foreground="{StaticResource GoldSoft}"
                        FontSize="25"/>

				<Button Grid.Column="3"
                        Margin="12,0,0,0"
                        Content="Send"
                        Background="{StaticResource Blue}"
                        BorderBrush="{StaticResource Gold}"
                        Foreground="#FFF4C8"
                        FontFamily="Georgia"
                        FontSize="24"/>
			</Grid>
		</Grid>
	</Border>
</UserControl>