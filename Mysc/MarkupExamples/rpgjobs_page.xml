<UserControl x:Class="RpgClient.Views.JobsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="820"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Palette -->
        <SolidColorBrush x:Key="Gold" Color="#C99A4A"/>
        <SolidColorBrush x:Key="GoldSoft" Color="#E1C481"/>
        <SolidColorBrush x:Key="Text" Color="#E8D8B3"/>
        <SolidColorBrush x:Key="Muted" Color="#9A8A68"/>
        <SolidColorBrush x:Key="PanelDark" Color="#0B1117"/>
        <SolidColorBrush x:Key="PanelSoft" Color="#111A21"/>
        <SolidColorBrush x:Key="SkillGold" Color="#D7A84C"/>
        <SolidColorBrush x:Key="KnowledgeBlue" Color="#3D9AD6"/>
        <SolidColorBrush x:Key="FamePurple" Color="#8D5BC4"/>
        <SolidColorBrush x:Key="Green" Color="#8BC767"/>

        <LinearGradientBrush x:Key="PageBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#090D11" Offset="0"/>
            <GradientStop Color="#101820" Offset="0.55"/>
            <GradientStop Color="#050607" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PanelGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#121D25" Offset="0"/>
            <GradientStop Color="#071016" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SlotGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#111820" Offset="0"/>
            <GradientStop Color="#070B0F" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="PanelShadow" BlurRadius="18" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
        <DropShadowEffect x:Key="GoldGlow" BlurRadius="16" ShadowDepth="0" Opacity="0.45" Color="#C99A4A"/>

        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource GoldSoft}"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="50"/>
            <Setter Property="LetterSpacing" Value="3"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource GoldSoft}"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LetterSpacing" Value="2"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="GoldPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelGradient}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Effect" Value="{StaticResource PanelShadow}"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="MinWidth" Value="170"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="Foreground" Value="#FFF4C8"/>
            <Setter Property="Background" Value="#0F314D"/>
            <Setter Property="BorderBrush" Value="{StaticResource Gold}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect" Value="{StaticResource GoldGlow}"/>
                    <Setter Property="Background" Value="#143B5A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource PageBackground}"
            BorderBrush="{StaticResource Gold}"
            BorderThickness="1">

        <Grid Margin="42,24,42,28">
            <!-- faint ornamental background -->
            <Ellipse Width="380" Height="380" Stroke="#4B391D" StrokeThickness="1" Opacity="0.14" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-135,-120,0,0"/>
            <Ellipse Width="420" Height="420" Stroke="#4B391D" StrokeThickness="1" Opacity="0.14" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-130,-120,0"/>

            <Grid.RowDefinitions>
                <RowDefinition Height="112"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="112"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Jobs" Style="{StaticResource HeaderText}"/>
                    <Grid Width="330" Margin="0,6,0,0">
                        <Rectangle Height="1" Fill="#8A6A32" Opacity="0.65"/>
                        <TextBlock Text="◇" Foreground="{StaticResource GoldSoft}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-20,0,0"/>
                    </Grid>
                    <TextBlock Text="Manage your jobs and track your progress across Skill, Knowledge and Fame."
                               Foreground="{StaticResource GoldSoft}"
                               FontFamily="Georgia"
                               FontStyle="Italic"
                               FontSize="17"
                               Margin="0,14,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Main content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="430"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Current Job -->
                <Border Grid.Column="0" Style="{StaticResource GoldPanel}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46"/>
                            <RowDefinition Height="180"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="54"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Rectangle Height="1" Fill="#8A6A32" Opacity="0.65" VerticalAlignment="Center"/>
                            <TextBlock Text="Current Job" Style="{StaticResource SectionTitle}" Background="#101820" Padding="22,0"/>
                        </Grid>

                        <!-- Smith hero -->
                        <Grid Grid.Row="1" Margin="0,6,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="142" Height="142" BorderBrush="{StaticResource Gold}" BorderThickness="1" Background="{StaticResource SlotGradient}" CornerRadius="71" VerticalAlignment="Center">
                                <Grid>
                                    <Ellipse Stroke="#4B391D" StrokeThickness="1" Opacity="0.35" Margin="12"/>
                                    <TextBlock Text="⚒" Foreground="{StaticResource GoldSoft}" FontSize="66" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="Smith" Foreground="{StaticResource Text}" FontFamily="Georgia" FontSize="31"/>
                                <Border Width="92" Height="30" BorderBrush="{StaticResource Gold}" BorderThickness="1" Background="#0B1117" HorizontalAlignment="Left" Margin="0,8,0,12">
                                    <TextBlock Text="Level 23" Foreground="{StaticResource GoldSoft}" FontFamily="Georgia" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Masters of metal and fire, capable of forging weapons, armor and countless tools."
                                           Style="{StaticResource BodyText}"
                                           LineHeight="23"/>
                            </StackPanel>
                        </Grid>

                        <!-- Current job tracks -->
                        <StackPanel Grid.Row="2">
                            <Grid Margin="0,0,0,16">
                                <Rectangle Height="1" Fill="#8A6A32" Opacity="0.65" VerticalAlignment="Center"/>
                                <TextBlock Text="Job Overview" Foreground="{StaticResource GoldSoft}" FontFamily="Georgia" FontSize="16" Background="#101820" Padding="16,0" HorizontalAlignment="Center"/>
                            </Grid>

                            <!-- Skill -->
                            <Grid Height="74" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="112"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="52" Height="52" BorderBrush="{StaticResource Gold}" BorderThickness="1" Background="#0B1117" VerticalAlignment="Center">
                                    <TextBlock Text="⚒" Foreground="{StaticResource GoldSoft}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Skill" Style="{StaticResource BodyText}" FontSize="19"/>
                                    <TextBlock Text="Level 23" Style="{StaticResource MutedText}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="6,250 / 12,000 XP" Style="{StaticResource BodyText}" FontSize="13" HorizontalAlignment="Right"/>
                                    <Border Height="12" BorderBrush="{StaticResource Gold}" BorderThickness="1" Background="#040607" CornerRadius="6" Margin="0,6,0,0">
                                        <Border Width="142" Background="{StaticResource SkillGold}" CornerRadius="5" HorizontalAlignment="Left" Margin="1"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Knowledge -->
                            <Grid Height="74" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="112"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="52" Height="52" BorderBrush="{StaticResource Gold}" BorderThickness="1" Background="#0B1117" VerticalAlignment="Center">
                                    <TextBlock Text="📖" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Knowledge" Style="{StaticResource BodyText}" FontSize="19"/>
                                    <TextBlock Text="Level 18" Style="{StaticResource MutedText}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="4,380 / 8,500 XP" Style="{StaticResource BodyText}" FontSize="13" HorizontalAlignment="Right"/>
                                    <Border Height="12" BorderBrush="{StaticResource Gold}" BorderThickness="1" Background="#040607" CornerRadius="6" Margin="0,6,0,0">
                                        <Border Width="132" Background="{StaticResource KnowledgeBlue}" CornerRadius="5" HorizontalAlignment="Left" Margin="1"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Fame -->
                            <Grid Height="74" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="112"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="52" Height="52" BorderBrush="{StaticResource Gold}" BorderThickness="1" Background="#0B1117" VerticalAlignment="Center">
                                    <TextBlock Text="⚑" Foreground="{StaticResource FamePurple}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Fame" Style="{StaticResource BodyText}" FontSize="19"/>
                                    <TextBlock Text="Level 12" Style="{StaticResource MutedText}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="2,120 / 6,000 XP" Style="{StaticResource BodyText}" FontSize="13" HorizontalAlignment="Right"/>
                                    <Border Height="12" BorderBrush="{StaticResource Gold}" BorderThickness="1" Background="#040607" CornerRadius="6" Margin="0,6,0,0">
                                        <Border Width="86" Background="{StaticResource FamePurple}" CornerRadius="5" HorizontalAlignment="Left" Margin="1"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Rectangle Height="1" Fill="#8A6A32" Opacity="0.65" Margin="0,4,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="◇  Job Rank" Style="{StaticResource BodyText}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="4" Style="{StaticResource BodyText}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="1" Text="✦  Total Job XP" Style="{StaticResource BodyText}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="12,750 XP" Style="{StaticResource BodyText}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="2" Text="⇈  Next Rank" Style="{StaticResource BodyText}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Rank 5" Style="{StaticResource BodyText}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>

                        <Button Grid.Row="3" Style="{StaticResource PrimaryButton}" Content="View Job Details" HorizontalAlignment="Center" VerticalAlignment="Bottom" Width="270"/>
                    </Grid>
                </Border>

                <!-- Available Jobs -->
                <Border Grid.Column="2" Style="{StaticResource GoldPanel}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Rectangle Height="1" Fill="#8A6A32" Opacity="0.65" VerticalAlignment="Center"/>
                            <TextBlock Text="Available Jobs" Style="{StaticResource SectionTitle}" Background="#101820" Padding="22,0"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <StackPanel>
                                <!-- Job Row: Cook -->
                                <Grid Height="126" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="245"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.ColumnSpan="5" BorderBrush="#4B391D" BorderThickness="0,0,0,1"/>
                                    <Border Width="88" Height="88" BorderBrush="{StaticResource Gold}" BorderThickness="1" Background="{StaticResource SlotGradient}" CornerRadius="44" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="♨" Foreground="{StaticResource GoldSoft}" FontSize="43" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Cook" Foreground="{StaticResource GoldSoft}" FontFamily="Georgia" FontSize="25"/>
                                        <TextBlock Text="Prepare meals that restore health, grant powerful buffs and bring people together."
                                                   Style="{StaticResource BodyText}" LineHeight="22" Margin="0,8,18,0"/>
                                    </StackPanel>
                                    <Rectangle Grid.Column="2" Fill="#4B391D" Opacity="0.65" Margin="0,20"/>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="24,0,10,0">
                                        <Grid Height="28"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="⚒  Skill" Style="{StaticResource BodyText}"/><TextBlock Grid.Column="1" Text="Lv. 14" Style="{StaticResource BodyText}"/><Border Grid.Column="2" Height="10" BorderBrush="{StaticResource Gold}" BorderThickness="1" Background="#040607" CornerRadius="5" VerticalAlignment="Center"><Border Width="72" Background="{StaticResource SkillGold}" HorizontalAlignment="Left" Margin="1" CornerRadius="4"/></Border><TextBlock Grid.Column="3" Text="3,420 / 6,500 XP" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/></Grid>
                                        <Grid Height="28"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="📖  Knowledge" Style="{StaticResource BodyText}"/><TextBlock Grid.Column="1" Text="Lv. 11" Style="{StaticResource BodyText}"/><Border Grid.Column="2" Height="10" BorderBrush="{StaticResource Gold}" BorderThickness="1" Background="#040607" CornerRadius="5" VerticalAlignment="Center"><Border Width="62" Background="{StaticResource KnowledgeBlue}" HorizontalAlignment="Left" Margin="1" CornerRadius="4"/></Border><TextBlock Grid.Column="3" Text="1,850 / 4,200 XP" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/></Grid>
                                        <Grid Height="28"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="⚑  Fame" Style="{StaticResource BodyText}"/><TextBlock Grid.Column="1" Text="Lv. 8" Style="{StaticResource BodyText}"/><Border Grid.Column="2" Height="10" BorderBrush="{StaticResource Gold}" BorderThickness="1" Background="#040607" CornerRadius="5" VerticalAlignment="Center"><Border Width="42" Background="{StaticResource FamePurple}" HorizontalAlignment="Left" Margin="1" CornerRadius="4"/></Border><TextBlock Grid.Column="3" Text="1,220 / 3,000 XP" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/></Grid>
                                    </StackPanel>
                                    <Button Grid.Column="4" Style="{StaticResource PrimaryButton}" Content="View" Width="82" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Job Row: Alchemist -->
                                <Grid Height="126" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="245"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                    <Border Grid.ColumnSpan="5" BorderBrush="#4B391D" BorderThickness="0,0,0,1"/>
                                    <Border Width="88" Height="88" BorderBrush="{StaticResource Gold}" BorderThickness="1" Background="{StaticResource SlotGradient}" CornerRadius="44" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="☘" Foreground="#91CF5A" FontSize="43" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Alchemist" Foreground="{StaticResource GoldSoft}" FontFamily="Georgia" FontSize="25"/><TextBlock Text="Brew elixirs and potions that heal, enhance and alter the body and mind." Style="{StaticResource BodyText}" LineHeight="22" Margin="0,8,18,0"/></StackPanel>
                                    <Rectangle Grid.Column="2" Fill="#4B391D" Opacity="0.65" Margin="0,20"/>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="24,0,10,0">
                                        <Grid Height="28"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="⚒  Skill" Style="{StaticResource BodyText}"/><TextBlock Grid.Column="1" Text="Lv. 16" Style="{StaticResource BodyText}"/><Border Grid.Column="2" Height="10" BorderBrush="{StaticResource Gold}" BorderThickness="1" Background="#040607" CornerRadius="5" VerticalAlignment="Center"><Border Width="78" Background="{StaticResource SkillGold}" HorizontalAlignment="Left" Margin="1" CornerRadius="4"/></Border><TextBlock Grid.Column="3" Text="4,010 / 7,500 XP" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/></Grid>
                                        <Grid Height="28"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="📖  Knowledge" Style="{StaticResource BodyText}"/><TextBlock Grid.Column="1" Text="Lv. 13" Style="{StaticResource BodyText}"/><Border Grid.Column="2" Height="10" BorderBrush="{StaticResource Gold}" BorderThickness="1" Background="#040607" CornerRadius="5" VerticalAlignment="Center"><Border Width="76" Background="{StaticResource KnowledgeBlue}" HorizontalAlignment="Left" Margin="1" CornerRadius="4"/></Border><TextBlock Grid.Column="3" Text="2,600 / 5,000 XP" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/></Grid>
                                        <Grid Height="28"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="⚑  Fame" Style="{StaticResource BodyText}"/><TextBlock Grid.Column="1" Text="Lv. 9" Style="{StaticResource BodyText}"/><Border Grid.Column="2" Height="10" BorderBrush="{StaticResource Gold}" BorderThickness="1" Background="#040607" CornerRadius="5" VerticalAlignment="Center"><Border Width="45" Background="{StaticResource FamePurple}" HorizontalAlignment="Left" Margin="1" CornerRadius="4"/></Border><TextBlock Grid.Column="3" Text="1,540 / 3,500 XP" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/></Grid>
                                    </StackPanel>
                                    <Button Grid.Column="4" Style="{StaticResource PrimaryButton}" Content="View" Width="82" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Job Row: Lumberjack -->
                                <Grid Height="126" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="245"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                    <Border Grid.ColumnSpan="5" BorderBrush="#4B391D" BorderThickness="0,0,0,1"/>
                                    <Border Width="88" Height="88" BorderBrush="{StaticResource Gold}" BorderThickness="1" Background="{StaticResource SlotGradient}" CornerRadius="44" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="🪓" FontSize="39" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Lumberjack" Foreground="{StaticResource GoldSoft}" FontFamily="Georgia" FontSize="25"/><TextBlock Text="Harvest wood and manage forests to supply the realm with quality timber." Style="{StaticResource BodyText}" LineHeight="22" Margin="0,8,18,0"/></StackPanel>
                                    <Rectangle Grid.Column="2" Fill="#4B391D" Opacity="0.65" Margin="0,20"/>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="24,0,10,0">
                                        <Grid Height="28"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="⚒  Skill" Style="{StaticResource BodyText}"/><TextBlock Grid.Column="1" Text="Lv. 12" Style="{StaticResource BodyText}"/><Border Grid.Column="2" Height="10" BorderBrush="{StaticResource Gold}" BorderThickness="1" Background="#040607" CornerRadius="5" VerticalAlignment="Center"><Border Width="74" Background="{StaticResource SkillGold}" HorizontalAlignment="Left" Margin="1" CornerRadius="4"/></Border><TextBlock Grid.Column="3" Text="2,850 / 5,000 XP" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/></Grid>
                                        <Grid Height="28"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="📖  Knowledge" Style="{StaticResource BodyText}"/><TextBlock Grid.Column="1" Text="Lv. 10" Style="{StaticResource BodyText}"/><Border Grid.Column="2" Height="10" BorderBrush="{StaticResource Gold}" BorderThickness="1" Background="#040607" CornerRadius="5" VerticalAlignment="Center"><Border Width="58" Background="{StaticResource KnowledgeBlue}" HorizontalAlignment="Left" Margin="1" CornerRadius="4"/></Border><TextBlock Grid.Column="3" Text="1,600 / 3,800 XP" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/></Grid>
                                        <Grid Height="28"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="⚑  Fame" Style="{StaticResource BodyText}"/><TextBlock Grid.Column="1" Text="Lv. 7" Style="{StaticResource BodyText}"/><Border Grid.Column="2" Height="10" BorderBrush="{StaticResource Gold}" BorderThickness="1" Background="#040607" CornerRadius="5" VerticalAlignment="Center"><Border Width="36" Background="{StaticResource FamePurple}" HorizontalAlignment="Left" Margin="1" CornerRadius="4"/></Border><TextBlock Grid.Column="3" Text="900 / 2,500 XP" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/></Grid>
                                    </StackPanel>
                                    <Button Grid.Column="4" Style="{StaticResource PrimaryButton}" Content="View" Width="82" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Footer panels -->
            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource GoldPanel}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="Job Bonuses" Style="{StaticResource SectionTitle}"/>
                        <UniformGrid Grid.Row="1" Columns="4" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="♥" Foreground="{StaticResource GoldSoft}" FontSize="34" Margin="0,0,14,0"/><StackPanel><TextBlock Text="Max HP" Style="{StaticResource BodyText}"/><TextBlock Text="+8%" Foreground="{StaticResource Green}" FontFamily="Georgia" FontSize="16"/></StackPanel></StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="⚔" Foreground="{StaticResource GoldSoft}" FontSize="34" Margin="0,0,14,0"/><StackPanel><TextBlock Text="Attack" Style="{StaticResource BodyText}"/><TextBlock Text="+6%" Foreground="{StaticResource Green}" FontFamily="Georgia" FontSize="16"/></StackPanel></StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="◇" Foreground="{StaticResource GoldSoft}" FontSize="34" Margin="0,0,14,0"/><StackPanel><TextBlock Text="Defense" Style="{StaticResource BodyText}"/><TextBlock Text="+5%" Foreground="{StaticResource Green}" FontFamily="Georgia" FontSize="16"/></StackPanel></StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="♞" Foreground="{StaticResource GoldSoft}" FontSize="34" Margin="0,0,14,0"/><StackPanel><TextBlock Text="Gathering Speed" Style="{StaticResource BodyText}"/><TextBlock Text="+10%" Foreground="{StaticResource Green}" FontFamily="Georgia" FontSize="16"/></StackPanel></StackPanel>
                        </UniformGrid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource GoldPanel}" Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="✹" Foreground="{StaticResource GoldSoft}" FontSize="64" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Total Job Points" Style="{StaticResource SectionTitle}" HorizontalAlignment="Left" FontSize="18"/>
                            <TextBlock Text="2,450 JP" Foreground="{StaticResource GoldSoft}" FontFamily="Georgia" FontSize="36" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
